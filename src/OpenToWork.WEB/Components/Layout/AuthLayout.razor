@inherits LayoutComponentBase
@using OpenToWork.WEB.Services
@inject LanguageService Lang
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="auth-split">
    <div class="auth-split-brand">
        <div class="auth-brand-top">
            <div class="nav-brand">
                <a href="/">
                    <span class="nav-brand-logo">CONEX</span>
                    <span class="nav-brand-text">CONEX</span>
                </a>
            </div>
        </div>
        <div class="auth-brand-content">
            <h1 class="auth-brand-title">CONEX</h1>
            <p class="auth-brand-tagline">@Lang.T("auth.brand.tagline")</p>
            <p class="auth-brand-description">@Lang.T("auth.brand.description")</p>
        </div>
        <div class="auth-brand-footer">
            <select @onchange="OnThemeChanged" class="nav-select nav-select--light">
                <option value="navy">Navy</option>
                <option value="dark">Dark</option>
                <option value="light">Light</option>
            </select>
            <select @onchange="OnLanguageChanged" class="nav-select nav-select--light">
                <option value="es">ES</option>
                <option value="en">EN</option>
            </select>
        </div>
    </div>
    <div class="auth-split-form">
        @Body
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (e.Value is string theme)
        {
            await JS.InvokeVoidAsync("themeSwitcher.set", theme);
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string lang)
        {
            await Lang.SetLanguageAsync(lang);
        }
    }
}
