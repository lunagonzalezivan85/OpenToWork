@* Skeleton con la misma silueta que VacancyCard: logo, empresa+modo, titulo,
   descripcion, ubicacion+salario y pie. Se usa en Home y /vacancies mientras carga. *@
<div class="vacancy-skeleton-card" aria-hidden="true">
    <div class="vsk-top">
        <div class="vsk-logo"></div>
        <div class="vsk-company"></div>
        <div class="vsk-badge"></div>
    </div>
    <div class="vsk-title"></div>
    <div class="vsk-line"></div>
    <div class="vsk-line vsk-line--short"></div>
    <div class="vsk-meta">
        <div class="vsk-chip"></div>
        <div class="vsk-chip vsk-chip--salary"></div>
    </div>
    <div class="vsk-footer">
        <div class="vsk-views"></div>
        <div class="vsk-action"></div>
    </div>
</div>
