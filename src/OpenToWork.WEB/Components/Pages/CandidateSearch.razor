@page "/candidate-search"
@attribute [Authorize]
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang

@* Busqueda de candidatos (reapertura controlada, auditoria 8-Oct H-39): solo empresas
   verificadas por el equipo TD. Los resultados vienen anonimizados (nombre + inicial) y solo
   de candidatos que dieron su consentimiento de visibilidad. "Solicitar" pide al staff que
   prepare la entrega - hasta entonces el perfil completo no se puede abrir. *@

<PageTitle>@Lang.T("dashboard.candidateSearch.title")</PageTitle>

<div class="page-container">
    <div class="dash-banner-card">
        <div class="dash-banner-info">
            <h1 class="dash-banner-title">@Lang.T("dashboard.candidateSearch.title")</h1>
            <p class="dash-banner-role">@Lang.T("dashboard.candidateSearch.subtitle")</p>
        </div>
    </div>

    @if (NotVerified)
    {
        <div class="bento-card bento-card--full dash-empty">
            <p>@Lang.T("dashboard.candidateSearch.unavailable")</p>
        </div>
    }
    else
    {
        <div class="bento-grid">
            <div class="bento-card bento-card--full">
                <span class="bento-card-title">@Lang.T("dashboard.candidateSearch.filtersTitle")</span>
                <div class="wizard-form-grid" style="margin-top: var(--space-md);">
                    <div class="wizard-form-field">
                        <label class="wizard-field-label">@Lang.T("dashboard.candidateSearch.minStatus")</label>
                        <select class="wizard-input" @bind="MinStatus">
                            <option value="">@Lang.T("dashboard.candidateSearch.anyStatus")</option>
                            <option value="2">@Lang.T("dashboard.score.statusEvaluated")</option>
                            <option value="3">@Lang.T("dashboard.score.statusInProgress")</option>
                            <option value="4">@Lang.T("dashboard.score.statusVerifiedTD")</option>
                        </select>
                    </div>
                    <div class="wizard-form-field">
                        <label class="wizard-field-label">@Lang.T("dashboard.candidateSearch.skill")</label>
                        <select class="wizard-input" @bind="SkillId">
                            <option value="">@Lang.T("dashboard.candidateSearch.anySkill")</option>
                            @foreach (var s in Skills)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <button class="ot-btn ot-btn--primary" style="margin-top: var(--space-md);" @onclick="SearchAsync" disabled="@IsLoading">
                    @Lang.T("dashboard.candidateSearch.search")
                </button>
            </div>
        </div>

        @if (IsLoading)
        {
            <div class="wizard-loading"><div class="wizard-skeleton-main"></div></div>
        }
        else if (HasSearched && Results.Count == 0)
        {
            <div class="bento-card bento-card--full dash-empty">
                <p>@Lang.T("dashboard.candidateSearch.empty")</p>
            </div>
        }
        else if (Results.Count > 0)
        {
            <p class="dash-chart-info-text">@Total @Lang.T("dashboard.candidateSearch.resultsCount")</p>
            <div class="bento-grid">
                @foreach (var r in Results)
                {
                    <div class="bento-card bento-card--medium">
                        <div class="dash-score-header">
                            <div>
                                <span class="bento-card-title">@r.Name</span>
                                <p class="dash-chart-info-text" style="margin:2px 0 0;">@(r.Title ?? "-") @(string.IsNullOrEmpty(r.City) ? "" : $"· {r.City}, {r.Country}")</p>
                            </div>
                            @if (r.IsVerifiedTD)
                            {
                                <span class="dash-score-badge">★ TD</span>
                            }
                        </div>
                        <div class="dash-score-rings" style="margin-top: var(--space-md);">
                            <span class="dash-score-status">@VerificationStatusLabel(r.VerificationStatus)</span>
                        </div>
                        @if (RequestedIds.Contains(r.CandidateId))
                        {
                            <span class="dash-score-status" style="display:inline-block; margin-top: var(--space-sm);">@Lang.T("dashboard.candidateSearch.requested")</span>
                        }
                        else
                        {
                            <button class="ot-btn ot-btn--outline ot-btn--small" style="margin-top: var(--space-sm);"
                                    disabled="@RequestingId.HasValue" @onclick="() => RequestAsync(r.CandidateId)">
                                @Lang.T("dashboard.candidateSearch.request")
                            </button>
                        }
                    </div>
                }
            </div>

            @if (Total > PageSize)
            {
                <div style="display:flex; gap:8px; justify-content:center; margin-top: var(--space-lg);">
                    <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(Page <= 1)" @onclick="() => ChangePage(Page - 1)">←</button>
                    <span class="dash-chart-info-text" style="align-self:center;">@Page / @TotalPages</span>
                    <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(Page >= TotalPages)" @onclick="() => ChangePage(Page + 1)">→</button>
                </div>
            }
        }
    }
</div>

@code {
    private string MinStatus { get; set; } = "";
    private string SkillId { get; set; } = "";
    private List<SkillOptionDto> Skills { get; set; } = new();
    private List<CandidateSearchResultDto> Results { get; set; } = new();
    private HashSet<Guid> RequestedIds { get; set; } = new();
    private Guid? RequestingId { get; set; }
    private int Total { get; set; }
    private int Page { get; set; } = 1;
    private const int PageSize = 20;
    private bool IsLoading { get; set; }
    private bool HasSearched { get; set; }
    private bool NotVerified { get; set; }

    private int TotalPages => (int)Math.Ceiling(Total / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        // 403 = no es empresa verificada: se queda en el aviso, sin reintentos.
        var (skills, skillsForbidden) = await AuthApi.GetSearchableSkillsAsync();
        if (skillsForbidden) { NotVerified = true; return; }
        Skills = skills;
        RequestedIds = (await AuthApi.GetCompanyCandidateRequestsAsync()).ToHashSet();
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        Page = 1;
        await RunSearchAsync();
    }

    private async Task ChangePage(int page)
    {
        Page = page;
        await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        IsLoading = true;
        HasSearched = true;

        var filter = new CandidateSearchFilterDto
        {
            MinVerificationStatus = string.IsNullOrEmpty(MinStatus) ? null : int.Parse(MinStatus),
            SkillId = string.IsNullOrEmpty(SkillId) ? null : Guid.Parse(SkillId),
            Page = Page,
            PageSize = PageSize
        };

        var (result, forbidden) = await AuthApi.SearchCandidatesAsync(filter);
        if (forbidden) { NotVerified = true; IsLoading = false; return; }
        Results = result?.Items ?? new();
        Total = result?.Total ?? 0;
        IsLoading = false;
    }

    private async Task RequestAsync(Guid candidateId)
    {
        RequestingId = candidateId;
        if (await AuthApi.RequestCandidateAsync(candidateId, null, null))
            RequestedIds.Add(candidateId);
        RequestingId = null;
    }

    private string VerificationStatusLabel(int status) => status switch
    {
        4 => Lang.T("dashboard.score.statusVerifiedTD"),
        3 => Lang.T("dashboard.score.statusInProgress"),
        2 => Lang.T("dashboard.score.statusEvaluated"),
        _ => Lang.T("dashboard.score.statusUnverified")
    };
}
