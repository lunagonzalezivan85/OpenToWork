@page "/candidate-search"
@using OpenToWork.WEB.Services
@inject LanguageService Lang

@* Busqueda de candidatos CERRADA (auditoria 8-Oct, H-39): la API responde 403 a todos. Se rehara con
   verificacion de empresas, opt-in del candidato y datos minimos. La version anterior esta en el historial. *@

<PageTitle>@Lang.T("dashboard.candidateSearch.title")</PageTitle>

<div class="page-container">
    <div class="dash-banner-card">
        <div class="dash-banner-info">
            <h1 class="dash-banner-title">@Lang.T("dashboard.candidateSearch.title")</h1>
            <p class="dash-banner-role">@Lang.T("dashboard.candidateSearch.unavailable")</p>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }
}
