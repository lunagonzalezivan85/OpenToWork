@page "/my-vacancies"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@using Microsoft.AspNetCore.WebUtilities
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@Lang.T("vacancies.myTitle")</PageTitle>

<div class="page-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h1 style="margin: 0;">@Lang.T("vacancies.myTitle")</h1>
        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="() => ShowCreateForm = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="margin-right: 0.4rem;">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            @Lang.T("vacancies.create")
        </button>
    </div>

    @if (IsLoading)
    {
        <p>@Lang.T("common.labels.loading")</p>
    }
    else if (!VacancyList.Any())
    {
        <div class="ot-card text-center">
            <p class="auth-subtitle">@Lang.T("vacancies.noVacancies")</p>
        </div>
    }
    else
    {
        <div class="home-vacancies-grid">
            @foreach (var vacancy in VacancyList)
            {
                <VacancyCard Vacancy="vacancy" ShowStatus="true" ShowActions="true"
                    OnPublish="PublishVacancy" OnClose="CloseVacancy" OnDelete="DeleteVacancy" />
            }
        </div>
    }
</div>

<!-- FAB Button -->
<button class="fab-btn" @onclick="() => ShowCreateForm = true" aria-label="@Lang.T("vacancies.create")">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="24" height="24">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
    </svg>
</button>

<!-- Chat-style Modal -->
@if (ShowCreateForm)
{
    <div class="fab-overlay" @onclick="() => ShowCreateForm = false">
        <div class="fab-modal" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="fab-modal-header">
                <div class="fab-modal-header-info">
                    <div class="fab-modal-avatar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <path d="M3 9h18M9 21V9" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="fab-modal-title">@Lang.T("vacancies.createTitle")</h3>
                        <p class="fab-modal-subtitle">@Lang.T("vacancies.createSubtitle")</p>
                    </div>
                </div>
                <button class="fab-modal-close" @onclick="() => ShowCreateForm = false" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body - Chat style fields -->
            <div class="fab-modal-body">
                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.titlePrompt")</p>
                    </div>
                    <input class="ot-input-field fab-chat-input" placeholder="@Lang.T("vacancies.fields.title")" @bind="NewVacancy.Title" />
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.locationPrompt")</p>
                    </div>
                    <input class="ot-input-field fab-chat-input" placeholder="@Lang.T("vacancies.fields.location")" @bind="NewVacancy.Location" />
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.categoryPrompt")</p>
                    </div>
                    <select class="ot-input-field fab-chat-input" @bind="SelectedJobTypeIdText" @bind:after="OnJobTypeChanged">
                        <option value="">@Lang.T("vacancies.fields.jobTypePlaceholder")</option>
                        @foreach (var jobType in JobTypeOptions)
                        {
                            <option value="@jobType.Id">@jobType.Name</option>
                        }
                    </select>
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.contractPrompt")</p>
                    </div>
                    <select class="ot-input-field fab-chat-input" @bind="NewVacancy.ContractType">
                        <option value="0">@Lang.T("common.contract.fullTime")</option>
                        <option value="1">@Lang.T("common.contract.partTime")</option>
                        <option value="2">@Lang.T("common.contract.contract")</option>
                        <option value="3">@Lang.T("common.contract.remote")</option>
                    </select>
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.workModePrompt")</p>
                    </div>
                    <select class="ot-input-field fab-chat-input" @bind="NewVacancy.WorkMode">
                        <option value="0">@Lang.T("vacancies.workMode.onSite")</option>
                        <option value="1">@Lang.T("vacancies.workMode.hybrid")</option>
                        <option value="2">@Lang.T("vacancies.workMode.remote")</option>
                    </select>
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.salaryPrompt")</p>
                    </div>
                    <div class="fab-chat-row">
                        <input class="ot-input-field fab-chat-input" type="number" placeholder="@Lang.T("vacancies.fields.salaryMin")" @bind="NewVacancy.SalaryMin" />
                        <input class="ot-input-field fab-chat-input" type="number" placeholder="@Lang.T("vacancies.fields.salaryMax")" @bind="NewVacancy.SalaryMax" />
                    </div>
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.descriptionPrompt")</p>
                    </div>
                    <textarea class="ot-input-field fab-chat-input" rows="3" placeholder="@Lang.T("vacancies.fields.description")" @bind="NewVacancy.Description"></textarea>
                </div>

                <div class="fab-chat-step">
                    <div class="fab-chat-bubble fab-chat-bubble--bot">
                        <p>@Lang.T("vacancies.wizard.requirementsPrompt")</p>
                    </div>
                    <textarea class="ot-input-field fab-chat-input" rows="3" placeholder="@Lang.T("vacancies.fields.requirements")" @bind="NewVacancy.Requirements"></textarea>
                </div>

                @if (AvailableSkills.Count > 0)
                {
                    <div class="fab-chat-step">
                        <div class="fab-chat-bubble fab-chat-bubble--bot">
                            <p>@Lang.T("vacancies.wizard.skillsPrompt")</p>
                        </div>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                            @foreach (var skill in AvailableSkills)
                            {
                                var isSelected = SelectedSkillIds.Contains(skill.Id);
                                <button type="button"
                                    class="@("ot-chip" + (isSelected ? " ot-chip--active" : ""))"
                                    style="@(isSelected
                                        ? "background: var(--accent-primary, #6366f1); color: #fff; border: 1px solid var(--accent-primary, #6366f1);"
                                        : "background: transparent; border: 1px solid var(--border-color, #d1d5db);") padding: 0.35rem 0.75rem; border-radius: 999px; font-size: 0.85rem; cursor: pointer;"
                                    @onclick="() => ToggleSkill(skill.Id)">
                                    @skill.Name
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="fab-modal-footer">
                <button class="ot-btn ot-btn--secondary" @onclick="() => ShowCreateForm = false" disabled="@IsSaving">@Lang.T("common.buttons.cancel")</button>
                <button class="ot-btn ot-btn--primary" @onclick="CreateVacancy" disabled="@IsSaving">
                    @if (IsSaving)
                    {
                        <svg class="fab-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                        </svg>
                        @Lang.T("common.labels.saving")
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        @Lang.T("common.buttons.save")
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<VacancyDto> VacancyList { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool ShowCreateForm { get; set; }
    private bool IsSaving { get; set; }
    private CreateVacancyDto NewVacancy { get; set; } = new();

    private List<JobTypeOptionDto> JobTypeOptions { get; set; } = new();
    private List<AdminSkillDto> AvailableSkills { get; set; } = new();
    private string SelectedJobTypeIdText { get; set; } = "";
    private Guid? SelectedJobTypeId { get; set; }
    private HashSet<Guid> SelectedSkillIds { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("action", out var action) && action == "create")
            ShowCreateForm = true;

        var jobTypesTask = AuthApi.GetJobTypesAsync();
        var skillsTask = AuthApi.GetSkillsCatalogAsync();
        await Task.WhenAll(LoadVacancies(), jobTypesTask, skillsTask);

        JobTypeOptions = jobTypesTask.Result;
        AvailableSkills = skillsTask.Result;
    }

    private void OnJobTypeChanged()
    {
        SelectedJobTypeId = Guid.TryParse(SelectedJobTypeIdText, out var id) ? id : null;
        var jobType = JobTypeOptions.FirstOrDefault(t => t.Id == SelectedJobTypeId);
        SelectedSkillIds = jobType?.DefaultSkills.Select(s => s.Id).ToHashSet() ?? new HashSet<Guid>();
    }

    private void ToggleSkill(Guid skillId)
    {
        if (!SelectedSkillIds.Remove(skillId))
            SelectedSkillIds.Add(skillId);
    }

    private async Task LoadVacancies()
    {
        IsLoading = true;
        VacancyList = await AuthApi.GetMyCompanyVacanciesAsync();
        IsLoading = false;
    }

    private async Task CreateVacancy()
    {
        if (string.IsNullOrWhiteSpace(NewVacancy.Title))
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = Lang.T("common.labels.error"),
                text = Lang.T("vacancies.errors.titleRequired"),
                confirmButtonColor = "#6366f1",
                timer = 3000
            });
            return;
        }

        if (SelectedJobTypeId == null)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = Lang.T("common.labels.error"),
                text = Lang.T("vacancies.errors.jobTypeRequired"),
                confirmButtonColor = "#6366f1",
                timer = 3000
            });
            return;
        }

        IsSaving = true;
        NewVacancy.PT_JobTypeId = SelectedJobTypeId;
        NewVacancy.SkillIds = SelectedSkillIds.ToList();

        try
        {
            var result = await AuthApi.CreateVacancyAsync(NewVacancy);
            if (result != null)
            {
                NewVacancy = new CreateVacancyDto();
                SelectedJobTypeIdText = "";
                SelectedJobTypeId = null;
                SelectedSkillIds.Clear();
                ShowCreateForm = false;
                await LoadVacancies();
                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "success",
                    title = Lang.T("vacancies.success.created"),
                    showConfirmButton = false,
                    timer = 2000,
                    timerProgressBar = true
                });
            }
            else
            {
                await JS.InvokeVoidAsync("Swal.fire", new
                {
                    icon = "error",
                    title = Lang.T("common.labels.error"),
                    text = Lang.T("vacancies.errors.createFailed"),
                    confirmButtonColor = "#6366f1",
                    timer = 4000
                });
            }
        }
        catch (Exception)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = Lang.T("common.labels.error"),
                text = Lang.T("vacancies.errors.createFailed"),
                confirmButtonColor = "#6366f1",
                timer = 4000
            });
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task PublishVacancy(Guid id)
    {
        var result = await AuthApi.PublishVacancyAsync(id);
        await LoadVacancies();

        if (!result.Success)
        {
            await JS.InvokeVoidAsync("Swal.fire", new
            {
                icon = "error",
                title = Lang.T("vacancies.errors.publishBlocked"),
                text = result.Error ?? Lang.T("vacancies.errors.publishGeneric")
            });
        }
    }

    private async Task CloseVacancy(Guid id)
    {
        await AuthApi.CloseVacancyAsync(id);
        await LoadVacancies();
    }

    private async Task DeleteVacancy(Guid id)
    {
        await AuthApi.DeleteVacancyAsync(id);
        await LoadVacancies();
    }
}
