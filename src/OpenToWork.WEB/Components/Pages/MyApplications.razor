@page "/my-applications"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang

<PageTitle>@Lang.T("applications.myTitle")</PageTitle>

<div class="page-container">
    <h1 class="mb-lg">@Lang.T("applications.myTitle")</h1>

    @if (IsLoading)
    {
        <p>@Lang.T("common.labels.loading")</p>
    }
    else if (!Applications.Any())
    {
        <div class="ot-card text-center">
            <p class="auth-subtitle">@Lang.T("applications.noMyApplications")</p>
        </div>
    }
    else
    {
        <div class="home-vacancies-grid">
            @foreach (var app in Applications)
            {
                <VacancyCard Vacancy="MapToVacancyDto(app)" ShowStatus="true" StatusMode="application" />
            }
        </div>
    }
</div>

@code {
    private List<ApplicationDto> Applications { get; set; } = new();
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        IsLoading = true;
        Applications = await AuthApi.GetMyApplicationsAsync();
        IsLoading = false;
    }

    private VacancyDto MapToVacancyDto(ApplicationDto app)
    {
        return new VacancyDto
        {
            Id = app.VacancyId,
            Title = app.VacancyTitle,
            CompanyName = app.CompanyName ?? "",
            SalaryMin = app.ExpectedSalary,
            SalaryMax = null,
            Status = app.Status,
            ViewsCount = 0
        };
    }
}
