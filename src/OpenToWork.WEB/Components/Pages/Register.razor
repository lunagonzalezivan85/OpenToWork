@page "/register"
@layout OpenToWork.WEB.Components.Layout.AuthLayout
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@using OpenToWork.Shared.Validation
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject AppAuthStateProvider AuthProvider
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("auth.register.title")</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@Lang.T("auth.register.title")</h1>
        <p class="auth-subtitle">@Lang.T("auth.register.subtitle")</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-error">@ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(InfoMessage))
        {
            <div class="alert alert-success">@InfoMessage</div>
        }

        @if (AwaitingCode)
        {
            @* Paso 2 del candidato: la cuenta se crea solo con el codigo que llego al correo. *@
            <p class="auth-subtitle">@Lang.T("auth.verifyEmail.subtitle") <strong>@RegisterModel.Email</strong></p>

            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("auth.verifyEmail.codeLabel")</label>
                <input class="ot-input-field auth-code-input" @bind="EmailCode" @bind:event="oninput" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" placeholder="000000" />
            </div>

            <button class="ot-btn ot-btn--primary ot-btn--medium ot-btn--full-width" disabled="@(IsLoading || EmailCode.Trim().Length != 6)" @onclick="CreateAccount">
                @(IsLoading ? Lang.T("common.labels.loading") : Lang.T("auth.register.createAccount"))
            </button>

            <div class="auth-verify-actions">
                <button type="button" class="ot-btn ot-btn--ghost ot-btn--small" disabled="@IsLoading" @onclick="ResendCode">
                    @Lang.T("auth.verifyEmail.resend")
                </button>
                <button type="button" class="ot-btn ot-btn--ghost ot-btn--small" disabled="@IsLoading" @onclick="BackToForm">
                    @Lang.T("auth.register.editData")
                </button>
            </div>
        }
        else
        {
        <div class="ot-input-group mb-md">
            <label class="ot-input-label">@Lang.T("auth.register.selectRole")</label>
            <div class="segmented-control">
                <div class="segmented-indicator @(SelectedRole == 0 ? "segmented-indicator--left" : "segmented-indicator--right")"></div>
                <button type="button" class="segmented-option @(SelectedRole == 0 ? "active" : "")" @onclick="() => SelectRole(0)">
                    <span class="segmented-option-icon">🔍</span>
                    <span class="segmented-option-text">@Lang.T("common.roles.candidate")</span>
                </button>
                <button type="button" class="segmented-option @(SelectedRole == 1 ? "active" : "")" @onclick="() => SelectRole(1)">
                    <span class="segmented-option-icon">💼</span>
                    <span class="segmented-option-text">@Lang.T("common.roles.company")</span>
                </button>
            </div>
        </div>

        <EditForm Model="RegisterModel" OnValidSubmit="HandleRegister">

            @if (IsCandidate)
            {
                <div class="auth-field-row">
                    <div class="ot-input-group mb-md">
                        <label class="ot-input-label">@Lang.T("common.labels.firstName")</label>
                        <InputText class="ot-input-field" @bind-Value="RegisterModel.FirstName" autocomplete="given-name" maxlength="100" />
                    </div>
                    <div class="ot-input-group mb-md">
                        <label class="ot-input-label">@Lang.T("auth.register.lastNames")</label>
                        <InputText class="ot-input-field" @bind-Value="RegisterModel.LastName" autocomplete="family-name" maxlength="100" />
                    </div>
                </div>

                @EmailField
                @PasswordField

                <div class="auth-field-row auth-field-row--doc">
                    <div class="ot-input-group mb-md">
                        <label class="ot-input-label">@Lang.T("auth.register.documentType")</label>
                        <InputSelect class="ot-input-field" @bind-Value="RegisterModel.DocumentType">
                            <option value="">@Lang.T("auth.register.documentTypeSelect")</option>
                            <option value="@IdentityDocumentType.Dni">DNI</option>
                            <option value="@IdentityDocumentType.Nie">NIE</option>
                            <option value="@IdentityDocumentType.Passport">@Lang.T("auth.register.passport")</option>
                        </InputSelect>
                    </div>
                    <div class="ot-input-group mb-md">
                        <label class="ot-input-label">@Lang.T("auth.register.documentNumber")</label>
                        <InputText class="ot-input-field" @bind-Value="RegisterModel.Identification" @bind-Value:after="() => DocumentTouched = true"
                                   placeholder="@DocumentPlaceholder" disabled="@(RegisterModel.DocumentType == null)" maxlength="20" />
                        @if (ShowDocumentError)
                        {
                            <span class="ot-input-error">@DocumentHint</span>
                        }
                    </div>
                </div>

                @PhoneField
            }
            else
            {
                @* Empresa, en el orden pedido por Darwin: nombre, NIF, correo, contrasena y telefono. *@
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("auth.register.companyName")</label>
                    <InputText class="ot-input-field" @bind-Value="RegisterModel.CompanyName" autocomplete="organization" maxlength="200" />
                </div>

                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("auth.register.companyNif")</label>
                    <InputText class="ot-input-field" @bind-Value="RegisterModel.Identification" @bind-Value:after="() => DocumentTouched = true"
                               placeholder="B12345674" maxlength="20" />
                    @if (ShowCompanyNifError)
                    {
                        <span class="ot-input-error">@Lang.T("auth.register.invalidCompanyNif")</span>
                    }
                </div>

                @EmailField
                @PasswordField
                @PhoneField
            }

            @* Consentimientos (RGPD art. 6.1.a y 7): casillas sin marcar por defecto; la de privacidad es obligatoria,
               la comercial es opcional y no condiciona el registro. La API guarda fecha, IP y version del texto. *@
            <label class="auth-consent">
                <InputCheckbox @bind-Value="RegisterModel.AcceptPrivacy" />
                <span>
                    @Lang.T("auth.register.consentPrivacyPrefix")
                    <a href="/privacy" target="_blank" rel="noopener">@Lang.T("auth.register.legalPrivacy")</a>
                    <span class="auth-consent-required">*</span>
                </span>
            </label>
            <label class="auth-consent">
                <InputCheckbox @bind-Value="RegisterModel.AcceptMarketing" />
                <span>@Lang.T("auth.register.consentMarketing")</span>
            </label>

            <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium ot-btn--full-width mt-md" disabled="@IsLoading">
                @(IsLoading ? Lang.T("common.labels.loading") : Lang.T("common.buttons.register"))
            </button>

            @* Aviso informativo de terminos y cookies (la privacidad ya se acepta en su casilla) *@
            <p class="auth-legal">
                @Lang.T("auth.register.legalPrefix") <a href="/terms" target="_blank" rel="noopener">@Lang.T("auth.register.legalTerms")</a>
                @Lang.T("auth.register.legalAnd") <a href="/cookies" target="_blank" rel="noopener">@Lang.T("auth.register.legalCookies")</a>.
            </p>
        </EditForm>

        @* Google solo para candidatos, debajo como en el login: los datos que faltan se piden al volver, en /auth/google. *@
        @if (IsCandidate && GoogleEnabled)
        {
            <div style="text-align: center; margin: 1.5rem 0; color: var(--text-muted); font-size: 0.85rem;">
                @Lang.T("auth.login.orDivider")
            </div>
            <button type="button" class="ot-btn ot-btn--outline ot-btn--medium ot-btn--full-width" @onclick="GoToGoogle">
                <GoogleIcon />
                @Lang.T("auth.google.registerButton")
            </button>
        }
        }

        <p class="auth-link">
            @Lang.T("auth.register.haveAccount")
            <a href="@LoginLink">@Lang.T("auth.register.loginHere")</a>
        </p>
    </div>
</div>

@code {
    private const int MinPasswordLength = 6; // mismo minimo que AuthService.RegisterAsync

    // Campos comunes; candidato y empresa los muestran en distinto orden.
    private RenderFragment EmailField => @<div class="ot-input-group mb-md">
        <label class="ot-input-label">@Lang.T("common.labels.email")</label>
        <InputText class="ot-input-field" @bind-Value="RegisterModel.Email" placeholder="@Lang.T("auth.login.emailPlaceholder")" autocomplete="email" />
    </div>;

    private RenderFragment PasswordField => @<div class="ot-input-group mb-md">
        <label class="ot-input-label">@Lang.T("common.labels.password")</label>
        <InputText type="password" class="ot-input-field" @bind-Value="RegisterModel.Password" placeholder="@Lang.T("auth.login.passwordPlaceholder")" autocomplete="new-password" />
    </div>;

    private RenderFragment PhoneField => @<div class="ot-input-group mb-md">
        <label class="ot-input-label">@Lang.T("common.labels.phone")</label>
        <InputText class="ot-input-field" @bind-Value="RegisterModel.Phone" autocomplete="tel" />
    </div>;

    private RegisterFormData RegisterModel { get; set; } = new();
    private int SelectedRole { get; set; } = 0;
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string? ReturnUrl { get; set; }
    private bool DocumentTouched { get; set; }
    private string LoginLink => string.IsNullOrEmpty(ReturnUrl) ? "/login" : $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private bool IsCandidate => SelectedRole == 0;

    private bool IsDocumentValid => RegisterModel.DocumentType is { } type
        && IdentityDocumentValidator.IsValid(type, RegisterModel.Identification);

    // El aviso aparece al salir del campo con algo escrito, no mientras se empieza a teclear.
    private bool ShowDocumentError => DocumentTouched && !string.IsNullOrWhiteSpace(RegisterModel.Identification) && !IsDocumentValid;

    private bool IsCompanyNifValid => IdentityDocumentValidator.IsValidCompanyNif(RegisterModel.Identification);
    private bool ShowCompanyNifError => DocumentTouched && !string.IsNullOrWhiteSpace(RegisterModel.Identification) && !IsCompanyNifValid;

    private string DocumentPlaceholder => RegisterModel.DocumentType switch
    {
        IdentityDocumentType.Dni => "12345678Z",
        IdentityDocumentType.Nie => "X1234567L",
        IdentityDocumentType.Passport => "PAA123456",
        _ => ""
    };

    // Forma correcta pero letra de control equivocada: se dice eso, no se repite el formato.
    private string DocumentHint => RegisterModel.DocumentType switch
    {
        IdentityDocumentType.Dni or IdentityDocumentType.Nie when IdentityDocumentValidator.HasValidFormat(RegisterModel.DocumentType.Value, RegisterModel.Identification)
            => Lang.T("auth.register.wrongControlLetter"),
        IdentityDocumentType.Dni => Lang.T("auth.register.invalidDni"),
        IdentityDocumentType.Nie => Lang.T("auth.register.invalidNie"),
        _ => Lang.T("auth.register.invalidPassport")
    };

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var roleStr = query["role"];
        if (int.TryParse(roleStr, out var role) && role == 1)
            SelectedRole = 1;

        var returnUrl = query["returnUrl"];
        if (!string.IsNullOrEmpty(returnUrl) && returnUrl.StartsWith("/") && !returnUrl.StartsWith("//"))
            ReturnUrl = returnUrl;

        GoogleEnabled = await AuthApi.IsGoogleEnabledAsync();
    }

    private bool GoogleEnabled { get; set; }
    // forceLoad: en produccion /api va en el mismo dominio y el router de Blazor se lo quedaria.
    private void GoToGoogle() => Nav.NavigateTo(AuthApi.GoogleStartUrl(ReturnUrl), forceLoad: true);

    private void SelectRole(int role)
    {
        if (role == SelectedRole) return;
        SelectedRole = role;
        ErrorMessage = InfoMessage = null;
        // El numero de un DNI/NIE de candidato no sirve como NIF de empresa (ni al reves): se empieza vacio.
        RegisterModel.Identification = null;
        DocumentTouched = false;
    }

    /// <summary>Lo que la API tambien valida; aqui se avisa antes de enviar. Devuelve el primer error.</summary>
    private string? ValidateForm()
    {
        if (IsCandidate)
        {
            if (string.IsNullOrWhiteSpace(RegisterModel.FirstName) || string.IsNullOrWhiteSpace(RegisterModel.LastName))
                return Lang.T("auth.register.nameRequired");
            if (RegisterModel.DocumentType == null)
                return Lang.T("auth.register.documentTypeRequired");
            if (!IsDocumentValid)
                return DocumentHint;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(RegisterModel.CompanyName))
                return Lang.T("auth.register.companyNameRequired");
            if (string.IsNullOrWhiteSpace(RegisterModel.Identification))
                return Lang.T("auth.register.companyNifRequired");
            if (!IsCompanyNifValid)
                return Lang.T("auth.register.invalidCompanyNif");
        }
        if (string.IsNullOrWhiteSpace(RegisterModel.Email) || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(RegisterModel.Email))
            return Lang.T("auth.register.emailInvalid");
        if (RegisterModel.Password.Length < MinPasswordLength)
            return string.Format(Lang.T("validation.minLength"), MinPasswordLength);
        if (!IsCandidate && !PhoneValidator.IsValid(RegisterModel.Phone))
            return Lang.T("auth.register.invalidPhone");
        if (!RegisterModel.AcceptPrivacy)
            return Lang.T("auth.register.privacyRequired");
        return null;
    }

    private async Task HandleRegister()
    {
        InfoMessage = null;
        ErrorMessage = ValidateForm();
        if (ErrorMessage != null)
        {
            DocumentTouched = true;
            return;
        }

        // Ambos roles pasan por el codigo del correo (auditoria 08-Oct H-41/H-43: la empresa
        // operaba antes de verificar y el alta revelaba si un correo ya existe).
        await RequestCodeAsync(showSentNotice: false);
    }

    // --- La cuenta (candidato o empresa) no se crea hasta escribir el codigo del correo ---

    private bool AwaitingCode { get; set; }
    private string EmailCode { get; set; } = "";
    private string? InfoMessage { get; set; }

    private async Task RequestCodeAsync(bool showSentNotice)
    {
        IsLoading = true;
        ErrorMessage = InfoMessage = null;
        try
        {
            var result = await AuthApi.SendRegistrationCodeAsync(RegisterModel.Email.Trim(), RegisterModel.FirstName?.Trim());
            if (result.Success)
            {
                AwaitingCode = true;
                EmailCode = "";
                if (showSentNotice) InfoMessage = Lang.T("auth.verifyEmail.sent");
                return;
            }
            ErrorMessage = result.Error switch
            {
                "email_exists" => Lang.T("auth.register.emailExists"),
                "invalid_email" => Lang.T("auth.register.emailInvalid"),
                "too_soon" => Lang.T("auth.verifyEmail.errorTooSoon"),
                "send_failed" => Lang.T("auth.verifyEmail.errorSendFailed"),
                _ => Lang.T("auth.register.errorGeneric")
            };
            // Correo ya registrado o invalido: hay que corregirlo en el formulario.
            if (result.Error is "email_exists" or "invalid_email") AwaitingCode = false;
        }
        catch
        {
            ErrorMessage = Lang.T("auth.register.errorGeneric");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task ResendCode() => RequestCodeAsync(showSentNotice: true);

    private Task CreateAccount() => SubmitRegistrationAsync(EmailCode.Trim());

    private void BackToForm()
    {
        AwaitingCode = false;
        EmailCode = "";
        ErrorMessage = InfoMessage = null;
    }

    private async Task SubmitRegistrationAsync(string? emailCode)
    {
        IsLoading = true;
        ErrorMessage = InfoMessage = null;

        try
        {
            var dto = new RegisterDto
            {
                Email = RegisterModel.Email.Trim(),
                Password = RegisterModel.Password,
                PrimaryRole = SelectedRole,
                Identification = IdentityDocumentValidator.Normalize(RegisterModel.Identification),
                Phone = RegisterModel.Phone,
                FirstName = IsCandidate ? RegisterModel.FirstName?.Trim() : null,
                LastName = IsCandidate ? RegisterModel.LastName?.Trim() : null,
                DocumentType = IsCandidate ? (int?)RegisterModel.DocumentType : null,
                CompanyName = IsCandidate ? null : RegisterModel.CompanyName?.Trim(),
                AcceptPrivacy = RegisterModel.AcceptPrivacy,
                AcceptMarketing = RegisterModel.AcceptMarketing,
                EmailCode = emailCode
            };

            var result = await AuthApi.RegisterAsync(dto);

            if (result.Data != null)
            {
                AuthProvider.NotifyAuthenticationStateChanged();
                if (IsCandidate)
                {
                    // El correo ya quedo verificado con el codigo. En el panel sale la ventana de bienvenida
                    // (subir el CV o completar a mano) la primera vez.
                    Nav.NavigateTo(!result.Data.User.WizardCompleted ? "/dashboard"
                        : !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/dashboard");
                }
                else
                {
                    // El correo ya quedo verificado con el codigo del registro: directo al panel.
                    Nav.NavigateTo(!string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/company-dashboard");
                }
            }
            else if (result.EmailAlreadyRegistered)
            {
                AwaitingCode = false;
                ErrorMessage = Lang.T("auth.register.emailExists");
            }
            else
            {
                ErrorMessage = result.ValidationError ?? Lang.T("auth.register.errorGeneric");
            }
        }
        catch
        {
            ErrorMessage = Lang.T("auth.register.errorGeneric");
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Sin DataAnnotations: los avisos salen traducidos desde ValidateForm.
    public class RegisterFormData
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;

        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public IdentityDocumentType? DocumentType { get; set; }
        public string? CompanyName { get; set; }
        public string? Identification { get; set; }
        public string? Phone { get; set; }
        public bool AcceptPrivacy { get; set; }
        public bool AcceptMarketing { get; set; }
    }
}
