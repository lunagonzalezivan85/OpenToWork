@page "/forgot-password"
@layout OpenToWork.WEB.Components.Layout.AuthLayout
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("auth.forgotPassword")</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">@Lang.T("auth.forgotPassword")</h2>

        @if (IsSuccess)
        {
            <p class="auth-subtitle">@Lang.T("auth.forgotPasswordSent")</p>
            <button class="ot-btn ot-btn--primary ot-btn--medium w-full mt-lg" @onclick="BackToLogin">
                @Lang.T("common.buttons.backToLogin")
            </button>
        }
        else
        {
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error">@ErrorMessage</div>
            }

            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("common.labels.email")</label>
                <input class="ot-input-field" type="email" @bind="Email" />
            </div>

            <button class="ot-btn ot-btn--primary ot-btn--medium w-full" disabled="@IsLoading" @onclick="Submit">
                @(IsLoading ? Lang.T("common.labels.loading") : Lang.T("auth.sendResetLink"))
            </button>

            <div class="text-center mt-md">
                <a href="/login" class="auth-link">@Lang.T("common.buttons.backToLogin")</a>
            </div>
        }
    </div>
</div>

@code {
    private string Email { get; set; } = "";
    private bool IsLoading { get; set; }
    private bool IsSuccess { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task Submit()
    {
        if (string.IsNullOrEmpty(Email))
        {
            ErrorMessage = Lang.T("errors.emailRequired");
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        await AuthApi.ForgotPasswordAsync(Email);
        IsSuccess = true;
        IsLoading = false;
    }

    private void BackToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
