@page "/vacancies"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("vacancies.title")</PageTitle>

<div class="page-container">
    <div class="vacancies-page-header">
        <h1 class="vacancies-page-title">@Lang.T("vacancies.title")</h1>
        <span class="vacancies-page-count">@TotalResults @Lang.T("vacancies.results")</span>
    </div>

    <div class="cmd-search-wrapper">
        <div class="cmd-search-bar">
            <div class="cmd-search-prefix">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                </svg>
            </div>
            <input type="text" class="cmd-search-input" @ref="SearchInputRef" @bind="SearchKeyword" @bind:event="oninput"
                   placeholder="@Lang.T("common.home.searchPlaceholder")"
                   @onkeydown="HandleSearchKeyDown" />
            <div class="cmd-search-location">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
                <input type="text" class="cmd-search-location-input" @bind="SearchLocation" @bind:event="oninput"
                       placeholder="@Lang.T("common.home.locationPlaceholder")"
                       @onkeydown="HandleSearchKeyDown" />
            </div>
            <button class="cmd-search-btn" @onclick="HandleSearchClick">
                <span>@Lang.T("common.buttons.search")</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ActiveQuery) || !string.IsNullOrEmpty(ActiveLocation) || !string.IsNullOrEmpty(ActiveCategory))
    {
        <div class="vacancies-active-filters">
            @if (!string.IsNullOrEmpty(ActiveQuery))
            {
                <span class="vacancies-filter-tag">
                    @ActiveQuery
                    <button @onclick="ClearQuery" class="vacancies-filter-remove">×</button>
                </span>
            }
            @if (!string.IsNullOrEmpty(ActiveLocation))
            {
                <span class="vacancies-filter-tag">
                    📍 @ActiveLocation
                    <button @onclick="ClearLocation" class="vacancies-filter-remove">×</button>
                </span>
            }
            @if (!string.IsNullOrEmpty(ActiveCategory))
            {
                <span class="vacancies-filter-tag">
                    @GetCategoryLabel(ActiveCategory)
                    <button @onclick="ClearCategory" class="vacancies-filter-remove">×</button>
                </span>
            }
        </div>
    }

    @if (IsLoading)
    {
        <div class="home-vacancies-loading">
            <div class="home-skeleton-card"></div>
            <div class="home-skeleton-card"></div>
            <div class="home-skeleton-card"></div>
            <div class="home-skeleton-card"></div>
        </div>
    }
    else if (!VacancyList.Any())
    {
        <div class="home-vacancies-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
                <path d="M21 21l-4.35-4.35M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0z" />
            </svg>
            <p>@Lang.T("vacancies.noResults")</p>
        </div>
    }
    else
    {
        <div class="home-vacancies-grid">
            @foreach (var vacancy in VacancyList)
            {
                <VacancyCard Vacancy="vacancy" />
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="vacancies-pagination">
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <button class="vacancies-page-btn @(i == CurrentPage ? "vacancies-page-btn--active" : "")" @onclick="() => GoToPage(i)">
                        @i
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    private List<VacancyDto> VacancyList { get; set; } = new();
    private string ActiveQuery { get; set; } = "";
    private string ActiveLocation { get; set; } = "";
    private string ActiveCategory { get; set; } = "";
    private string SearchKeyword { get; set; } = "";
    private string SearchLocation { get; set; } = "";
    private int CurrentPage { get; set; } = 1;
    private int TotalResults { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalResults / 12);
    private bool IsLoading { get; set; }
    private ElementReference SearchInputRef;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("keyword", out var q))
            ActiveQuery = q.ToString();
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("location", out var loc))
            ActiveLocation = loc.ToString();
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("category", out var cat))
            ActiveCategory = cat.ToString();

        SearchKeyword = ActiveQuery;
        SearchLocation = ActiveLocation;

        await LoadVacancies();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SearchInputRef.FocusAsync();
        }
    }

    private void HandleSearchClick()
    {
        ActiveQuery = SearchKeyword;
        ActiveLocation = SearchLocation;
        CurrentPage = 1;
        UpdateUrl();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearchClick();
        }
    }

    private async Task LoadVacancies()
    {
        IsLoading = true;
        try
        {
            var dto = new SearchPermanentVacancyDto
            {
                Query = string.IsNullOrEmpty(ActiveQuery) ? null : ActiveQuery,
                Location = string.IsNullOrEmpty(ActiveLocation) ? null : ActiveLocation,
                Category = string.IsNullOrEmpty(ActiveCategory) ? null : ActiveCategory,
                Page = CurrentPage,
                PageSize = 12
            };
            var (items, total) = await AuthApi.SearchPermanentVacanciesAsync(dto);
            VacancyList = items;
            TotalResults = total;
        }
        catch
        {
            VacancyList = new();
        }
        IsLoading = false;
    }

    private async Task GoToPage(int page)
    {
        CurrentPage = page;
        await LoadVacancies();
    }

    private void GoToVacancy(Guid id)
    {
        Nav.NavigateTo($"/vacancy/{id}");
    }

    private void ClearQuery()
    {
        ActiveQuery = "";
        SearchKeyword = "";
        CurrentPage = 1;
        UpdateUrl();
    }

    private void ClearLocation()
    {
        ActiveLocation = "";
        SearchLocation = "";
        CurrentPage = 1;
        UpdateUrl();
    }

    private void ClearCategory()
    {
        ActiveCategory = "";
        CurrentPage = 1;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(ActiveQuery)) query.Add($"keyword={Uri.EscapeDataString(ActiveQuery)}");
        if (!string.IsNullOrEmpty(ActiveLocation)) query.Add($"location={Uri.EscapeDataString(ActiveLocation)}");
        if (!string.IsNullOrEmpty(ActiveCategory)) query.Add($"category={ActiveCategory}");
        var qs = query.Count > 0 ? "?" + string.Join("&", query) : "";
        Nav.NavigateTo($"/vacancies{qs}", forceLoad: true);
    }

    private string GetCategoryLabel(string category)
    {
        return category switch
        {
            "Camarero" => Lang.T("common.nav.categoryCamarero"),
            "AyudanteCamarero" => Lang.T("common.nav.categoryAyudanteCamarero"),
            "Cocinero" => Lang.T("common.nav.categoryCocinero"),
            "AyudanteCocina" => Lang.T("common.nav.categoryAyudanteCocina"),
            "JefeSala" => Lang.T("common.nav.categoryJefeSala"),
            "Barman" => Lang.T("common.nav.categoryBarman"),
            "AyudanteBarra" => Lang.T("common.nav.categoryAyudanteBarra"),
            "ResponsableLocal" => Lang.T("common.nav.categoryResponsableLocal"),
            "RecepcionistaHotel" => Lang.T("common.nav.categoryRecepcionistaHotel"),
            _ => category
        };
    }
}
