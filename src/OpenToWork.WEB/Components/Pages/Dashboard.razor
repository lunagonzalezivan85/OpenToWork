@page "/dashboard"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("dashboard.title")</PageTitle>

<div class="page-container">
    <!-- Bento Welcome Banner Card -->
    <div class="dash-banner-card">
        <div class="dash-banner-avatar dash-banner-avatar--link" @onclick="GoToProfile" title="@Lang.T("common.nav.profile")">@UserInitials</div>
        <div class="dash-banner-info">
            <h1 class="dash-banner-title dash-banner-title--link" @onclick="GoToProfile">@Lang.T("dashboard.welcome"), @UserName 👋</h1>
            <p class="dash-banner-role">@(CandidateProfile?.Title ?? Lang.T("dashboard.sections.profileProgress"))</p>
        </div>
        <div class="dash-banner-actions">
            <button class="ot-btn ot-btn--outline ot-btn--small dash-banner-btn" @onclick="GoToVerification">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="M9 12l2 2 4-4" />
                </svg>
                @Lang.T("dashboard.actions.requestVerification")
            </button>
            @if (CandidatePlanFeatureEnabled)
            {
                <button class="ot-btn ot-btn--primary ot-btn--small dash-banner-btn dash-banner-btn--premium" @onclick="GoToPlans">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                    @Lang.T("dashboard.actions.upgradePlan")
                </button>
            }
        </div>
    </div>

    @if (EmailNotVerified)
    {
        <div class="alert alert-warning dash-email-alert">
            <span>@Lang.T("auth.verifyEmail.bannerText")</span>
            <a href="/verify-email?next=/dashboard" class="ot-btn ot-btn--primary ot-btn--small">@Lang.T("auth.verifyEmail.bannerAction")</a>
        </div>
    }

    @if (ShowWizardPrompt)
    {
        <div class="wizard-prompt">
            <div class="wizard-prompt-text">
                <h3>@Lang.T("dashboard.wizardPrompt.title")</h3>
                <p>@Lang.T("dashboard.wizardPrompt.message")</p>
            </div>
            <button class="ot-btn ot-btn--primary" @onclick="OpenPending">
                @Lang.T("dashboard.wizardPrompt.button")
            </button>
        </div>
    }

    @if (ShowOnboarding && CandidateProfile != null)
    {
        <CandidateOnboardingModal Candidate="CandidateProfile" OnFinished="OnOnboardingFinished" />
    }

    @if (ShowCvUpdate && CandidateProfile != null)
    {
        @* "Subir / Actualizar mi CV": la IA lee el CV, el candidato revisa antes de guardar y completa lo que falte. *@
        <CandidateOnboardingModal Candidate="CandidateProfile" IsUpdate="true" OnFinished="OnCvUpdateFinished" OnCancel="CloseCvUpdate" />
    }

    @if (ShowPending && CandidateProfile != null)
    {
        @* "Completar perfil": solo los datos pendientes, no la carga desde cero *@
        <div class="cv-modal-overlay">
            <div class="cv-modal">
                <div class="cv-modal-header">
                    <h3 class="cv-modal-title">@Lang.T("dashboard.pending.title") (@ProfileCompletion%)</h3>
                    <button class="cv-modal-close" @onclick="ClosePending" aria-label="@Lang.T("common.buttons.close")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M18 6L6 18M6 6l12 12" /></svg>
                    </button>
                </div>
                <div class="cv-modal-body">
                    <PendingProfileForm Candidate="CandidateProfile" OnSaved="OnPendingSaved" OnCancel="ClosePending"
                                        SaveLabel="@Lang.T("dashboard.pending.save")" CancelLabel="@Lang.T("dashboard.pending.later")" />
                </div>
            </div>
        </div>
    }

    <!-- Row 1: Profile Completion Chart (2 cols) + Indicators Card (2 cols) -->
    <div class="bento-grid">
        <!-- Profile Completion Circular Chart -->
        <div class="bento-card bento-card--medium dash-chart-card">
            <div class="dash-chart-header">
                <span class="bento-card-title">@Lang.T("dashboard.stats.profileCompletion")</span>
            </div>
            <div class="dash-chart-body">
                <div class="dash-chart-ring" style="--progress: @(ProfileCompletion); --deg: @(ProfileCompletion * 3.6)deg">
                    <div class="dash-chart-ring-inner">
                        <span class="dash-chart-percent">@ProfileCompletion%</span>
                    </div>
                </div>
                <div class="dash-chart-info">
                    <p class="dash-chart-info-text">
                        @(ProfileCompletion < 100 ? Lang.T("dashboard.wizardPrompt.message") : Lang.T("dashboard.pending.completeText"))
                    </p>
                    @if (ProfileCompletion < 100)
                    {
                        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="OpenPending">
                            @Lang.T("dashboard.actions.completeProfile")
                        </button>
                    }
                    else
                    {
                        <span class="dash-profile-complete-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M20 6L9 17l-5-5" /></svg>
                            @Lang.T("dashboard.pending.completeBadge")
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Indicators Card: 3 stats -->
        <div class="bento-card bento-card--medium dash-indicators-card">
            <div class="dash-indicators-header">
                <span class="bento-card-title">@Lang.T("dashboard.sections.myApplications")</span>
            </div>
            <div class="dash-indicators-grid">
                <div class="dash-indicator">
                    <div class="dash-indicator-icon dash-indicator-icon--blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M9 11l3 3L22 4" />
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                        </svg>
                    </div>
                    <div class="dash-indicator-data">
                        <span class="dash-indicator-value">@RequestsCount</span>
                        <span class="dash-indicator-label">@Lang.T("dashboard.stats.requests")</span>
                    </div>
                </div>
                <div class="dash-indicator">
                    <div class="dash-indicator-icon dash-indicator-icon--green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                        </svg>
                    </div>
                    <div class="dash-indicator-data">
                        <span class="dash-indicator-value">@PostulationsCount</span>
                        <span class="dash-indicator-label">@Lang.T("dashboard.stats.postulations")</span>
                    </div>
                </div>
                <div class="dash-indicator">
                    <div class="dash-indicator-icon dash-indicator-icon--purple">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                            <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                        </svg>
                    </div>
                    <div class="dash-indicator-data">
                        <span class="dash-indicator-value">@PublicationsCount</span>
                        <span class="dash-indicator-label">@Lang.T("dashboard.stats.publications")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Process != null)
    {
        <!-- Row: Mi proceso (resumen, enlaza a /my-process) -->
        <div class="bento-grid">
            <a href="/my-process" class="bento-card bento-card--full dash-process-card">
                <div class="dash-process-info">
                    <span class="bento-card-title">@Lang.T("common.nav.myProcess")</span>
                    <strong>@ProcessStageLabel</strong>
                    <span class="dash-process-desc">@Lang.T("applications.process.dashboardCardDesc")</span>
                </div>
                <div class="dash-process-stat">
                    <span class="dash-indicator-value">@Process.Deliveries.Count</span>
                    <span class="dash-indicator-label">@Lang.T("applications.process.deliveriesTitle")</span>
                </div>
                <span class="ot-btn ot-btn--outline ot-btn--small">@Lang.T("applications.process.dashboardCardLink")</span>
            </a>
        </div>
    }

    @if (CandidateProfile != null)
    {
        <!-- Row: Tu Evaluacion (Fase 3, sub-fase 3.8) -->
        <div class="bento-grid">
            <div class="bento-card bento-card--full dash-score-card">
                <div class="dash-score-header">
                    <span class="bento-card-title">@Lang.T("dashboard.score.title")</span>
                    <div style="display:flex; gap: var(--space-sm); align-items:center;">
                        @if (VerificationStatus?.IsVerifiedTD == true)
                        {
                            <span class="dash-score-badge">★ @Lang.T("dashboard.score.verifiedBadge")</span>
                        }
                        else if (VerificationStatus != null)
                        {
                            <span class="dash-score-status">@StatusLabel(VerificationStatus.Status)</span>
                        }
                        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="RecalculateScoreAsync" disabled="@IsScoreLoading">
                            @Lang.T("dashboard.score.recalculate")
                        </button>
                    </div>
                </div>
                <div class="dash-score-rings">
                    <div class="dash-score-ring--overall" style="--deg: @((Score?.OverallScore ?? 0) * 3.6)deg">
                        <div class="dash-score-ring--overall-inner">
                            <span class="dash-chart-percent">@(Score?.OverallScore ?? 0)</span>
                            <span class="dash-score-mini-label">@Lang.T("dashboard.score.overallScore")</span>
                        </div>
                    </div>
                    <div class="dash-score-mini-grid">
                        <div class="dash-score-mini">
                            <div class="dash-score-mini-ring" style="--mini-color: #3b82f6; --deg: @((Score?.StabilityIndex ?? 0) * 3.6)deg">
                                <div class="dash-score-mini-ring-inner">@(Score?.StabilityIndex ?? 0)</div>
                            </div>
                            <span class="dash-score-mini-label">@Lang.T("dashboard.score.stability")</span>
                        </div>
                        <div class="dash-score-mini">
                            <div class="dash-score-mini-ring" style="--mini-color: #10b981; --deg: @((Score?.ReliabilityIndex ?? 0) * 3.6)deg">
                                <div class="dash-score-mini-ring-inner">@(Score?.ReliabilityIndex ?? 0)</div>
                            </div>
                            <span class="dash-score-mini-label">@Lang.T("dashboard.score.reliability")</span>
                        </div>
                        <div class="dash-score-mini">
                            <div class="dash-score-mini-ring" style="--mini-color: #8b5cf6; --deg: @((Score?.EvidenceIndex ?? 0) * 3.6)deg">
                                <div class="dash-score-mini-ring-inner">@(Score?.EvidenceIndex ?? 0)</div>
                            </div>
                            <span class="dash-score-mini-label">@Lang.T("dashboard.score.evidence")</span>
                        </div>
                        <div class="dash-score-mini">
                            <div class="dash-score-mini-ring" style="--mini-color: #f59e0b; --deg: @((Score?.CompatibilityIndex ?? 0) * 3.6)deg">
                                <div class="dash-score-mini-ring-inner">@(Score?.CompatibilityIndex ?? 0)</div>
                            </div>
                            <span class="dash-score-mini-label">@Lang.T("dashboard.score.compatibility")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bento-card bento-card--full">
                <div class="dash-indicators-header" style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="bento-card-title">@Lang.T("dashboard.score.verificationsTitle")</span>
                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="RunVerificationsAsync" disabled="@IsScoreLoading">
                        @Lang.T("dashboard.score.runVerifications")
                    </button>
                </div>
                @if (Verifications.Count == 0)
                {
                    <p class="dash-chart-info-text">@Lang.T("dashboard.score.noVerificationsYet")</p>
                }
                else
                {
                    <div class="dash-verifications-list">
                        @foreach (var v in Verifications)
                        {
                            <div class="dash-verification-row">
                                <span class="dash-verification-name">@VerificationTypeLabel(v.Type)</span>
                                <span class="dash-verification-pill @VerificationPillClass(v.Status)">@VerificationStatusLabel(v.Status)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Row: Quick actions extra (Referencias / Retos) -->
        <div class="bento-grid">
            <div class="bento-card dash-action-card" @onclick="GoToReferences" style="cursor: pointer;">
                <div class="dash-action-icon dash-action-icon--blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M12.5 3.5a2.5 2.5 0 1 1 0 5M20 21v-2a4 4 0 0 0-3-3.87" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                </div>
                <div class="dash-action-content">
                    <span class="dash-action-title">@Lang.T("dashboard.score.referencesQuickAction")</span>
                    <span class="dash-action-desc">@Lang.T("dashboard.score.referencesQuickActionDesc")</span>
                </div>
            </div>

            <div class="bento-card dash-action-card" @onclick="GoToSkillTests" style="cursor: pointer;">
                <div class="dash-action-icon dash-action-icon--purple">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                        <path d="M9 12l2 2 4-4M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
                    </svg>
                </div>
                <div class="dash-action-content">
                    <span class="dash-action-title">@Lang.T("dashboard.score.skillTestsQuickAction")</span>
                    <span class="dash-action-desc">@Lang.T("dashboard.score.skillTestsQuickActionDesc")</span>
                </div>
            </div>
        </div>
    }

    <!-- Row 2: Quick Actions -->
    <h2 class="dash-section-title">@Lang.T("dashboard.sections.quickActions")</h2>
    @* "Completar perfil" no va aqui: ya esta junto al % del perfil, arriba. *@
    <div class="bento-grid dash-actions-grid">
        <div class="bento-card dash-action-card" @onclick="GoToUploadCv" style="cursor: pointer;">
            <div class="dash-action-icon dash-action-icon--green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />
                </svg>
            </div>
            <div class="dash-action-content">
                <span class="dash-action-title">@Lang.T(HasCv ? "dashboard.actions.updateCv" : "dashboard.actions.uploadCv")</span>
                <span class="dash-action-desc">@Lang.T(HasCv ? "dashboard.actions.updateCvDesc" : "dashboard.actions.uploadCvDesc")</span>
            </div>
        </div>

        <div class="bento-card dash-action-card" @onclick="GoToRecordVideo" style="cursor: pointer;">
            <div class="dash-action-icon dash-action-icon--purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <path d="M23 7l-7 5 7 5V7zM14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z" />
                </svg>
            </div>
            <div class="dash-action-content">
                <span class="dash-action-title">@Lang.T(CandidateProfile?.HasPresentationVideo == true ? "dashboard.actions.viewVideo" : "dashboard.actions.recordVideo")</span>
                <span class="dash-action-desc">@Lang.T(CandidateProfile?.HasPresentationVideo == true ? "dashboard.actions.viewVideoDesc" : "dashboard.actions.recordVideoDesc")</span>
            </div>
        </div>

        <div class="bento-card dash-action-card" @onclick="GoToVacancies" style="cursor: pointer;">
            <div class="dash-action-icon dash-action-icon--orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                </svg>
            </div>
            <div class="dash-action-content">
                <span class="dash-action-title">@Lang.T("dashboard.actions.findJob")</span>
                <span class="dash-action-desc">@Lang.T("dashboard.actions.findJobDesc")</span>
            </div>
        </div>
    </div>

    <!-- Row 3: Recommended Vacancies -->
    <h2 class="dash-section-title">@Lang.T("dashboard.sections.recommended")</h2>
    <div class="home-vacancies-grid">
        @if (RecommendedVacancies.Any())
        {
            @foreach (var vacancy in RecommendedVacancies.Take(4))
            {
                <VacancyCard Vacancy="MapToVacancyDto(vacancy)" />
            }
        }
        else
        {
            <div class="bento-card bento-card--full dash-empty">
                <p>@Lang.T("dashboard.sections.recommended")</p>
            </div>
        }
    </div>
</div>

@code {
    private CandidateDto? CandidateProfile { get; set; }
    private CandidateProcessDto? Process { get; set; }

    // Etapa actual para la tarjeta "Mi proceso": 5 (descartado) se muestra como proceso finalizado.
    private string ProcessStageLabel => Process switch
    {
        null => "",
        { HasRecruitment: false } => Lang.T("applications.process.stage0"),
        { CurrentStage: 5 } => Lang.T("applications.process.closed"),
        _ => Lang.T($"applications.process.stage{Process.CurrentStage}")
    };
    private List<TempVacancyDto> RecommendedVacancies { get; set; } = new();
    private bool ShowWizardPrompt { get; set; }
    private bool EmailNotVerified { get; set; }
    private bool CandidatePlanFeatureEnabled { get; set; }
    private int ProfileCompletion { get; set; }
    private int VacanciesCount { get; set; }
    private int RequestsCount { get; set; }
    private int PostulationsCount { get; set; }
    private int PublicationsCount { get; set; }
    private string UserName { get; set; } = "";
    private string UserInitials { get; set; } = "U";

    // Fase 3, sub-fase 3.8.
    private CandidateScoreDto? Score { get; set; }
    private VerificationStatusDto? VerificationStatus { get; set; }
    private List<VerificationResultDto> Verifications { get; set; } = new();
    private bool IsScoreLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        // Este es el panel del candidato: una empresa que llegue aqui (enlace viejo, pie de pagina,
        // registro) va a su propio panel en vez de ver "Completa tu perfil" de candidato.
        if (await AuthApi.GetUserRoleAsync() == "1")
        {
            Nav.NavigateTo("/company-dashboard", replace: true);
            return;
        }

        string? jwtName = null;
        var token = await AuthApi.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var payload = token.Split('.')[1];
                var jsonBytes = Convert.FromBase64String(payload + (payload.Length % 4 == 2 ? "==" : payload.Length % 4 == 3 ? "=" : ""));
                var claims = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);
                jwtName = claims?.TryGetValue("given_name", out var gn) == true ? gn.ToString() : null;
            }
            catch { }
        }

        CandidateProfile = await AuthApi.GetCandidateProfileAsync();
        Process = await AuthApi.GetMyProcessAsync();
        EmailNotVerified = (await AuthApi.GetEmailVerificationStatusAsync())?.EmailVerified == false;

        if (CandidateProfile != null)
        {
            ApplyCandidate(CandidateProfile);
            UserName = !string.IsNullOrEmpty(CandidateProfile.FirstName) ? CandidateProfile.FirstName : (jwtName ?? "Usuario");
            // Primer ingreso: la ventana de bienvenida (subir CV o completar a mano) sale una sola vez,
            // y no si ya hay CV (p. ej. alta hecha por un reclutador desde el admin con su CV).
            ShowOnboarding = !CandidateProfile.WizardCompleted && CandidateProfile.WizardStep == 0
                             && string.IsNullOrEmpty(CandidateProfile.CvUrl);
        }
        else
        {
            ShowWizardPrompt = true;
            ProfileCompletion = 0;
            UserName = jwtName ?? "Usuario";
            UserInitials = NameInitials.From(UserName, null);
        }

        var (vacancies, total) = await AuthApi.SearchVacanciesAsync(new SearchVacancyDto { Page = 1, PageSize = 4 });
        RecommendedVacancies = vacancies;
        VacanciesCount = total;

        if (CandidateProfile != null)
        {
            await LoadScoreDataAsync();
        }

        CandidatePlanFeatureEnabled = await AuthApi.GetCandidatePlanFeatureEnabledAsync();
    }

    private async Task LoadScoreDataAsync()
    {
        if (CandidateProfile == null) return;
        Score = await AuthApi.GetScoreAsync(CandidateProfile.Id);
        VerificationStatus = await AuthApi.GetVerificationStatusAsync(CandidateProfile.Id);
        Verifications = await AuthApi.GetVerificationsAsync(CandidateProfile.Id);
    }

    private async Task RecalculateScoreAsync()
    {
        if (CandidateProfile == null || IsScoreLoading) return;
        IsScoreLoading = true;
        await AuthApi.RecalculateScoreAsync(CandidateProfile.Id);
        await LoadScoreDataAsync();
        IsScoreLoading = false;
    }

    private async Task RunVerificationsAsync()
    {
        if (CandidateProfile == null || IsScoreLoading) return;
        IsScoreLoading = true;
        await AuthApi.RunVerificationsAsync(CandidateProfile.Id);
        await AuthApi.RecalculateScoreAsync(CandidateProfile.Id);
        await LoadScoreDataAsync();
        IsScoreLoading = false;
    }

    private void GoToReferences() => Nav.NavigateTo("/references");
    private void GoToSkillTests() => Nav.NavigateTo("/skill-tests");

    private string StatusLabel(int status) => status switch
    {
        0 => Lang.T("dashboard.score.statusProfileRegistered"),
        1 => Lang.T("dashboard.score.statusProfileComplete"),
        2 => Lang.T("dashboard.score.statusEvaluated"),
        3 => Lang.T("dashboard.score.statusInProgress"),
        4 => Lang.T("dashboard.score.statusVerifiedTD"),
        _ => "-"
    };

    private string VerificationTypeLabel(int type) => type switch
    {
        0 => Lang.T("dashboard.score.verificationIdentity"),
        1 => Lang.T("dashboard.score.verificationLinkedIn"),
        2 => Lang.T("dashboard.score.verificationPortfolio"),
        3 => Lang.T("dashboard.score.verificationCvCoherence"),
        4 => Lang.T("dashboard.score.verificationEducation"),
        5 => Lang.T("dashboard.score.verificationReference"),
        _ => "-"
    };

    private string VerificationStatusLabel(int status) => status switch
    {
        0 => Lang.T("dashboard.score.vStatusPending"),
        1 => Lang.T("dashboard.score.vStatusInProgress"),
        2 => Lang.T("dashboard.score.vStatusVerified"),
        3 => Lang.T("dashboard.score.vStatusFailed"),
        _ => "-"
    };

    private static string VerificationPillClass(int status) => status switch
    {
        0 => "dash-verification-pill--pending",
        1 => "dash-verification-pill--progress",
        2 => "dash-verification-pill--verified",
        3 => "dash-verification-pill--failed",
        _ => "dash-verification-pill--pending"
    };

    // --- Primer ingreso y "Completar perfil" ---

    private bool ShowOnboarding { get; set; }
    private bool ShowPending { get; set; }

    private void ApplyCandidate(CandidateDto c)
    {
        CandidateProfile = c;
        ShowWizardPrompt = !c.WizardCompleted;
        ProfileCompletion = OpenToWork.Shared.Helpers.ProfileCompletion.Percent(c);
        UserInitials = NameInitials.From(c.FirstName, c.LastName);
    }

    private async Task OnOnboardingFinished(CandidateDto updated)
    {
        ShowOnboarding = false;
        updated.WizardCompleted = true;
        ApplyCandidate(updated);
        await LoadScoreDataAsync();
    }

    // --- "Subir / Actualizar mi CV" ---

    private bool ShowCvUpdate { get; set; }
    private bool HasCv => !string.IsNullOrEmpty(CandidateProfile?.CvUrl);

    private void CloseCvUpdate() => ShowCvUpdate = false;

    private async Task OnCvUpdateFinished(CandidateDto updated)
    {
        ShowCvUpdate = false;
        updated.WizardCompleted = true;
        ApplyCandidate(updated);
        await LoadScoreDataAsync();
    }

    private void OpenPending() => ShowPending = true;
    private void ClosePending() => ShowPending = false;

    private void OnPendingSaved(CandidateDto? updated)
    {
        if (updated != null) ApplyCandidate(updated);
        ShowPending = false;
    }

    private void GoToProfile() => Nav.NavigateTo("/profile");
    private void GoToPlans() => Nav.NavigateTo("/plans");
    private void GoToVerification() => Nav.NavigateTo("/verification-request");
    private void GoToVacancies() => Nav.NavigateTo("/vacancies");
    private void GoToCreateVacancy() => Nav.NavigateTo("/my-vacancies?action=create");
    private void GoToUploadCv()
    {
        if (CandidateProfile == null) Nav.NavigateTo("/profile?step=0");
        else ShowCvUpdate = true;
    }
    private void GoToRecordVideo() => Nav.NavigateTo("/presentation-video");

    private static VacancyDto MapToVacancyDto(TempVacancyDto v)
    {
        return new VacancyDto
        {
            Id = v.Id,
            Title = v.Title,
            Description = v.Description,
            Location = v.Location,
            SalaryMin = v.SalaryMin,
            SalaryMax = v.SalaryMax,
            ContractType = v.ContractType,
            CompanyName = "Trato Directo",
            ViewsCount = 0
        };
    }

}
