@page "/reset-password"
@layout OpenToWork.WEB.Components.Layout.AuthLayout
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

@* Elegir contraseña con el enlace recibido: recuperacion de contraseña o, con invite=1, activacion
   de la cuenta de una empresa invitada desde el admin (CompanyPortalAccessService). *@
<PageTitle>@Title</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h2 class="auth-title">@Title</h2>

        @if (IsSuccess)
        {
            <p class="auth-subtitle">@Lang.T("auth.resetDone")</p>
            <button class="ot-btn ot-btn--primary ot-btn--medium w-full mt-lg" @onclick="BackToLogin">
                @Lang.T("common.buttons.backToLogin")
            </button>
        }
        else if (string.IsNullOrEmpty(Token))
        {
            <div class="alert alert-error">@Lang.T("auth.resetInvalidLink")</div>
            <div class="text-center mt-md">
                <a href="/login" class="auth-link">@Lang.T("common.buttons.backToLogin")</a>
            </div>
        }
        else
        {
            @if (IsInvite)
            {
                <p class="auth-subtitle">@Lang.T("auth.inviteSubtitle")</p>
            }
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error">@ErrorMessage</div>
            }

            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("auth.newPassword")</label>
                <input class="ot-input-field" type="password" @bind="NewPassword" autocomplete="new-password" />
            </div>
            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("auth.confirmNewPassword")</label>
                <input class="ot-input-field" type="password" @bind="ConfirmPassword" autocomplete="new-password" />
            </div>

            <button class="ot-btn ot-btn--primary ot-btn--medium w-full" disabled="@IsLoading" @onclick="Submit">
                @(IsLoading ? Lang.T("common.labels.loading") : Lang.T("auth.savePassword"))
            </button>

            <div class="text-center mt-md">
                <a href="/login" class="auth-link">@Lang.T("common.buttons.backToLogin")</a>
            </div>
        }
    </div>
</div>

@code {
    private const int MinPasswordLength = 6; // mismo minimo que el registro (RegisterDto)

    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "invite")] public int? Invite { get; set; }

    private bool IsInvite => Invite == 1;
    private string Title => IsInvite ? Lang.T("auth.inviteTitle") : Lang.T("auth.resetTitle");

    private string NewPassword { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private bool IsLoading { get; set; }
    private bool IsSuccess { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task Submit()
    {
        ErrorMessage = null;
        if (NewPassword.Length < MinPasswordLength)
        {
            ErrorMessage = string.Format(Lang.T("validation.minLength"), MinPasswordLength);
            return;
        }
        if (NewPassword != ConfirmPassword)
        {
            ErrorMessage = Lang.T("validation.passwordMismatch");
            return;
        }

        IsLoading = true;
        IsSuccess = await AuthApi.ResetPasswordAsync(Token!, NewPassword);
        if (!IsSuccess)
            ErrorMessage = Lang.T("auth.resetInvalidLink");
        IsLoading = false;
    }

    private void BackToLogin() => Nav.NavigateTo("/login");
}
