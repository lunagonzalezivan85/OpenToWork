@page "/plans"
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@using OpenToWork.WEB.Services
@inject LanguageService Lang
@inject NavigationManager Nav
@inject ApiAuthService Api
@inject LocalStorageService LocalStorage

<PageTitle>Planes</PageTitle>

<div class="plans-page">
    <div class="plans-container">
        <div class="plans-header">
            <h1 class="plans-title">Mejora tu plan</h1>
            <p class="plans-subtitle">@(IsCompany ? "Elige el plan que mejor se adapte a las necesidades de tu empresa" : "Elige el plan que mejor se adapte a tu búsqueda")</p>
        </div>

        @if (!IsCompany && !CandidateFeatureEnabled)
        {
            <div class="admin-empty">
                <div class="admin-empty-text">Todavía no hay planes disponibles para candidatos.</div>
            </div>
        }
        else if (IsCompany && !CompanyFeatureEnabled)
        {
            <div class="admin-empty">
                <div class="admin-empty-text">Todavía no hay planes disponibles para empresas.</div>
            </div>
        }
        else if (PlanList == null)
        {
            <div class="admin-loading">Cargando planes...</div>
        }
        else if (PlanList.Count == 0)
        {
            <div class="admin-empty">
                <div class="admin-empty-text">No hay planes disponibles por el momento.</div>
            </div>
        }
        else
        {
            <div class="plans-grid">
                @foreach (var plan in PlanList)
                {
                    <div class="plan-card @(plan.IsFeatured ? "plan-card--featured" : "")">
                        @if (plan.IsFeatured)
                        {
                            <span class="plan-badge">Recomendado</span>
                        }
                        <div class="plan-card-header">
                            <h2 class="plan-name">@plan.Name</h2>
                            <div class="plan-price">
                                <span class="plan-price-amount">@FormatPrice(plan.Price, plan.Currency)</span>
                                <span class="plan-price-period">/mes</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <p class="plan-desc">@plan.Description</p>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(plan.Features))
                        {
                            <ul class="plan-features">
                                @foreach (var feature in SplitFeatures(plan.Features))
                                {
                                    <li><svg class="plan-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="15" height="15"><path d="M20 6L9 17l-5-5" /></svg> @feature</li>
                                }
                            </ul>
                        }
                        <button class="ot-btn @(plan.IsFeatured ? "ot-btn--primary" : "ot-btn--outline") ot-btn--full-width" @onclick="ContactSales">Elegir @plan.Name</button>
                    </div>
                }
            </div>
        }

        <p class="plans-note">¿Necesitas algo a medida? <a href="/about">Contáctanos</a></p>
    </div>
</div>

@code {
    private List<PlanDto>? PlanList;
    private bool IsCompany;
    private bool CandidateFeatureEnabled = true;
    private bool CompanyFeatureEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var roleStr = await LocalStorage.GetItemAsync("opentowork-role");
        IsCompany = roleStr == "1";

        if (IsCompany)
            CompanyFeatureEnabled = await Api.GetCompanyPlanFeatureEnabledAsync();
        else
            CandidateFeatureEnabled = await Api.GetCandidatePlanFeatureEnabledAsync();

        var enabled = IsCompany ? CompanyFeatureEnabled : CandidateFeatureEnabled;
        if (enabled)
            PlanList = await Api.GetPlansAsync(IsCompany ? PlanAudience.Company : PlanAudience.Candidate);
    }

    private static string[] SplitFeatures(string features) =>
        features.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string FormatPrice(decimal price, string currency)
    {
        var symbol = currency == "USD" ? "$" : currency == "EUR" ? "€" : currency + " ";
        return price == 0 ? $"{symbol}0" : $"{symbol}{price:0.##}";
    }

    private void ContactSales()
    {
        // Placeholder: flujo de upgrade pendiente de integración de pagos.
        Nav.NavigateTo("/about");
    }
}
