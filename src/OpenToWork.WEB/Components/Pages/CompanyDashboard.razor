@page "/company-dashboard"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>Dashboard Empresa</PageTitle>

<div class="page-container">
    <!-- Welcome Banner -->
    <div class="dash-banner-card">
        <div class="dash-banner-avatar">@UserInitials</div>
        <div class="dash-banner-info">
            <h1 class="dash-banner-title">Hola, @UserName</h1>
            <p class="dash-banner-role">Portal de Empresa</p>
        </div>
        <button class="ot-btn ot-btn--outline ot-btn--small dash-banner-btn" @onclick="GoToCreateVacancy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Publicar vacante
        </button>
    </div>

    <!-- Command IA Bar -->
    <div class="cmd-bar-card">
        <div class="cmd-bar-input-wrapper">
            <svg class="cmd-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <input type="text" class="cmd-bar-input" placeholder="Preguntale a la IA o escribe un comando..." @bind="CommandQuery" @onkeydown="HandleCommandKey" @onfocus="() => ShowCommandSuggestions = true" @onblur="() => ShowCommandSuggestions = false" />
            <kbd class="cmd-bar-kbd">Ctrl K</kbd>
        </div>
        @if (ShowCommandSuggestions)
        {
            <div class="cmd-bar-suggestions">
                <button class="cmd-bar-suggestion" @onclick="CmdCrearVacante">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    <span>Crear nueva vacante</span>
                </button>
                <button class="cmd-bar-suggestion" @onclick="CmdVerPostulantes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                    <span>Ver postulantes verificados</span>
                </button>
                <button class="cmd-bar-suggestion" @onclick="CmdMisSolicitudes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6" />
                    </svg>
                    <span>Mis solicitudes</span>
                </button>
                <button class="cmd-bar-suggestion" @onclick="CmdMensajes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <span>Abrir mensajes</span>
                </button>
            </div>
        }
    </div>

    <!-- Badge Stats Row -->
    <div class="cmd-badge-row">
        <div class="cmd-badge cmd-badge--blue" @onclick="GoToMyVacancies" style="cursor: pointer;">
            <span class="cmd-badge-label">Vacantes</span>
            <span class="cmd-badge-count">@Vacancies.Count</span>
        </div>
        <div class="cmd-badge cmd-badge--green" @onclick="GoToVerifiedApplicants" style="cursor: pointer;">
            <span class="cmd-badge-label">Postulantes</span>
            <span class="cmd-badge-count">@TotalApplicants</span>
        </div>
        <div class="cmd-badge cmd-badge--amber" @onclick="GoToMyVacancies" style="cursor: pointer;">
            <span class="cmd-badge-label">Borradores</span>
            <span class="cmd-badge-count">@DraftVacancies</span>
        </div>
    </div>

    <!-- Hero + Applicants List (70/30) -->
    <div class="hero-applicants-grid">
        <!-- Hero Ad Slider (70%) -->
        <div class="hero-slider">
            <div class="hero-slider-track" style="transform: translateX(-@(CurrentSlide * 100)%)">
                @foreach (var slide in Slides)
                {
                    <div class="hero-slide hero-slide--@slide.Theme">
                        <div class="hero-slide-content">
                            <span class="hero-slide-badge">@slide.Badge</span>
                            <h2 class="hero-slide-title">@slide.Title</h2>
                            <p class="hero-slide-desc">@slide.Description</p>
                            <button class="hero-slide-btn" @onclick="GoToCreateVacancy">@slide.ButtonText</button>
                        </div>
                        <div class="hero-slide-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="64" height="64">
                                <path d="@slide.IconPath" />
                            </svg>
                        </div>
                    </div>
                }
            </div>
            <button class="hero-slider-arrow hero-slider-arrow--prev" @onclick="PrevSlide">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </button>
            <button class="hero-slider-arrow hero-slider-arrow--next" @onclick="NextSlide">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </button>
            <div class="hero-slider-dots">
                @for (int i = 0; i < Slides.Count; i++)
                {
                    <button class="hero-slider-dot @(i == CurrentSlide ? "active" : "")" @onclick="() => GoToSlide(i)"></button>
                }
            </div>
        </div>

        <!-- Applicants List (30%) -->
        <div class="applicant-list-card">
            <div class="applicant-list-header">
                <h3 class="applicant-list-title">Postulantes recientes</h3>
                <span class="applicant-list-count">@RecentApplicants.Count</span>
            </div>
            @if (RecentApplicants.Any())
            {
                <div class="applicant-list-body">
                    @foreach (var app in RecentApplicants.Take(6))
                    {
                        <div class="applicant-item" style="cursor: pointer;" @onclick="() => GoToApplicantProfile(app.CandidateId)">
                            <div class="applicant-item-main">
                                <div class="applicant-item-name">@app.CandidateName</div>
                                <div class="applicant-item-meta">
                                    <span class="applicant-item-vacancy">@app.VacancyTitle</span>
                                </div>
                            </div>
                            <div class="applicant-item-progress">
                                <div class="applicant-progress-ring" style="--pct: @app.ProfileCompletionPercentage">
                                    <span>@app.ProfileCompletionPercentage%</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="applicant-list-empty">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                    <p>Sin postulantes aun</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<VacancyDto> Vacancies { get; set; } = new();
    private Dictionary<Guid, int> VacancyApplicantCounts { get; set; } = new();
    private string UserName { get; set; } = "";
    private string UserInitials { get; set; } = "E";
    private string CommandQuery { get; set; } = "";
    private bool ShowCommandSuggestions { get; set; }
    private int CurrentSlide { get; set; }
    private List<HeroSlide> Slides { get; set; } = new();
    private List<ApplicationDto> RecentApplicants { get; set; } = new();

    private int DraftVacancies => Vacancies.Count(v => v.Status == 0);
    private int TotalApplicants => VacancyApplicantCounts.Values.Sum();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        Slides = new()
        {
            new HeroSlide
            {
                Theme = "blue",
                Badge = "NUEVO",
                Title = "Publica tu primera vacante gratis",
                Description = "Alcanza a miles de candidatos verificados. Sin costos ocultos, sin comisiones.",
                ButtonText = "Publicar ahora",
                IconPath = "M12 5v14M5 12h14"
            },
            new HeroSlide
            {
                Theme = "green",
                Badge = "IA",
                Title = "Encuentra el candidato perfecto con IA",
                Description = "Nuestro motor de IA analiza perfiles y te recomienda los mejores postulantes automaticamente.",
                ButtonText = "Probar ahora",
                IconPath = "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
            },
            new HeroSlide
            {
                Theme = "purple",
                Badge = "PRO",
                Title = "Destaca tu empresa con perfil premium",
                Description = "Logo personalizado, estadisticas avanzadas y prioridad en busquedas. Prueba 30 dias gratis.",
                ButtonText = "Saber mas",
                IconPath = "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            }
        };

        var token = await AuthApi.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var payload = token.Split('.')[1];
                var jsonBytes = Convert.FromBase64String(payload + (payload.Length % 4 == 2 ? "==" : payload.Length % 4 == 3 ? "=" : ""));
                var claims = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(jsonBytes);

                if (claims != null)
                {
                    var givenName = claims.TryGetValue("given_name", out var gn) ? gn.ToString() : null;
                    var email = claims.TryGetValue("email", out var e) ? e.ToString() : "";
                    UserName = !string.IsNullOrEmpty(givenName) ? givenName : (email?.Split('@')[0] ?? "Empresa");
                    UserInitials = GetInitials(UserName);
                }
            }
            catch { }
        }

        try
        {
            Vacancies = await AuthApi.GetMyCompanyVacanciesAsync();

            var allApps = new List<ApplicationDto>();
            foreach (var v in Vacancies)
            {
                try
                {
                    var apps = await AuthApi.GetVacancyApplicationsAsync(v.Id);
                    VacancyApplicantCounts[v.Id] = apps.Count;
                    allApps.AddRange(apps);
                }
                catch
                {
                    VacancyApplicantCounts[v.Id] = 0;
                }
            }
            RecentApplicants = allApps.OrderByDescending(a => a.CreatedAt).ToList();
        }
        catch
        {
            Vacancies = new();
        }
    }

    private void HandleCommandKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(CommandQuery))
        {
            var q = CommandQuery.Trim().ToLower();
            if (q.Contains("crear") || q.Contains("vacante") || q.Contains("publicar"))
                RunCommand("crear-vacante");
            else if (q.Contains("postulante"))
                RunCommand("ver-postulantes");
            else if (q.Contains("solicitud") || q.Contains("mis"))
                RunCommand("mis-solicitudes");
            else if (q.Contains("mensaje"))
                RunCommand("mensajes");
            else
                ShowCommandSuggestions = true;
        }
        else if (e.Key == "Escape")
        {
            ShowCommandSuggestions = false;
            CommandQuery = "";
        }
    }

    private void RunCommand(string command)
    {
        ShowCommandSuggestions = false;
        CommandQuery = "";
        switch (command)
        {
            case "crear-vacante":
                Nav.NavigateTo("/my-vacancies?action=create");
                break;
            case "ver-postulantes":
                Nav.NavigateTo("/verified-applicants");
                break;
            case "mis-solicitudes":
                Nav.NavigateTo("/my-vacancies");
                break;
            case "mensajes":
                Nav.NavigateTo("/messages");
                break;
        }
    }

    private void CmdCrearVacante() => RunCommand("crear-vacante");
    private void CmdVerPostulantes() => RunCommand("ver-postulantes");
    private void CmdMisSolicitudes() => RunCommand("mis-solicitudes");
    private void CmdMensajes() => RunCommand("mensajes");

    private static string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "E";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "E";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[1][..1]).ToUpper();
    }

    private static string GetStatusClass(int status) => status switch
    {
        0 => "draft",
        1 => "active",
        2 => "closed",
        _ => "draft"
    };

    private static string GetStatusLabel(int status) => status switch
    {
        0 => "Borrador",
        1 => "Activa",
        2 => "Cerrada",
        _ => "Borrador"
    };

    private void GoToCreateVacancy() => Nav.NavigateTo("/my-vacancies?action=create");
    private void GoToMyVacancies() => Nav.NavigateTo("/my-vacancies");
    private void GoToVerifiedApplicants() => Nav.NavigateTo("/verified-applicants");
    private void GoToApplicantProfile(Guid candidateId) => Nav.NavigateTo($"/applicant-profile/{candidateId}");

    private void NextSlide()
    {
        CurrentSlide = (CurrentSlide + 1) % Slides.Count;
    }

    private void PrevSlide()
    {
        CurrentSlide = (CurrentSlide - 1 + Slides.Count) % Slides.Count;
    }

    private void GoToSlide(int index)
    {
        CurrentSlide = index;
    }

    private class HeroSlide
    {
        public string Theme { get; set; } = "";
        public string Badge { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ButtonText { get; set; } = "";
        public string IconPath { get; set; } = "";
    }
}
