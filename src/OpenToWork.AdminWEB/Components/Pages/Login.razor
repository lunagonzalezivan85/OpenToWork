@page "/login"
@layout OpenToWork.AdminWEB.Components.Layout.LoginLayout
@using OpenToWork.Shared.DTOs
@using OpenToWork.AdminWEB.Services
@inject AdminAuthApiService AuthApi
@inject AdminAuthStateProvider AuthProvider
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.login.title")</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">@Lang.T("admin.login.title")</h1>
        <p class="auth-subtitle">@Lang.T("admin.login.subtitle")</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-error">@ErrorMessage</div>
        }

        <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("admin.common.email")</label>
                <InputText class="ot-input-field" @bind-Value="LoginModel.Email" placeholder="@Lang.T("admin.login.emailPlaceholder")" />
                <ValidationMessage For="@(() => LoginModel.Email)" class="ot-input-error" />
            </div>

            <div class="ot-input-group mb-md">
                <label class="ot-input-label">@Lang.T("admin.common.password")</label>
                <InputText type="password" class="ot-input-field" @bind-Value="LoginModel.Password" placeholder="@Lang.T("admin.login.passwordPlaceholder")" />
                <ValidationMessage For="@(() => LoginModel.Password)" class="ot-input-error" />
            </div>

            <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium ot-btn--full-width" disabled="@IsLoading">
                @(IsLoading ? Lang.T("admin.login.loading") : Lang.T("admin.login.button"))
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginFormData LoginModel { get; set; } = new();
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var dto = new LoginDto
            {
                Email = LoginModel.Email,
                Password = LoginModel.Password
            };

            var result = await AuthApi.LoginAsync(dto);

            if (result.Data != null)
            {
                AuthProvider.NotifyAuthenticationStateChanged();
                Nav.NavigateTo("/", forceLoad: true);
            }
            else if (result.PasswordExpired)
            {
                ErrorMessage = Lang.T("admin.login.errorPasswordExpired");
            }
            else
            {
                ErrorMessage = Lang.T("admin.login.errorInvalid");
            }
        }
        catch
        {
            ErrorMessage = Lang.T("admin.login.errorGeneric");
        }
        finally
        {
            IsLoading = false;
        }
    }

    public class LoginFormData
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
