@page "/vacancies"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@Lang.T("admin.vacancies.title")</PageTitle>

<div class="admin-page-header">
    <h1>@Lang.T("admin.vacancies.title")</h1>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ExportCsv">@Lang.T("admin.vacancies.exportCsv")</button>
    </div>
</div>

@if (VacanciesList == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (VacanciesList.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-icon">&#9632;</div>
        <div class="admin-empty-text">@Lang.T("admin.vacancies.empty")</div>
    </div>
}
else
{
    <table class="ot-table">
        <thead>
            <tr>
                <th>@Lang.T("admin.vacancies.columnTitle")</th>
                <th>@Lang.T("admin.vacancies.columnCompany")</th>
                <th>@Lang.T("admin.vacancies.columnType")</th>
                <th>@Lang.T("admin.vacancies.columnStatus")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in VacanciesList)
            {
                <tr>
                    <td>@v.Title</td>
                    <td>@(v.CompanyName ?? "-")</td>
                    <td>@(v.IsTemporary ? Lang.T("admin.vacancies.temporary") : Lang.T("admin.vacancies.permanent"))</td>
                    <td>
                        @if ((VacancyStatus)v.Status == VacancyStatus.Active)
                        {
                            <span class="admin-status admin-status--active">@StatusLabel(v.Status)</span>
                        }
                        else if ((VacancyStatus)v.Status == VacancyStatus.Draft)
                        {
                            <span class="admin-status admin-status--draft">@StatusLabel(v.Status)</span>
                        }
                        else
                        {
                            <span class="admin-status admin-status--closed">@StatusLabel(v.Status)</span>
                        }
                    </td>
                    <td>
                        <div class="admin-table-actions">
                            @if (v.Status != (int)VacancyStatus.Active)
                            {
                                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => Moderate(v.Id, (int)VacancyStatus.Active)">@Lang.T("admin.vacancies.approve")</button>
                            }
                            @if (v.Status != (int)VacancyStatus.Closed)
                            {
                                <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => Moderate(v.Id, (int)VacancyStatus.Closed)">@Lang.T("admin.vacancies.close")</button>
                            }
                            @if ((VacancyStatus)v.Status == VacancyStatus.Active)
                            {
                                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ToggleShortlist(v.Id)">@Lang.T("admin.shortlist.title")</button>
                            }
                        </div>
                    </td>
                </tr>
                @if (ShortlistVacancyId == v.Id)
                {
                    <tr>
                        <td colspan="5">
                            <div class="admin-profile-section" style="margin: 0;">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <h3 class="admin-profile-section-title">@Lang.T("admin.shortlist.title") - @v.Title</h3>
                                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="() => CalculateShortlistAsync(v.Id)" disabled="@IsShortlistBusy">
                                        @Lang.T("admin.shortlist.calculate")
                                    </button>
                                </div>
                                @if (LastEvaluatedCount.HasValue)
                                {
                                    <p class="admin-profile-info-value">@LastEvaluatedCount @Lang.T("admin.shortlist.candidatesEvaluated")</p>
                                }
                                @if (Shortlist.Count == 0)
                                {
                                    <p class="admin-profile-info-value">@Lang.T("admin.shortlist.empty")</p>
                                }
                                else
                                {
                                    <table class="ot-table">
                                        <thead>
                                            <tr>
                                                <th>@Lang.T("admin.shortlist.candidate")</th>
                                                <th>@Lang.T("admin.shortlist.matchPercentage")</th>
                                                <th>@Lang.T("admin.shortlist.skills")</th>
                                                <th>@Lang.T("admin.shortlist.experience")</th>
                                                <th>@Lang.T("admin.shortlist.location")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var m in Shortlist)
                                            {
                                                <tr>
                                                    <td>@m.CandidateName</td>
                                                    <td><strong>@m.MatchPercentage%</strong></td>
                                                    <td>@m.SkillsMatch%</td>
                                                    <td>@m.ExperienceMatch%</td>
                                                    <td>@m.LocationMatch%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private List<AdminVacancyDto>? VacanciesList;

    // Fase 3, sub-fase 3.8: cola de shortlist (vista simple, sin workflow de aprobacion - ver fase-3-sub8.md pregunta 3).
    private Guid? ShortlistVacancyId { get; set; }
    private List<JobMatchDto> Shortlist { get; set; } = new();
    private int? LastEvaluatedCount { get; set; }
    private bool IsShortlistBusy { get; set; }

    private async Task ToggleShortlist(Guid vacancyId)
    {
        if (ShortlistVacancyId == vacancyId)
        {
            ShortlistVacancyId = null;
            return;
        }
        ShortlistVacancyId = vacancyId;
        LastEvaluatedCount = null;
        Shortlist = await AuthApi.GetVacancyShortlistAsync(vacancyId);
    }

    private async Task CalculateShortlistAsync(Guid vacancyId)
    {
        if (IsShortlistBusy) return;
        IsShortlistBusy = true;
        LastEvaluatedCount = await AuthApi.CalculateVacancyMatchesAsync(vacancyId);
        Shortlist = await AuthApi.GetVacancyShortlistAsync(vacancyId);
        IsShortlistBusy = false;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        await LoadVacancies();
    }

    private async Task LoadVacancies()
    {
        VacanciesList = await AuthApi.GetVacanciesAsync();
    }

    private async Task Moderate(Guid id, int status)
    {
        await AuthApi.ModerateVacancyAsync(id, status);
        await LoadVacancies();
    }

    private string StatusLabel(int status) => (VacancyStatus)status switch
    {
        VacancyStatus.Draft => Lang.T("admin.vacancies.statusDraft"),
        VacancyStatus.Active => Lang.T("admin.vacancies.statusActive"),
        VacancyStatus.Closed => Lang.T("admin.vacancies.statusClosed"),
        _ => status.ToString()
    };

    private async Task ExportCsv()
    {
        var bytes = await AuthApi.ExportVacanciesCsvAsync();
        if (bytes == null) return;

        await JS.InvokeVoidAsync("fileDownload.save", $"vacancies-{DateTime.Now:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }
}
