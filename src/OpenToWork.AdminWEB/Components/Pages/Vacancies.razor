@page "/vacancies"
@page "/companies/{CompanyId:guid}/vacancies"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@Lang.T("admin.vacancies.title")</PageTitle>

<div class="admin-page-header">
    <h1>@Lang.T("admin.vacancies.title")</h1>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="OpenWizard">+ @Lang.T("admin.vacancies.create")</button>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ExportCsv">@Lang.T("admin.vacancies.exportCsv")</button>
    </div>
</div>

@if (CompanyId.HasValue && !string.IsNullOrEmpty(CompanyFilterName))
{
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; padding: 0.6rem 1rem; background: #E8F1FF; border-radius: 10px;">
        <span style="font-size: 0.85rem; color: #0052CC; font-weight: 600;">@Lang.T("admin.companies.title"): @CompanyFilterName</span>
        <button class="ot-btn ot-btn--outline ot-btn--small" style="margin-left: auto;" @onclick="@(() => Nav.NavigateTo($"/companies/{CompanyId}"))">@Lang.T("admin.common.back")</button>
    </div>
}

@if (VacanciesList == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (VacanciesList.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-icon">&#9632;</div>
        <div class="admin-empty-text">@Lang.T("admin.vacancies.empty")</div>
    </div>
}
else
{
    <div class="admin-oneui-list">
        @foreach (var v in VacanciesList)
        {
            <div class="admin-oneui-item admin-oneui-item--clickable" @onclick="() => OpenDetail(v.Id)">
                <div class="admin-oneui-avatar @((VacancyStatus)v.Status == VacancyStatus.Active ? "admin-oneui-avatar--success" : (VacancyStatus)v.Status == VacancyStatus.Closed ? "admin-oneui-avatar--muted" : "")">
                    @GetVacancyInitial(v.Title)
                </div>
                <div class="admin-oneui-body">
                    <div class="admin-oneui-title">
                        @v.Title
                        @if ((VacancyStatus)v.Status == VacancyStatus.Active)
                        {
                            <span class="admin-status admin-status--active">@StatusLabel(v.Status)</span>
                        }
                        else if ((VacancyStatus)v.Status == VacancyStatus.Draft)
                        {
                            <span class="admin-status admin-status--draft">@StatusLabel(v.Status)</span>
                        }
                        else
                        {
                            <span class="admin-status admin-status--closed">@StatusLabel(v.Status)</span>
                        }
                    </div>
                    <div class="admin-oneui-subtitle">
                        @if (!string.IsNullOrEmpty(v.CompanyName))
                        {
                            <span>@v.CompanyName</span>
                        }
                        @if (!string.IsNullOrEmpty(v.Location))
                        {
                            <span>@v.Location</span>
                        }
                        <span>@(v.IsTemporary ? Lang.T("admin.vacancies.temporary") : Lang.T("admin.vacancies.permanent"))</span>
                        @if (v.ViewsCount > 0)
                        {
                            <span class="admin-oneui-chip">@v.ViewsCount vistas</span>
                        }
                        @if (v.DaysSinceSigned.HasValue)
                        {
                            var overdue = v.TargetCoverageDays.HasValue && v.BusinessDaysSinceSigned > v.TargetCoverageDays;
                            <span class="admin-result-badge @(overdue ? "admin-result-badge--danger" : v.Status == (int)VacancyStatus.Closed ? "admin-result-badge--success" : "admin-result-badge--info")"
                                  title="@CoverageTooltip(v)">
                                @(v.Status == (int)VacancyStatus.Closed
                                    ? string.Format(Lang.T("admin.vacancies.coveredInDays"), v.DaysSinceSigned)
                                    : string.Format(Lang.T("admin.vacancies.dayFromSigning"), v.DaysSinceSigned))
                                @if (v.TargetCoverageDays.HasValue)
                                {
                                    <text> · @v.BusinessDaysSinceSigned/@v.TargetCoverageDays @Lang.T("admin.vacancies.businessDaysShort")</text>
                                }
                            </span>
                        }
                    </div>
                </div>
                <div class="admin-oneui-meta" @onclick:stopPropagation="true">
                    @if (v.Status != (int)VacancyStatus.Active)
                    {
                        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => Moderate(v.Id, (int)VacancyStatus.Active)">@Lang.T("admin.vacancies.approve")</button>
                    }
                    @if (v.Status != (int)VacancyStatus.Closed)
                    {
                        <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => Moderate(v.Id, (int)VacancyStatus.Closed)">@Lang.T("admin.vacancies.close")</button>
                    }
                </div>
                <svg class="admin-oneui-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><polyline points="9 18 15 12 9 6" /></svg>
            </div>
        }
    </div>

    @if (TotalPages > 1)
    {
        <div class="admin-pagination">
            <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">
                @Lang.T("admin.candidates.prev")
            </button>
            <span>@Lang.T("admin.candidates.page") @CurrentPage @Lang.T("admin.candidates.of") @TotalPages</span>
            <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">
                @Lang.T("admin.candidates.next")
            </button>
        </div>
    }
}

@* === Wizard: nueva vacante === *@
@if (ShowWizard)
{
    <div class="admin-modal-overlay" @onclick="CloseWizard">
        <div class="admin-modal" @onclick:stopPropagation="true" style="max-width: 640px; max-height: 90vh; overflow-y: auto;">
            <h3 class="admin-modal-title">@Lang.T("admin.vacancies.wizardTitle")</h3>

            <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
                @for (var i = 1; i <= 4; i++)
                {
                    var step = i;
                    <div style="flex: 1; text-align: center;">
                        <div style="height: 4px; border-radius: 2px; background: @(step <= WizardStep ? "var(--accent-primary)" : "var(--input-border)");"></div>
                        <div style="font-size: 0.7rem; margin-top: 0.35rem; color: @(step == WizardStep ? "var(--text-primary)" : "var(--text-muted)"); font-weight: @(step == WizardStep ? 600 : 400);">
                            @GetWizardStepName(step)
                        </div>
                    </div>
                }
            </div>

            <div class="admin-modal-body">
                @if (WizardStep == 1)
                {
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("admin.vacancies.company") *</label>
                        <select @bind="WizardModel.CompanyId" @bind:after="OnWizardCompanyChanged" class="admin-modal-input">
                            <option value="">@Lang.T("admin.vacancies.selectCompany")</option>
                            @foreach (var c in WizardCompanies)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("admin.vacancies.jobTitle") *</label>
                        <input type="text" @bind="WizardModel.Title" class="admin-modal-input" maxlength="200" placeholder="@Lang.T("admin.vacancies.jobTitlePlaceholder")" />
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("admin.vacancies.category")</label>
                        <select @bind="WizardModel.JobTypeId" class="admin-modal-input">
                            <option value="">@Lang.T("admin.contract.jobTypeUnmapped")</option>
                            @foreach (var level in JobTypes.GroupBy(t => t.JobLevelName))
                            {
                                <optgroup label="@level.Key">
                                    @foreach (var t in level)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                }
                else if (WizardStep == 2)
                {
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("admin.vacancies.description")</label>
                        <textarea @bind="WizardModel.Description" class="admin-modal-input" rows="5" placeholder="@Lang.T("admin.vacancies.descriptionPlaceholder")"></textarea>
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("admin.vacancies.requirements") *</label>
                        <textarea @bind="WizardModel.Requirements" class="admin-modal-input" rows="6" placeholder="@Lang.T("admin.vacancies.requirementsPlaceholder")"></textarea>
                        <p style="color: var(--text-muted); font-size: 0.75rem; margin: 0.4rem 0 0;">@Lang.T("admin.vacancies.requirementsHint")</p>
                    </div>
                }
                else if (WizardStep == 3)
                {
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.salaryMin")</label>
                            <input type="number" step="0.01" min="0" @bind="WizardModel.SalaryMin" class="admin-modal-input" />
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.salaryMax")</label>
                            <input type="number" step="0.01" min="0" @bind="WizardModel.SalaryMax" class="admin-modal-input" />
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.location")</label>
                            <input type="text" @bind="WizardModel.Location" class="admin-modal-input" maxlength="200" />
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.workMode")</label>
                            <select @bind="WizardModel.WorkMode" class="admin-modal-input">
                                <option value="0">@Lang.T("admin.vacancies.workOnSite")</option>
                                <option value="1">@Lang.T("admin.vacancies.workHybrid")</option>
                                <option value="2">@Lang.T("admin.vacancies.workRemote")</option>
                            </select>
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.contractType")</label>
                            <select @bind="WizardModel.ContractType" class="admin-modal-input">
                                <option value="0">@Lang.T("admin.vacancies.contractFullTime")</option>
                                <option value="1">@Lang.T("admin.vacancies.contractPartTime")</option>
                                <option value="2">@Lang.T("admin.vacancies.contractByContract")</option>
                                <option value="3">@Lang.T("admin.vacancies.contractRemote")</option>
                            </select>
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.experienceLevel")</label>
                            <select @bind="WizardModel.ExperienceLevel" class="admin-modal-input">
                                <option value="">@Lang.T("admin.common.notSpecified")</option>
                                <option value="0">@Lang.T("admin.vacancies.expNone")</option>
                                <option value="1">@Lang.T("admin.vacancies.expLessThanOne")</option>
                                <option value="2">@Lang.T("admin.vacancies.expOneToThree")</option>
                                <option value="3">@Lang.T("admin.vacancies.expThreeToFive")</option>
                                <option value="4">@Lang.T("admin.vacancies.expMoreThanFive")</option>
                            </select>
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.requiredApplicants")</label>
                            <input type="number" min="1" max="999" step="1" @bind="WizardModel.RequiredApplicants" class="admin-modal-input" />
                            <small style="color: var(--text-muted); font-size: 0.72rem;">@Lang.T("admin.vacancies.requiredApplicantsHint")</small>
                        </div>
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.vacancies.englishLevel")</label>
                            <select @bind="WizardModel.EnglishLevel" class="admin-modal-input">
                                <option value="">@Lang.T("admin.common.notSpecified")</option>
                                <option value="0">@Lang.T("admin.vacancies.engNone")</option>
                                <option value="1">@Lang.T("admin.vacancies.engBasic")</option>
                                <option value="2">@Lang.T("admin.vacancies.engIntermediate")</option>
                                <option value="3">@Lang.T("admin.vacancies.engAdvanced")</option>
                                <option value="4">@Lang.T("admin.vacancies.engNative")</option>
                            </select>
                        </div>
                    </div>
                }
                else
                {
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 0.75rem;">@Lang.T("admin.vacancies.reviewHint")</p>
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.company")</span><strong>@(WizardCompanies.FirstOrDefault(c => c.Id == WizardModel.CompanyId)?.Name ?? "-")</strong></div>
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.jobTitle")</span><strong>@WizardModel.Title</strong></div>
                    @if (WizardModel.JobTypeId.HasValue)
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.category")</span><strong>@(JobTypes.FirstOrDefault(t => t.Id == WizardModel.JobTypeId)?.Name ?? "-")</strong></div>
                    }
                    @if (!string.IsNullOrEmpty(WizardModel.Location))
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.location")</span><strong>@WizardModel.Location</strong></div>
                    }
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.contractType")</span><strong>@GetContractTypeLabel(WizardModel.ContractType)</strong></div>
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.workMode")</span><strong>@GetWorkModeLabel(WizardModel.WorkMode)</strong></div>
                    @if (WizardModel.SalaryMin.HasValue || WizardModel.SalaryMax.HasValue)
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.salaryRange")</span><strong>@(WizardModel.SalaryMin?.ToString("N0") ?? "-") - @(WizardModel.SalaryMax?.ToString("N0") ?? "-")</strong></div>
                    }
                    @if (WizardModel.YearsExperience.HasValue)
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.yearsExperience")</span><strong>@WizardModel.YearsExperience</strong></div>
                    }
                    @if (WizardModel.RequiredApplicants.HasValue)
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.vacancies.requiredApplicants")</span><strong>@WizardModel.RequiredApplicants</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(WizardModel.Requirements))
                    {
                        <div class="admin-recruitment-info-row" style="flex-direction: column; align-items: flex-start; gap: 0.3rem;">
                            <span>@Lang.T("admin.vacancies.requirements")</span>
                            <strong style="white-space: pre-line; font-weight: 400;">@WizardModel.Requirements</strong>
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(WizardError))
                {
                    <p style="color: var(--danger); font-size: 0.8rem; margin-top: 0.75rem;">@WizardError</p>
                }
            </div>

            <div class="admin-modal-actions">
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseWizard">@Lang.T("admin.common.cancel")</button>
                @if (WizardStep > 1)
                {
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="WizardBack">@Lang.T("admin.vacancies.back")</button>
                }
                @if (WizardStep < 4)
                {
                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="WizardNext">@Lang.T("admin.vacancies.next")</button>
                }
                else
                {
                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="CreateVacancy" disabled="@IsCreatingVacancy">@Lang.T("admin.vacancies.publish")</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<AdminVacancyDto>? VacanciesList;
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 20;
    private int TotalPages { get; set; }
    [Parameter] public Guid? CompanyId { get; set; }
    private string? CompanyFilterName { get; set; }

    // === Wizard: nueva vacante ===
    private bool ShowWizard { get; set; }
    private int WizardStep { get; set; } = 1;
    private AdminCreateVacancyDto WizardModel { get; set; } = new();
    private List<CompanyListDto> WizardCompanies { get; set; } = new();
    private string? WizardError { get; set; }
    private bool IsCreatingVacancy { get; set; }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/vacancies/{id}");

    private static string GetVacancyInitial(string? title)
        => string.IsNullOrWhiteSpace(title) ? "?" : title.Trim()[0].ToString().ToUpperInvariant();

    private async Task OpenWizard()
    {
        WizardModel = new AdminCreateVacancyDto();
        WizardStep = 1;
        WizardError = null;
        ShowWizard = true;
        WizardCompanies = await AuthApi.GetCompaniesAsync(pageSize: 200);
        if (CompanyId.HasValue)
        {
            WizardModel.CompanyId = CompanyId.Value;
            await OnWizardCompanyChanged();
        }
    }

    private void CloseWizard() => ShowWizard = false;

    private string GetWizardStepName(int step) => step switch
    {
        1 => Lang.T("admin.vacancies.stepCompany"),
        2 => Lang.T("admin.vacancies.stepContent"),
        3 => Lang.T("admin.vacancies.stepTerms"),
        4 => Lang.T("admin.vacancies.stepReview"),
        _ => ""
    };

    private string GetContractTypeLabel(int type) => type switch
    {
        0 => Lang.T("admin.vacancies.contractFullTime"),
        1 => Lang.T("admin.vacancies.contractPartTime"),
        2 => Lang.T("admin.vacancies.contractByContract"),
        3 => Lang.T("admin.vacancies.contractRemote"),
        _ => "-"
    };

    private string GetWorkModeLabel(int mode) => mode switch
    {
        0 => Lang.T("admin.vacancies.workOnSite"),
        1 => Lang.T("admin.vacancies.workHybrid"),
        2 => Lang.T("admin.vacancies.workRemote"),
        _ => "-"
    };

    private bool ValidateStep(int step) => step switch
    {
        1 => WizardModel.CompanyId != Guid.Empty && !string.IsNullOrWhiteSpace(WizardModel.Title),
        2 => !string.IsNullOrWhiteSpace(WizardModel.Requirements),
        _ => true
    };

    /// <summary>La ubicacion de la vacante arranca con la direccion de la empresa (la elegida en el
    /// mapa al darla de alta); el admin la puede cambiar si el puesto es en otro sitio.</summary>
    private async Task OnWizardCompanyChanged()
    {
        if (WizardModel.CompanyId == Guid.Empty || !string.IsNullOrWhiteSpace(WizardModel.Location)) return;
        var company = await AuthApi.GetCompanyAsync(WizardModel.CompanyId);
        if (company == null) return;
        var location = string.Join(", ", new[] { company.Address, company.City }.Where(s => !string.IsNullOrWhiteSpace(s)));
        if (location.Length > 0) WizardModel.Location = location;
    }

    private void WizardNext()
    {
        if (!ValidateStep(WizardStep))
        {
            WizardError = Lang.T("admin.vacancies.wizardRequired");
            return;
        }
        WizardError = null;
        WizardStep++;
    }

    private void WizardBack()
    {
        WizardError = null;
        WizardStep--;
    }

    private async Task CreateVacancy()
    {
        if (IsCreatingVacancy) return;
        IsCreatingVacancy = true;
        WizardError = null;

        var result = await AuthApi.CreateVacancyAsync(WizardModel);
        if (result == null)
        {
            WizardError = Lang.T("admin.vacancies.wizardError");
            IsCreatingVacancy = false;
            return;
        }

        ShowWizard = false;
        await LoadVacancies();
        IsCreatingVacancy = false;
    }

    // Fase 3, sub-fase 3.8: cola de shortlist (vista simple, sin workflow de aprobacion - ver fase-3-sub8.md pregunta 3).
    private Guid? ShortlistVacancyId { get; set; }
    private List<JobMatchDto> Shortlist { get; set; } = new();
    private int? LastEvaluatedCount { get; set; }
    private bool IsShortlistBusy { get; set; }

    // Negociaciones (rol Comercial): presentar candidatos del shortlist a la empresa y cerrar.
    private HashSet<Guid> SelectedCandidateIds { get; set; } = new();
    private List<NegotiationDto> Negotiations { get; set; } = new();
    private Dictionary<Guid, string> SelectedWinnerByNegotiation { get; set; } = new();
    private Dictionary<Guid, DateTime> IncorporationDateByNegotiation { get; set; } = new();
    private Dictionary<Guid, DateTime> HiringDateByNegotiation { get; set; } = new();
    private bool IsNegotiationBusy { get; set; }

    // Garantia de reposicion (paso 20): un solo formulario abierto a la vez, igual que el
    // patron de "marcar tramo como pagado" en VacancyContract.razor.
    private Guid? ActivatingReplacementForId { get; set; }
    private int ReplacementReason { get; set; }
    private string? ReplacementNotes { get; set; }
    private string? ReplacementError { get; set; }

    // Cierre del proceso post-garantia (paso 21): mismo patron de un formulario a la vez.
    private Guid? ClosingProcessForId { get; set; }
    private string? CloseProcessNotes { get; set; }
    private string? CloseProcessError { get; set; }

    // Feedback de mejora continua (paso 22): mismo patron de un formulario a la vez.
    private Guid? RecordingFeedbackForId { get; set; }
    private int FeedbackRating { get; set; } = 5;
    private string? FeedbackComments { get; set; }
    private string? FeedbackError { get; set; }

    private static bool IsExclusionReason(int reason) => ((WarrantyReplacementReason)reason).IsExclusion();

    private List<(int Value, string Label)> WarrantyReplacementReasonOptions => new()
    {
        (0, Lang.T("admin.warrantyReplacement.reasonBajoDesempeno")),
        (1, Lang.T("admin.warrantyReplacement.reasonProblemasAsistencia")),
        (2, Lang.T("admin.warrantyReplacement.reasonFaltaGraveORobo")),
        (3, Lang.T("admin.warrantyReplacement.reasonBajaMedica")),
        (4, Lang.T("admin.warrantyReplacement.reasonRenunciaVoluntaria")),
        (5, Lang.T("admin.warrantyReplacement.reasonOtro")),
        (6, Lang.T("admin.warrantyReplacement.reasonImpagoDeNomina")),
        (7, Lang.T("admin.warrantyReplacement.reasonCambioSustancialDeCondiciones")),
        (8, Lang.T("admin.warrantyReplacement.reasonCierreDelNegocio")),
        (9, Lang.T("admin.warrantyReplacement.reasonIncumplimientoNormativo"))
    };

    private async Task ConfirmActivateReplacementAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        IsNegotiationBusy = true;
        ReplacementError = null;

        var dto = new ActivateWarrantyReplacementDto { Reason = ReplacementReason, Notes = ReplacementNotes };
        var (result, error) = await AuthApi.ActivateNegotiationWarrantyReplacementAsync(negotiationId, dto);
        if (result != null)
        {
            ActivatingReplacementForId = null;
            await LoadNegotiations(vacancyId);
        }
        else
        {
            ReplacementError = error ?? "No se pudo activar la reposicion.";
        }
        IsNegotiationBusy = false;
    }

    private async Task ConfirmCloseProcessAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        IsNegotiationBusy = true;
        CloseProcessError = null;

        var dto = new CloseProcessDto { Notes = CloseProcessNotes };
        var (result, error) = await AuthApi.CloseNegotiationProcessAsync(negotiationId, dto);
        if (result != null)
        {
            ClosingProcessForId = null;
            await LoadNegotiations(vacancyId);
        }
        else
        {
            CloseProcessError = error ?? "No se pudo cerrar el proceso.";
        }
        IsNegotiationBusy = false;
    }

    private async Task ConfirmRecordFeedbackAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        IsNegotiationBusy = true;
        FeedbackError = null;

        var dto = new RecordFeedbackDto { Rating = FeedbackRating, Comments = FeedbackComments };
        var (result, error) = await AuthApi.RecordNegotiationFeedbackAsync(negotiationId, dto);
        if (result != null)
        {
            RecordingFeedbackForId = null;
            await LoadNegotiations(vacancyId);
        }
        else
        {
            FeedbackError = error ?? "No se pudo registrar el feedback.";
        }
        IsNegotiationBusy = false;
    }

    private async Task ToggleShortlist(Guid vacancyId)
    {
        if (ShortlistVacancyId == vacancyId)
        {
            ShortlistVacancyId = null;
            return;
        }
        ShortlistVacancyId = vacancyId;
        LastEvaluatedCount = null;
        SelectedCandidateIds.Clear();
        Shortlist = await AuthApi.GetVacancyShortlistAsync(vacancyId);
        await LoadNegotiations(vacancyId);
    }

    private async Task LoadNegotiations(Guid vacancyId)
    {
        Negotiations = await AuthApi.GetNegotiationsByVacancyAsync(vacancyId);
        foreach (var n in Negotiations)
        {
            if (!SelectedWinnerByNegotiation.ContainsKey(n.Id))
                SelectedWinnerByNegotiation[n.Id] = "";
            if (!IncorporationDateByNegotiation.ContainsKey(n.Id))
                IncorporationDateByNegotiation[n.Id] = DateTime.Today;
            if (!HiringDateByNegotiation.ContainsKey(n.Id))
                HiringDateByNegotiation[n.Id] = DateTime.Today;
        }
    }

    private void ToggleCandidateSelection(Guid candidateId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked) SelectedCandidateIds.Add(candidateId);
        else SelectedCandidateIds.Remove(candidateId);
    }

    private async Task PresentToCompanyAsync(Guid vacancyId)
    {
        if (SelectedCandidateIds.Count == 0 || IsNegotiationBusy) return;
        IsNegotiationBusy = true;
        await AuthApi.CreateNegotiationAsync(new CreateNegotiationDto
        {
            VacancyId = vacancyId,
            CandidateIds = SelectedCandidateIds.ToList()
        });
        SelectedCandidateIds.Clear();
        await LoadNegotiations(vacancyId);
        IsNegotiationBusy = false;
    }

    private async Task CloseNegotiationAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        if (!SelectedWinnerByNegotiation.TryGetValue(negotiationId, out var winnerRaw) || !Guid.TryParse(winnerRaw, out var winnerId))
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", Lang.T("admin.negotiation.confirmClose"));
        if (!confirmed) return;

        IsNegotiationBusy = true;
        await AuthApi.CloseNegotiationAsync(negotiationId, winnerId);
        await LoadNegotiations(vacancyId);
        await LoadVacancies();
        IsNegotiationBusy = false;
    }

    private async Task SetNegotiationIncorporationAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        if (!IncorporationDateByNegotiation.TryGetValue(negotiationId, out var date)) return;

        IsNegotiationBusy = true;
        await AuthApi.SetNegotiationIncorporationDateAsync(negotiationId, date);
        await LoadNegotiations(vacancyId);
        IsNegotiationBusy = false;
    }

    private async Task SetNegotiationHiringAsync(Guid negotiationId, Guid vacancyId)
    {
        if (IsNegotiationBusy) return;
        if (!HiringDateByNegotiation.TryGetValue(negotiationId, out var date)) return;

        IsNegotiationBusy = true;
        await AuthApi.SetNegotiationHiringDateAsync(negotiationId, date);
        await LoadNegotiations(vacancyId);
        IsNegotiationBusy = false;
    }

