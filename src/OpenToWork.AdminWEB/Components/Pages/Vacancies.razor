    private async Task CalculateShortlistAsync(Guid vacancyId)
    {
        if (IsShortlistBusy) return;
        IsShortlistBusy = true;
        LastEvaluatedCount = await AuthApi.CalculateVacancyMatchesAsync(vacancyId);
        Shortlist = await AuthApi.GetVacancyShortlistAsync(vacancyId);
        IsShortlistBusy = false;
    }

    private List<JobTypeDto> JobTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        if (CompanyId.HasValue)
        {
            var company = await AuthApi.GetCompanyAsync(CompanyId.Value);
            CompanyFilterName = company?.Name;
        }

        JobTypes = await AuthApi.GetJobTypesAsync();
        await LoadVacancies();
    }

    private async Task LoadVacancies()
    {
        var result = await AuthApi.GetVacanciesAsync(page: CurrentPage, pageSize: PageSize, companyId: CompanyId);
        VacanciesList = result.Items;
        TotalPages = result.TotalPages;
    }

    private async Task PrevPage()
    {
        if (CurrentPage <= 1) return;
        CurrentPage--;
        await LoadVacancies();
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages) return;
        CurrentPage++;
        await LoadVacancies();
    }

    private async Task Moderate(Guid id, int status)
    {
        await AuthApi.ModerateVacancyAsync(id, status);
        await LoadVacancies();
    }

    private string CoverageTooltip(AdminVacancyDto v) =>
        string.Format(Lang.T("admin.vacancies.coverageTooltip"),
            v.ContractSignedAt?.ToLocalTime().ToString("dd/MM/yyyy"),
            v.Status == (int)VacancyStatus.Closed && v.ClosedAt.HasValue ? v.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy") : Lang.T("admin.vacancies.today"),
            v.DaysSinceSigned, v.BusinessDaysSinceSigned,
            v.TargetCoverageDays?.ToString() ?? "-");

    private string StatusLabel(int status) => (VacancyStatus)status switch
    {
        VacancyStatus.Draft => Lang.T("admin.vacancies.statusDraft"),
        VacancyStatus.Active => Lang.T("admin.vacancies.statusActive"),
        VacancyStatus.Closed => Lang.T("admin.vacancies.statusClosed"),
        _ => status.ToString()
    };

    private async Task ExportCsv()
    {
        var bytes = await AuthApi.ExportVacanciesCsvAsync();
        if (bytes == null) return;

        await JS.InvokeVoidAsync("fileDownload.save", $"vacancies-{DateTime.Now:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }
}
