    {
        ApplicationStatus.Pending => Lang.T("admin.negotiation.appPending"),
        ApplicationStatus.InReview => Lang.T("admin.negotiation.appInReview"),
        ApplicationStatus.Accepted => Lang.T("admin.negotiation.appAccepted"),
        ApplicationStatus.Rejected => Lang.T("admin.negotiation.appRejected"),
