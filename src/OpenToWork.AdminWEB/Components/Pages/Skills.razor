@page "/skills"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.skills.title")</PageTitle>

<div class="admin-page-header">
    <h1>@Lang.T("admin.skills.title")</h1>
</div>

<EditForm Model="NewSkill" OnValidSubmit="AddSkill" class="admin-inline-form">
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.skills.namePlaceholder")</label>
        <InputText class="ot-input-field" @bind-Value="NewSkill.Name" placeholder="@Lang.T("admin.skills.namePlaceholder")" />
    </div>
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.skills.categoryPlaceholder")</label>
        <InputText class="ot-input-field" @bind-Value="NewSkill.Category" placeholder="@Lang.T("admin.skills.categoryPlaceholder")" />
    </div>
    <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium">@Lang.T("admin.skills.add")</button>
</EditForm>

@if (SkillsList == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (SkillsList.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-icon">&#9632;</div>
        <div class="admin-empty-text">@Lang.T("admin.skills.empty")</div>
    </div>
}
else
{
    <table class="ot-table">
        <thead>
            <tr>
                <th>@Lang.T("admin.skills.columnName")</th>
                <th>@Lang.T("admin.skills.columnCategory")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skill in SkillsList)
            {
                <tr>
                    <td>@skill.Name</td>
                    <td>@(skill.Category ?? "-")</td>
                    <td>
                        <div class="admin-table-actions">
                            <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => DeleteSkill(skill.Id)">@Lang.T("admin.skills.delete")</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AdminSkillDto>? SkillsList;
    private CreateSkillDto NewSkill { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var token = await LocalStorage.GetItemAsync("otwadmin-token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadSkills();
    }

    private async Task LoadSkills()
    {
        SkillsList = await AuthApi.GetSkillsAsync();
    }

    private async Task AddSkill()
    {
        if (string.IsNullOrWhiteSpace(NewSkill.Name)) return;

        await AuthApi.CreateSkillAsync(NewSkill);
        NewSkill = new CreateSkillDto();
        await LoadSkills();
    }

    private async Task DeleteSkill(Guid id)
    {
        await AuthApi.DeleteSkillAsync(id);
        await LoadSkills();
    }
}
