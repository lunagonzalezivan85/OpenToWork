@page "/users"
@using Microsoft.AspNetCore.Components
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@Lang.T("admin.users.title")</PageTitle>

<div class="admin-page-header">
    <h1>@Lang.T("admin.users.title")</h1>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="OpenCreateModal">@Lang.T("admin.users.create")</button>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ExportCsv">@Lang.T("admin.users.exportCsv")</button>
    </div>
</div>

<div class="admin-users-toolbar">
    <div class="admin-users-search">
        <input type="text" @bind="SearchTerm" @bind:event="oninput" placeholder="@Lang.T("admin.users.searchPlaceholder")" />
    </div>
    <div class="admin-users-chips">
        <button class="admin-chip @(SelectedRole == null ? "admin-chip--active" : "")" @onclick="SelectAllRoles">
            @Lang.T("admin.users.chipAll") <span class="admin-chip-count">@AllUsers.Count</span>
        </button>
        <button class="admin-chip @(SelectedRole == "candidate" ? "admin-chip--active" : "")" @onclick="SelectCandidates">
            @Lang.T("admin.users.filterCandidates") <span class="admin-chip-count">@AllUsers.Count(u => u.PrimaryRole == (int)UserRole.Candidate)</span>
        </button>
        <button class="admin-chip @(SelectedRole == "company" ? "admin-chip--active" : "")" @onclick="SelectCompanies">
            @Lang.T("admin.users.filterCompanies") <span class="admin-chip-count">@AllUsers.Count(u => u.PrimaryRole == (int)UserRole.Company)</span>
        </button>
        <button class="admin-chip @(SelectedRole == "admin" ? "admin-chip--active" : "")" @onclick="SelectAdmins">
            @Lang.T("admin.users.filterAdmins") <span class="admin-chip-count">@AllUsers.Count(u => u.PrimaryRole == (int)UserRole.Admin)</span>
        </button>
    </div>
</div>

@if (UsersList == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (FilteredUsers.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-text">@Lang.T("admin.users.empty")</div>
    </div>
}
else
{
    <div class="admin-users-grid">
        @foreach (var user in FilteredUsers)
        {
            <div class="admin-user-card admin-clickable" @onclick="() => ViewProfile(user.Id)">
                <div class="admin-user-card-header">
                    <div class="admin-user-card-avatar">
                        @AvatarText(user)
                    </div>
                    <div class="admin-user-card-info">
                        <div class="admin-user-card-name">@(user.CandidateName ?? user.Email)</div>
                        <div class="admin-user-card-email">@user.Email</div>
                    </div>
                    <div class="admin-user-card-status @(user.IsActive ? "admin-user-card-status--active" : "admin-user-card-status--inactive")">
                        @(user.IsActive ? Lang.T("admin.users.active") : Lang.T("admin.users.inactive"))
                    </div>
                </div>
                <div class="admin-user-card-body">
                    <span class="admin-result-badge admin-result-badge--info">@((UserRole)user.PrimaryRole)</span>
                    @if (user.WizardCompleted == true)
                    {
                        <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.dashboard.evaluated")</span>
                    }
                    else if (user.WizardCompleted == false)
                    {
                        <span class="admin-result-badge admin-result-badge--warning">@Lang.T("admin.dashboard.pending")</span>
                    }
                    @if (user.HasLinkedIn == true)
                    {
                        <span class="admin-result-badge admin-result-badge--info">LinkedIn</span>
                    }
                    @if (user.HasPortfolio == true)
                    {
                        <span class="admin-result-badge admin-result-badge--info">@Lang.T("admin.dashboard.withPortfolio")</span>
                    }
                    @if (user.HasCV == true)
                    {
                        <span class="admin-result-badge admin-result-badge--success">CV</span>
                    }
                </div>
                <div class="admin-user-card-footer">
                    <span class="admin-user-card-date">@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    <div class="admin-user-card-actions">
                        <select class="admin-select admin-role-select" @onclick:stopPropagation="true"
                                value="@user.PrimaryRole" @onchange="(e) => ChangeRole(user.Id, e)"
                                disabled="@(user.Id == CurrentAdminId)" title="@Lang.T("admin.users.changeRole")">
                            <option value="0">@Lang.T("admin.users.roleCandidate")</option>
                            <option value="1">@Lang.T("admin.users.roleCompany")</option>
                            <option value="2">@Lang.T("admin.users.roleAdmin")</option>
                        </select>
                        @if (user.IsActive)
                        {
                            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick:stopPropagation="true" @onclick="() => Deactivate(user.Id)">@Lang.T("admin.users.deactivate")</button>
                        }
                        else
                        {
                            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick:stopPropagation="true" @onclick="() => Activate(user.Id)">@Lang.T("admin.users.activate")</button>
                        }
                        <button class="ot-btn ot-btn--danger ot-btn--small" @onclick:stopPropagation="true" @onclick="() => Delete(user.Id)">@Lang.T("admin.users.delete")</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (ShowCreateModal)
{
    <div class="admin-modal-overlay" @onclick="CloseCreateModal">
        <div class="admin-modal" @onclick:stopPropagation="true" style="min-width: 420px; max-width: 90vw;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 class="admin-modal-title" style="margin: 0;">@Lang.T("admin.users.createTitle")</h3>
                <button class="ot-btn ot-btn--outline ot-btn--small" style="padding: 0.2rem 0.5rem; font-size: 1rem;" @onclick="CloseCreateModal">&times;</button>
            </div>
            <div class="admin-modal-body">
                @if (CreateError != null)
                {
                    <p style="color: var(--danger); font-size: 0.85rem;">@CreateError</p>
                }
                <div>
                    <label>@Lang.T("admin.users.createEmail")</label>
                    <input type="email" @bind="NewUserEmail" class="admin-modal-input" style="width: 100%;" placeholder="user@email.com" />
                </div>
                <div>
                    <label>@Lang.T("admin.users.createPassword")</label>
                    <input type="password" @bind="NewUserPassword" class="admin-modal-input" style="width: 100%;" placeholder="******" />
                </div>
                <div>
                    <label>@Lang.T("admin.users.createRole")</label>
                    <select @bind="NewUserRole" class="admin-modal-select" style="width: 100%;">
                        <option value="0">@Lang.T("admin.users.roleCandidate")</option>
                        <option value="1">@Lang.T("admin.users.roleCompany")</option>
                        <option value="2">@Lang.T("admin.users.roleAdmin")</option>
                    </select>
                </div>
                @if (NewUserRole == 2)
                {
                    <div>
                        <label>@Lang.T("admin.users.createStaffRole")</label>
                        <select @bind="NewUserStaffRole" class="admin-modal-select" style="width: 100%;">
                            <option value="1">@Lang.T("admin.users.staffRecruiter")</option>
                            <option value="2">@Lang.T("admin.users.staffComercial")</option>
                        </select>
                    </div>
                }
            </div>
            <div class="admin-modal-actions">
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseCreateModal">@Lang.T("admin.common.cancel")</button>
                <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@IsCreating" @onclick="SubmitCreateAsync">
                    @(IsCreating ? Lang.T("admin.common.loading") : Lang.T("admin.common.confirm"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminUserDto> AllUsers = new();
    private List<AdminUserDto>? UsersList;
    private string? SelectedRole { get; set; }
    private string SearchTerm { get; set; } = "";
    private Guid? CurrentAdminId;

    private bool ShowCreateModal;
    private bool IsCreating;
    private string? CreateError;
    private string NewUserEmail = "";
    private string NewUserPassword = "";
    private int NewUserRole = 0;
    private int NewUserStaffRole = 1;

    private List<AdminUserDto> FilteredUsers
    {
        get
        {
            if (UsersList == null) return new();

            var filtered = UsersList;

            if (!string.IsNullOrEmpty(SelectedRole))
            {
                var roleInt = SelectedRole switch
                {
                    "candidate" => (int)UserRole.Candidate,
                    "company" => (int)UserRole.Company,
                    "admin" => (int)UserRole.Admin,
                    _ => -1
                };
                filtered = filtered.Where(u => u.PrimaryRole == roleInt).ToList();
            }

            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                var term = SearchTerm.ToLowerInvariant();
                filtered = filtered.Where(u =>
                    u.Email.ToLowerInvariant().Contains(term) ||
                    (u.CandidateName?.ToLowerInvariant().Contains(term) ?? false)
                ).ToList();
            }

            return filtered;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var userIdRaw = await LocalStorage.GetItemAsync("otwadmin-user-id");
        if (Guid.TryParse(userIdRaw, out var parsedId))
            CurrentAdminId = parsedId;

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        AllUsers = await AuthApi.GetUsersAsync();
        UsersList = AllUsers;
    }

    private void SelectRole(string? role)
    {
        SelectedRole = role;
    }

    private void SelectAllRoles() => SelectedRole = null;
    private void SelectCandidates() => SelectedRole = "candidate";
    private void SelectCompanies() => SelectedRole = "company";
    private void SelectAdmins() => SelectedRole = "admin";

    private string AvatarText(AdminUserDto user)
    {
        var name = user.CandidateName ?? user.Email;
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private void ViewProfile(Guid userId) => Nav.NavigateTo($"/user/{userId}");

    private async Task Activate(Guid id)
    {
        await AuthApi.ActivateUserAsync(id);
        await LoadUsers();
    }

    private async Task Deactivate(Guid id)
    {
        await AuthApi.DeactivateUserAsync(id);
        await LoadUsers();
    }

    private async Task Delete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", Lang.T("admin.users.confirmDelete"));
        if (!confirmed) return;

        await AuthApi.DeleteUserAsync(id);
        await LoadUsers();
    }

    private async Task ChangeRole(Guid id, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var newRole)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", Lang.T("admin.users.confirmRoleChange"));
        if (!confirmed)
        {
            await LoadUsers();
            return;
        }

        await AuthApi.ChangeUserRoleAsync(id, newRole);
        await LoadUsers();
    }

    private async Task ExportCsv()
    {
        var bytes = await AuthApi.ExportUsersCsvAsync();
        if (bytes == null) return;

        await JS.InvokeVoidAsync("fileDownload.save", $"users-{DateTime.Now:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }

    private void OpenCreateModal()
    {
        ShowCreateModal = true;
        CreateError = null;
        NewUserEmail = "";
        NewUserPassword = "";
        NewUserRole = 0;
        NewUserStaffRole = 1;
    }

    private void CloseCreateModal()
    {
        ShowCreateModal = false;
    }

    private async Task SubmitCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(NewUserEmail) || string.IsNullOrWhiteSpace(NewUserPassword))
        {
            CreateError = Lang.T("admin.users.createErrorFields");
            return;
        }

        IsCreating = true;
        CreateError = null;
        try
        {
            var dto = new CreateUserDto
            {
                Email = NewUserEmail,
                Password = NewUserPassword,
                PrimaryRole = NewUserRole,
                StaffRole = NewUserRole == 2 ? NewUserStaffRole : null
            };
            var (user, error) = await AuthApi.CreateUserAsync(dto);
            if (user == null)
            {
                CreateError = error ?? Lang.T("admin.users.createError");
            }
            else
            {
                ShowCreateModal = false;
                await LoadUsers();
            }
        }
        catch
        {
            CreateError = Lang.T("admin.users.createError");
        }
        IsCreating = false;
    }
}
