@page "/companies/{CompanyId}"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@(Company?.Name ?? "Empresa")</PageTitle>

@if (Company == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else
{
    @* === Barra superior === *@
    <div class="admin-detail-topbar">
        <button class="admin-pill-btn" @onclick='() => Nav.NavigateTo("/companies")'>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            @Lang.T("admin.common.back")
        </button>
        <div class="admin-detail-topbar-actions">
            <button class="admin-pill-btn admin-pill-btn--featured" disabled="@IsTogglingFeatured" @onclick="ToggleFeatured">
                <svg viewBox="0 0 24 24" fill="@(Company.IsFeatured ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                @(Company.IsFeatured ? Lang.T("admin.companies.unfeature") : Lang.T("admin.companies.feature"))
            </button>
            <div class="admin-dropdown">
                <button class="admin-pill-btn" @onclick="ToggleActionsMenu">
                    @Lang.T("admin.companies.actions")
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                @if (ShowActionsMenu)
                {
                    <div class="admin-dropdown-overlay" @onclick="CloseActionsMenu"></div>
                    <div class="admin-dropdown-menu">
                        <button class="admin-dropdown-item" @onclick='() => Nav.NavigateTo($"/companies/{Company.Id}/vacancies")'>
                            @Lang.T("admin.companies.viewVacancies")
                        </button>
                        <button class="admin-dropdown-item" disabled="@IsLoadingContract" @onclick="ViewContract">
                            @(IsLoadingContract ? Lang.T("admin.common.loading") : Lang.T("admin.contract.viewDocument"))
                        </button>
                        <button class="admin-dropdown-item" @onclick='() => Nav.NavigateTo($"/companies/{Company.Id}/edit")'>
                            @Lang.T("admin.common.edit")
                        </button>
                        <button class="admin-dropdown-item admin-dropdown-item--danger" disabled="@IsDeleting" @onclick="DeleteCompany">
                            @(IsDeleting ? Lang.T("admin.common.loading") : Lang.T("admin.companies.delete"))
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* === Hero card === *@
    <div class="admin-hero-card @(HasSignedContract ? "admin-hero-card--signed" : "")">
        <div class="admin-hero-body admin-company-hero-body">
            <div class="admin-company-avatar">
                @(Company.Name.Length >= 2 ? Company.Name.Substring(0, 2).ToUpper() : Company.Name.ToUpper())
            </div>
            <div class="admin-hero-info">
                <div class="admin-hero-name-row">
                    <h1 class="admin-hero-name">@(Company.LegalName ?? Company.Name)</h1>
                    @if (HasSignedContract)
                    {
                        <span class="admin-signed-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><polyline points="20 6 9 17 4 12"/></svg>
                            @Lang.T("admin.companies.contractSigned")
                        </span>
                    }
                </div>
                <div class="admin-hero-chips">
                    @if (!string.IsNullOrEmpty(Company.Industry))
                    {
                        <span class="admin-chip">@Company.Industry</span>
                    }
                    <span class="admin-chip @(Company.Status == (int)CompanyStatus.Activa ? "admin-chip--success" : Company.Status == (int)CompanyStatus.Inactiva ? "admin-chip--danger" : "admin-chip--warning")">
                        @GetStatusName(Company.Status)
                    </span>
                    @if (Company.Pipeline != null)
                    {
                        <span class="admin-chip admin-chip--info">@GetStageName(Company.Pipeline.CurrentStage)</span>
                    }
                    @if (Company.IsFeatured)
                    {
                        <span class="admin-chip admin-chip--warning">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                            @Lang.T("admin.companies.featured")
                        </span>
                    }
                    <label class="admin-plan-tier-picker" title="@Lang.T("admin.companies.planTierHint")">
                        @Lang.T("admin.companies.planTier"):
                        <select class="nav-select" value="@((int)Company.PlanTier)" @onchange="OnPlanTierChanged">
                            <option value="@((int)CompanyPlanTier.None)">Sin plan</option>
                            <option value="@((int)CompanyPlanTier.Basic)">Basic</option>
                            <option value="@((int)CompanyPlanTier.Premium)">Premium</option>
                            <option value="@((int)CompanyPlanTier.Platinum)">Platinum</option>
                        </select>
                    </label>
                    @if (Company.PlanExpiresAt.HasValue)
                    {
                        <span class="admin-chip @(Company.PlanIsActive ? "admin-chip--success" : "admin-chip--danger")">
                            @(Company.PlanIsActive ? Lang.T("admin.companies.planActiveUntil") : Lang.T("admin.companies.planExpiredOn")) @Company.PlanExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                        </span>
                    }
                </div>
                <div class="admin-hero-contact">
                    @if (!string.IsNullOrEmpty(Company.Country) || !string.IsNullOrEmpty(Company.City))
                    {
                        <span class="admin-hero-contact-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            @Company.City@(string.IsNullOrEmpty(Company.City) || string.IsNullOrEmpty(Company.Country) ? "" : ", ")@Company.Country
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Company.Pipeline?.AssignedToName))
                    {
                        <span class="admin-hero-contact-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            @Company.Pipeline.AssignedToName
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(Company.ContactPhone))
                    {
                        <span class="admin-hero-contact-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            @Company.ContactPhone
                        </span>
                    }
                </div>
            </div>
        </div>
        @if (Company.Pipeline != null)
        {
            <div class="admin-hero-pipeline">
                <div class="admin-hero-pipeline-row">
                    <span class="admin-hero-pipeline-stage">@GetStageName(Company.Pipeline.CurrentStage)</span>
                    <span class="admin-hero-pipeline-next">@NextStepLabel</span>
                    <span class="admin-hero-pipeline-pct">@PipelineProgress%</span>
                </div>
                <div class="admin-hero-progress">
                    <div class="admin-hero-progress-fill" style="width: @(PipelineProgress)%"></div>
                </div>
                <a href="/companies/pipeline/@Company.Pipeline.Id" class="admin-hero-pipeline-link">
                    @Lang.T("admin.companies.viewPipeline") →
                </a>
            </div>
        }
    </div>

    <div class="admin-users-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 1.5rem;">
        <div class="admin-user-card" style="cursor: default;">
            <div class="admin-user-card-header">
                <div class="admin-user-card-avatar" style="background: #E8F1FF; color: #0066FF;">
                    @(Company.Name.Length >= 2 ? Company.Name.Substring(0, 2).ToUpper() : Company.Name.ToUpper())
                </div>
                <div class="admin-user-card-info">
                    <div class="admin-user-card-name">@Lang.T("admin.companies.contactInfo")</div>
                </div>
            </div>
            <div class="admin-user-card-body" style="flex-direction: column; align-items: stretch; gap: 0.5rem;">
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.contactName")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.ContactName ?? "-")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.contactPosition")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.ContactPosition ?? "-")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.contactEmail")</span>
                    @if (!string.IsNullOrEmpty(Company.ContactEmail))
                    {
                        <a href="mailto:@Company.ContactEmail" style="color: #0066FF; font-size: 0.88rem; text-decoration: none;">@Company.ContactEmail</a>
                    }
                    else
                    {
                        <span style="font-weight: 500; font-size: 0.88rem;">-</span>
                    }
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.contactPhone")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.ContactPhone ?? "-")</span>
                </div>
                @* Acceso al portal (empresas creadas desde el admin nacen sin usuario): invitacion con enlace *@
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.35rem 0;">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.portalAccess")</span>
                    @if (PortalAccess?.IsActivated == true)
                    {
                        <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.companies.portalActive")</span>
                    }
                    else
                    {
                        <span style="display: flex; align-items: center; gap: 0.5rem;">
                            @if (PortalAccess?.HasAccount == true)
                            {
                                <span class="admin-result-badge admin-result-badge--warning">@Lang.T("admin.companies.portalInvited")</span>
                            }
                            <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@IsInviting" @onclick="InviteToPortalAsync">
                                @(PortalAccess?.HasAccount == true ? Lang.T("admin.companies.portalResendInvite") : Lang.T("admin.companies.portalInvite"))
                            </button>
                        </span>
                    }
                </div>
                @if (Company.SCUserId.HasValue)
                {
                    <div style="display: flex; justify-content: flex-end;">
                        <StartConversationButton UserId="Company.SCUserId.Value" />
                    </div>
                }
                @if (!string.IsNullOrEmpty(InviteError))
                {
                    <p style="color: var(--danger); font-size: 0.8rem; margin: 0;">@InviteError</p>
                }
                @if (InviteResult != null)
                {
                    <div style="background: var(--bg-soft, #F1F5F9); border-radius: 8px; padding: 0.6rem; font-size: 0.8rem;">
                        <p style="margin: 0 0 0.35rem;">
                            @(InviteResult.EmailSent
                                ? string.Format(Lang.T("admin.companies.portalInviteSent"), InviteResult.Email)
                                : Lang.T("admin.companies.portalInviteCopy"))
                        </p>
                        <div style="display: flex; gap: 0.35rem;">
                            <input class="admin-input" readonly value="@InviteResult.InviteUrl" style="flex: 1; font-size: 0.75rem;" />
                            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CopyInviteUrlAsync">@(InviteCopied ? Lang.T("admin.companies.portalCopied") : Lang.T("admin.companies.portalCopy"))</button>
                        </div>
                        <p style="margin: 0.35rem 0 0; color: #778DA9;">
                            @Lang.T("admin.companies.portalUser"): @InviteResult.Email · @Lang.T("admin.companies.portalExpires") @InviteResult.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </p>
                    </div>
                }
            </div>
        </div>

        <div class="admin-user-card" style="cursor: default;">
            <div class="admin-user-card-header">
                <div class="admin-user-card-avatar" style="background: #F1F5F9; color: #3A506B;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M3 21h18M3 21V7l9-4 9 4v14M9 21v-6h6v6" /></svg>
                </div>
                <div class="admin-user-card-info">
                    <div class="admin-user-card-name">@Lang.T("admin.companies.companyInfo")</div>
                </div>
            </div>
            <div class="admin-user-card-body" style="flex-direction: column; align-items: stretch; gap: 0.5rem;">
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.legalName")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.LegalName ?? "-")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.taxId")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.TaxId ?? "-")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.website")</span>
                    @if (!string.IsNullOrEmpty(Company.Website))
                    {
                        <a href="@Company.Website" target="_blank" style="color: #0066FF; font-size: 0.88rem; text-decoration: none;">@Company.Website</a>
                    }
                    else
                    {
                        <span style="font-weight: 500; font-size: 0.88rem;">-</span>
                    }
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05);">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.country")</span>
                    <span style="font-weight: 500; font-size: 0.88rem;">@(Company.Country ?? "-") / @(Company.City ?? "-")</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.35rem 0;">
                    <span style="color: #778DA9; font-size: 0.82rem;">@Lang.T("admin.companies.linkedin")</span>
                    @if (!string.IsNullOrEmpty(Company.LinkedInUrl))
                    {
                        <a href="@Company.LinkedInUrl" target="_blank" style="color: #0066FF; font-size: 0.88rem; text-decoration: none;">LinkedIn</a>
                    }
                    else
                    {
                        <span style="font-weight: 500; font-size: 0.88rem;">-</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Company.Pipeline == null)
    {
        <div class="admin-user-card" style="cursor: default; border: 2px dashed #E8F1FF;">
            <div style="text-align: center; padding: 1.5rem 1rem;">
                <div style="margin-bottom: 0.75rem; color: #778DA9;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40" style="margin: 0 auto;"><rect x="3" y="3" width="6" height="18" rx="1" /><rect x="9" y="3" width="6" height="12" rx="1" /><rect x="15" y="3" width="6" height="6" rx="1" /></svg>
                </div>
                <p style="color: #3A506B; font-weight: 500; margin-bottom: 0.25rem;">@Lang.T("admin.companies.noPipeline")</p>
                <p style="color: #778DA9; font-size: 0.85rem; margin-bottom: 1rem;">@Lang.T("admin.companies.noPipelineHint")</p>

                @if (AdminUsers.Count > 0)
                {
                    <div style="display: flex; gap: 0.5rem; align-items: center; justify-content: center; flex-wrap: wrap;">
                        <select class="admin-select" @bind="SelectedUserId" style="min-width: 220px;">
                            @foreach (var u in AdminUsers)
                            {
                                <option value="@u.Id">@u.Email</option>
                            }
                        </select>
                        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="AssignToUser" disabled="@IsAssigning">
                            @(IsAssigning ? Lang.T("admin.common.loading") : Lang.T("admin.companies.assignAndCreate"))
                        </button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public string CompanyId { get; set; } = "";
    private CompanyDetailDto? Company;
    private List<AdminUserDto> AdminUsers = new();
    private string SelectedUserId = "";
    private bool IsAssigning = false;
    private bool IsDeleting = false;
    private bool IsLoadingContract = false;
    private bool IsTogglingFeatured = false;
    private bool ShowActionsMenu = false;
    private AdminVacancyContractDto? Contract;

    private bool HasSignedContract => Contract?.Status == (int)ContractStatus.Accepted;

    private int PipelineProgress => Company?.Pipeline == null ? 0
        : Company.Pipeline.CurrentStage == (int)CompanyPipelineStage.CerradoPerdido ? 0
        : Math.Min(Company.Pipeline.CurrentStage, (int)CompanyPipelineStage.CerradoGanado) * 20;

    private string NextStepLabel
    {
        get
        {
            if (Company?.Pipeline == null) return "";
            var stage = Company.Pipeline.CurrentStage;
            if (stage == (int)CompanyPipelineStage.CerradoGanado) return Lang.T("admin.companies.pipelineComplete");
            if (stage == (int)CompanyPipelineStage.CerradoPerdido) return Lang.T("admin.companies.pipelineLost");
            return $"{Lang.T("admin.companies.missingNext")} {GetStageName(stage + 1)}";
        }
    }

    private void ToggleActionsMenu() => ShowActionsMenu = !ShowActionsMenu;
    private void CloseActionsMenu() => ShowActionsMenu = false;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        if (Guid.TryParse(CompanyId, out var id))
        {
            Company = await AuthApi.GetCompanyAsync(id);
            if (Company != null)
            {
                Contract = await AuthApi.GetContractByCompanyAsync(Company.Id);
                PortalAccess = await AuthApi.GetCompanyPortalAccessAsync(Company.Id);
            }
        }
        AdminUsers = await AuthApi.GetUsersAsync(role: (int)UserRole.Admin);
        SelectedUserId = AdminUsers.FirstOrDefault()?.Id.ToString() ?? "";
    }

    // Acceso al portal: el enlace de activacion solo se ve aqui, justo despues de generarlo
    // (en la base queda solo el hash del token).
    private CompanyPortalAccessDto? PortalAccess;
    private CompanyPortalInviteResultDto? InviteResult;
    private string? InviteError;
    private bool IsInviting;
    private bool InviteCopied;

    private async Task InviteToPortalAsync()
    {
        if (Company == null || IsInviting) return;
        IsInviting = true;
        InviteError = null;
        InviteCopied = false;
        var (result, error) = await AuthApi.InviteCompanyToPortalAsync(Company.Id);
        IsInviting = false;
        if (result == null)
        {
            InviteError = error ?? Lang.T("admin.companies.portalInviteError");
            return;
        }
        InviteResult = result;
        PortalAccess = await AuthApi.GetCompanyPortalAccessAsync(Company.Id);
        Company = await AuthApi.GetCompanyAsync(Company.Id) ?? Company; // ya tiene SCUserId: habilita "Enviar mensaje"
    }

    private async Task CopyInviteUrlAsync()
    {
        if (InviteResult == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteResult.InviteUrl);
        InviteCopied = true;
    }

    private async Task ViewContract()
    {
        if (Company == null) return;
        IsLoadingContract = true;
        var contract = await AuthApi.GetContractByCompanyAsync(Company.Id);
        IsLoadingContract = false;
        if (contract != null)
            Nav.NavigateTo($"/contracts/{contract.Id}/document");
    }

    private async Task AssignToUser()
    {
        if (Company == null || !Guid.TryParse(SelectedUserId, out var userId)) return;
        IsAssigning = true;
        var result = await AuthApi.AssignCompanyAsync(new AssignCompanyDto
        {
            CompanyId = Company.Id,
            AssignedToUserId = userId
        });
        IsAssigning = false;
        if (result != null)
        {
            Company = await AuthApi.GetCompanyAsync(Company.Id);
        }
    }

    private async Task ToggleFeatured()
    {
        if (Company == null) return;
        IsTogglingFeatured = true;
        var success = await AuthApi.SetCompanyFeaturedAsync(Company.Id, !Company.IsFeatured);
        IsTogglingFeatured = false;
        if (success)
            Company.IsFeatured = !Company.IsFeatured;
    }

    private async Task OnPlanTierChanged(ChangeEventArgs e)
    {
        if (Company == null || !int.TryParse(e.Value?.ToString(), out var raw)) return;
        var tier = (CompanyPlanTier)raw;
        var ok = await AuthApi.SetCompanyPlanTierAsync(Company.Id, tier);
        if (ok)
        {
            Company.PlanTier = tier;
            Company.PlanExpiresAt = tier == CompanyPlanTier.None ? null : DateTime.UtcNow.AddMonths(1);
            Company.PlanIsActive = tier != CompanyPlanTier.None;
        }
    }

    private async Task DeleteCompany()
    {
        if (Company == null) return;
        var confirmed = await JS.InvokeAsync<bool>("eval", $@"
            Swal.fire({{
                title: '{Lang.T("admin.companies.delete")}',
                text: '{Lang.T("admin.companies.deleteConfirm")}',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#778DA9',
                confirmButtonText: '{Lang.T("admin.common.confirm")}',
                cancelButtonText: '{Lang.T("admin.common.cancel")}'
            }}).then((result) => result.isConfirmed);
        ");
        if (!confirmed) return;
        IsDeleting = true;
        var success = await AuthApi.DeleteCompanyAsync(Company.Id);
        IsDeleting = false;
        if (success)
        {
            await JS.InvokeVoidAsync("eval", $@"
                Swal.fire({{
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '{Lang.T("admin.companies.deleted")}',
                    showConfirmButton: false,
                    timer: 2000
                }});
            ");
            Nav.NavigateTo("/companies");
        }
    }

    private string GetStatusName(int status) => status switch
    {
        (int)CompanyStatus.Activa => Lang.T("admin.companies.statusActive"),
        (int)CompanyStatus.Inactiva => Lang.T("admin.companies.statusInactive"),
        (int)CompanyStatus.Prospecto => Lang.T("admin.companies.statusProspect"),
        _ => "-"
    };

    private string GetStageName(int stage) => stage switch
    {
        (int)CompanyPipelineStage.Lead => Lang.T("admin.companies.stageLead"),
        (int)CompanyPipelineStage.Contactado => Lang.T("admin.companies.stageContacted"),
        (int)CompanyPipelineStage.ReunionAgendada => Lang.T("admin.companies.stageMeeting"),
        (int)CompanyPipelineStage.PropuestaEnviada => Lang.T("admin.companies.stageProposal"),
