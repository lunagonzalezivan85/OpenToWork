@page "/messages"
@page "/messages/{ConversationId:guid}"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@implements IDisposable

@* Bandeja del equipo de Trato Directo: conversaciones con candidatos y empresas del portal
   (MessagingService). El portal ve siempre "Trato Directo", nunca el reclutador. *@
<PageTitle>@Lang.T("admin.messages.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.messages.title")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.messages.subtitle")</p>
    </div>
</div>

<div class="admin-messages-grid">
    <div class="admin-recruitment-card" style="padding: 0.75rem;">
        <div style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem;">
            <button class="ot-btn ot-btn--small @(UnreadOnly ? "ot-btn--outline" : "ot-btn--primary")" @onclick="() => SetUnreadOnly(false)">@Lang.T("admin.messages.all")</button>
            <button class="ot-btn ot-btn--small @(UnreadOnly ? "ot-btn--primary" : "ot-btn--outline")" @onclick="() => SetUnreadOnly(true)">@Lang.T("admin.messages.unread")</button>
        </div>
        <input type="text" class="admin-input" style="width: 100%; margin-bottom: 0.5rem;" placeholder="@Lang.T("admin.messages.search")"
               @bind="Search" @bind:event="oninput" @bind:after="LoadInboxAsync" />

        @if (Inbox.Count == 0)
        {
            <p style="color: var(--text-muted); font-size: 0.85rem; text-align: center; padding: 1.5rem 0;">@Lang.T("admin.messages.empty")</p>
        }
        @foreach (var c in Inbox)
        {
            <div @onclick="() => OpenAsync(c.Id)"
                 style="cursor: pointer; padding: 0.6rem; border-radius: 10px; margin-bottom: 0.35rem; background: @(c.Id == ConversationId ? "var(--bg-soft, #F1F5F9)" : "transparent"); border: 1px solid var(--card-border);">
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <strong style="font-size: 0.85rem;">@c.UserName</strong>
                    <span style="font-size: 0.72rem; color: var(--text-muted);">@FormatTime(c.LastMessageAt)</span>
                </div>
                <div style="display: flex; gap: 0.35rem; align-items: center; margin: 0.2rem 0;">
                    <span class="admin-result-badge @(c.UserRole == (int)UserRole.Company ? "admin-result-badge--info" : "admin-result-badge--muted")">@RoleLabel(c.UserRole)</span>
                    @if (!string.IsNullOrEmpty(c.Subject))
                    {
                        <span style="font-size: 0.75rem;">@c.Subject</span>
                    }
                </div>
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <span style="font-size: 0.78rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@c.LastMessage</span>
                    @if (c.UnreadCount > 0)
                    {
                        <span class="admin-result-badge admin-result-badge--danger">@c.UnreadCount</span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="admin-recruitment-card">
        @if (Current == null)
        {
            <p style="color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 2rem 0;">@Lang.T("admin.messages.select")</p>
        }
        else
        {
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; border-bottom: 1px solid var(--card-border); padding-bottom: 0.6rem; margin-bottom: 0.75rem;">
                <div>
                    <h3 class="admin-recruitment-card-title" style="margin: 0;">@Current.UserName</h3>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                        @RoleLabel(Current.UserRole) · @Current.UserEmail
                        @if (!string.IsNullOrEmpty(Current.Subject)) { <span> · @Current.Subject</span> }
                        @if (!string.IsNullOrEmpty(Current.VacancyTitle)) { <span> · @Current.VacancyTitle</span> }
                    </div>
                    @if (!string.IsNullOrEmpty(Current.AssignedStaffName))
                    {
                        <div style="font-size: 0.75rem; color: var(--text-muted);">@Lang.T("admin.messages.assignedTo") @Current.AssignedStaffName</div>
                    }
                </div>
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoToProfile">@Lang.T("admin.messages.viewProfile")</button>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 55vh; overflow-y: auto; padding-right: 0.25rem;">
                @foreach (var m in Thread)
                {
                    <div style="align-self: @(m.IsFromStaff ? "flex-end" : "flex-start"); max-width: 75%;">
                        <div style="padding: 0.55rem 0.75rem; border-radius: 12px; background: @(m.IsFromStaff ? "var(--accent-primary, #0B3D91)" : "var(--bg-soft, #F1F5F9)"); color: @(m.IsFromStaff ? "#fff" : "inherit"); white-space: pre-line; font-size: 0.88rem;">@m.Content</div>
                        <div style="font-size: 0.7rem; color: var(--text-muted); text-align: @(m.IsFromStaff ? "right" : "left");">
                            @m.SenderName · @m.SentAt.ToLocalTime().ToString("dd/MM HH:mm")
                            @if (m.IsFromStaff && m.ReadAt.HasValue) { <span> · @Lang.T("admin.messages.read")</span> }
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <p style="color: var(--danger); font-size: 0.8rem; margin: 0.5rem 0 0;">@Error</p>
            }
            <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
                <textarea class="admin-input" rows="2" maxlength="4000" style="flex: 1;" @bind="Reply" @bind:event="oninput" placeholder="@Lang.T("admin.messages.replyPlaceholder")"></textarea>
                <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@(IsSending || string.IsNullOrWhiteSpace(Reply))" @onclick="SendReplyAsync">@Lang.T("admin.messages.send")</button>
            </div>
            <p style="font-size: 0.72rem; color: var(--text-muted); margin: 0.35rem 0 0;">@Lang.T("admin.messages.replyHint")</p>
        }
    </div>
</div>

@code {
    [Parameter] public Guid? ConversationId { get; set; }

    private const int RefreshSeconds = 15;

    private List<AdminConversationDto> Inbox = new();
    private AdminConversationDto? Current;
    private List<AdminMessageDto> Thread = new();
    private bool UnreadOnly;
    private string Search = "";
    private string Reply = "";
    private bool IsSending;
    private string? Error;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await LoadInboxAsync();

        // Via InvokeAsync: el Timer corre fuera del Dispatcher de Blazor (ver bug de 18-Sep).
        _refreshTimer = new System.Threading.Timer(_ => _ = InvokeAsync(RefreshAsync), null,
            TimeSpan.FromSeconds(RefreshSeconds), TimeSpan.FromSeconds(RefreshSeconds));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ConversationId is { } id && Current?.Id != id)
            await LoadConversationAsync(id);
    }

    private async Task LoadInboxAsync() =>
        Inbox = await AuthApi.GetMessageInboxAsync(UnreadOnly, string.IsNullOrWhiteSpace(Search) ? null : Search);

    private async Task LoadConversationAsync(Guid id)
    {
        Error = null;
        Current = await AuthApi.GetConversationAsync(id);
        Thread = Current != null ? await AuthApi.GetConversationMessagesAsync(id) : new();
        if (Current is { UnreadCount: > 0 })
        {
            await AuthApi.MarkConversationReadByStaffAsync(id);
            Current.UnreadCount = 0;
            await LoadInboxAsync();
        }
    }

    private async Task RefreshAsync()
    {
        await LoadInboxAsync();
        if (Current != null)
        {
            Thread = await AuthApi.GetConversationMessagesAsync(Current.Id);
            if (Inbox.FirstOrDefault(c => c.Id == Current.Id) is { UnreadCount: > 0 })
            {
                await AuthApi.MarkConversationReadByStaffAsync(Current.Id);
                await LoadInboxAsync();
            }
        }
        StateHasChanged();
    }

    private void OpenAsync(Guid id) => Nav.NavigateTo($"/messages/{id}");

    private async Task SetUnreadOnly(bool value)
    {
        UnreadOnly = value;
        await LoadInboxAsync();
    }

    private async Task SendReplyAsync()
    {
        if (Current == null || IsSending || string.IsNullOrWhiteSpace(Reply)) return;
        IsSending = true;
        Error = null;
        var (result, error) = await AuthApi.ReplyToConversationAsync(Current.Id, Reply.Trim());
        IsSending = false;
        if (result == null)
        {
            Error = error ?? Lang.T("admin.messages.sendError");
            return;
        }
        Thread.Add(result);
        Reply = "";
        await LoadInboxAsync();
    }

    private void GoToProfile()
    {
        if (Current == null) return;
        if (Current.UserRole == (int)UserRole.Company && Current.CompanyId.HasValue)
            Nav.NavigateTo($"/companies/{Current.CompanyId}");
        else
            Nav.NavigateTo($"/candidates/profile/{Current.UserId}");
    }

    private string RoleLabel(int role) => role == (int)UserRole.Company
        ? Lang.T("admin.messages.roleCompany")
        : Lang.T("admin.messages.roleCandidate");

    private static string FormatTime(DateTime time)
    {
        var diff = DateTime.UtcNow - time;
        return diff.TotalMinutes < 1 ? "ahora"
            : diff.TotalHours < 1 ? $"{(int)diff.TotalMinutes}m"
            : diff.TotalDays < 1 ? $"{(int)diff.TotalHours}h"
            : diff.TotalDays < 7 ? $"{(int)diff.TotalDays}d"
            : time.ToLocalTime().ToString("dd/MM");
    }

    public void Dispose() => _refreshTimer?.Dispose();
}
