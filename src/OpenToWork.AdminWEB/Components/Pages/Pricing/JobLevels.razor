@page "/pricing/job-levels"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.pricing.levelsTitle")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.pricing.levelsTitle")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.pricing.levelsSubtitle")</p>
    </div>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => Nav.NavigateTo("/pricing/job-types")'>@Lang.T("admin.pricing.viewJobTypes")</button>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => Nav.NavigateTo("/pricing/promo-codes")'>@Lang.T("admin.pricing.viewPromoCodes")</button>
    </div>
</div>

@if (Error != null)
{
    <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
}

<EditForm Model="Form" OnValidSubmit="Save" class="admin-inline-form">
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.pricing.name")</label>
        <InputText class="ot-input-field" @bind-Value="Form.Name" placeholder="@Lang.T("admin.pricing.levelNamePlaceholder")" />
    </div>
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.pricing.coverageDays")</label>
        <InputNumber class="ot-input-field" @bind-Value="Form.ReferenceCoverageDays" />
    </div>
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.pricing.warrantyDays")</label>
        <InputNumber class="ot-input-field" @bind-Value="Form.WarrantyDays" />
    </div>
    <div class="ot-input-group">
        <label class="ot-input-label">@Lang.T("admin.pricing.sortOrder")</label>
        <InputNumber class="ot-input-field" @bind-Value="Form.SortOrder" />
    </div>
    <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium">
        @(EditingId == null ? Lang.T("admin.pricing.add") : Lang.T("admin.common.save"))
    </button>
    @if (EditingId != null)
    {
        <button type="button" class="ot-btn ot-btn--outline ot-btn--medium" @onclick="CancelEdit">@Lang.T("admin.common.cancel")</button>
    }
</EditForm>

@if (Levels == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (Levels.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-icon">&#9632;</div>
        <div class="admin-empty-text">@Lang.T("admin.pricing.levelsEmpty")</div>
    </div>
}
else
{
    <table class="ot-table">
        <thead>
            <tr>
                <th>@Lang.T("admin.pricing.name")</th>
                <th>@Lang.T("admin.pricing.coverageDays")</th>
                <th>@Lang.T("admin.pricing.warrantyDays")</th>
                <th>@Lang.T("admin.pricing.jobTypeCount")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var level in Levels)
            {
                <tr>
                    <td>@level.Name</td>
                    <td>@(level.ReferenceCoverageDays?.ToString() ?? "-")</td>
                    <td>@(level.WarrantyDays?.ToString() ?? "-")</td>
                    <td>@level.JobTypeCount</td>
                    <td>
                        <div class="admin-table-actions">
                            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => Edit(level)">@Lang.T("admin.common.edit")</button>
                            <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => Delete(level.Id)">@Lang.T("admin.common.delete")</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<JobLevelDto>? Levels;
    private SaveJobLevelDto Form { get; set; } = new();
    private Guid? EditingId;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await Load();
    }

    private async Task Load()
    {
        Levels = await AuthApi.GetJobLevelsAsync();
    }

    private void Edit(JobLevelDto level)
    {
        EditingId = level.Id;
        Form = new SaveJobLevelDto
        {
            Name = level.Name,
            ReferenceCoverageDays = level.ReferenceCoverageDays,
            WarrantyDays = level.WarrantyDays,
            SortOrder = level.SortOrder,
            IsActive = level.IsActive
        };
    }

    private void CancelEdit()
    {
        EditingId = null;
        Form = new SaveJobLevelDto();
    }

    private async Task Save()
    {
        Error = null;
        if (string.IsNullOrWhiteSpace(Form.Name)) return;

        var (result, error) = EditingId == null
            ? await AuthApi.CreateJobLevelAsync(Form)
            : await AuthApi.UpdateJobLevelAsync(EditingId.Value, Form);

        if (result == null)
        {
            Error = error ?? Lang.T("admin.pricing.saveError");
            return;
        }
        CancelEdit();
        await Load();
    }

    private async Task Delete(Guid id)
    {
        var ok = await AuthApi.DeleteJobLevelAsync(id);
        if (!ok)
        {
            Error = Lang.T("admin.pricing.deleteLevelError");
            return;
        }
        await Load();
    }
}
