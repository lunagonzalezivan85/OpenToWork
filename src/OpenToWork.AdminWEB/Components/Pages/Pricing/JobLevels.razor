@page "/pricing/job-levels"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.pricing.levelsTitle")</PageTitle>

<div class="neu-page-header">
    <div>
        <h1>@Lang.T("admin.pricing.levelsTitle")</h1>
        <p class="neu-page-header-subtitle">@Lang.T("admin.pricing.levelsSubtitle")</p>
    </div>
    <div class="neu-page-actions">
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/job-types")'>@Lang.T("admin.pricing.viewJobTypes")</button>
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/promo-codes")'>@Lang.T("admin.pricing.viewPromoCodes")</button>
    </div>
</div>

@if (Error != null)
{
    <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
}

<EditForm Model="Form" OnValidSubmit="Save" class="neu-surface neu-form">
    <div class="neu-field">
        <label>@Lang.T("admin.pricing.name")</label>
        <InputText class="neu-input" @bind-Value="Form.Name" placeholder="@Lang.T("admin.pricing.levelNamePlaceholder")" />
    </div>
    <div class="neu-field" style="flex: 0 0 180px;">
        <label>@Lang.T("admin.pricing.coverageDays")</label>
        <InputNumber class="neu-input" @bind-Value="Form.ReferenceCoverageDays" />
    </div>
    <div class="neu-field" style="flex: 0 0 180px;">
        <label>@Lang.T("admin.pricing.warrantyDays")</label>
        <InputNumber class="neu-input" @bind-Value="Form.WarrantyDays" />
    </div>
    <div class="neu-field" style="flex: 0 0 110px;">
        <label>@Lang.T("admin.pricing.sortOrder")</label>
        <InputNumber class="neu-input" @bind-Value="Form.SortOrder" />
    </div>
    <button type="submit" class="neu-btn neu-btn--primary">
        @(EditingId == null ? Lang.T("admin.pricing.add") : Lang.T("admin.common.save"))
    </button>
    @if (EditingId != null)
    {
        <button type="button" class="neu-btn" @onclick="CancelEdit">@Lang.T("admin.common.cancel")</button>
    }
</EditForm>

@if (Levels == null)
{
    <div class="neu-surface neu-empty">@Lang.T("admin.common.loading")</div>
}
else if (Levels.Count == 0)
{
    <div class="neu-surface neu-empty">
        <div class="neu-empty-icon">&#9632;</div>
        @Lang.T("admin.pricing.levelsEmpty")
    </div>
}
else
{
    <div class="neu-list">
        @foreach (var level in Levels)
        {
            <div class="neu-row">
                <div class="neu-row-main">
                    <span class="neu-row-title">@level.Name</span>
                    <div class="neu-row-meta">
                        <span>@Lang.T("admin.pricing.coverageDays"): <strong>@(level.ReferenceCoverageDays?.ToString() ?? "-")</strong></span>
                        <span>@Lang.T("admin.pricing.warrantyDays"): <strong>@(level.WarrantyDays?.ToString() ?? "-")</strong></span>
                        <span>@Lang.T("admin.pricing.jobTypeCount"): <strong>@level.JobTypeCount</strong></span>
                    </div>
                </div>
                <div class="neu-row-actions">
                    <button class="neu-btn neu-btn--sm" @onclick="() => Edit(level)">@Lang.T("admin.common.edit")</button>
                    <button class="neu-btn neu-btn--sm neu-btn--danger" @onclick="() => Delete(level.Id)">@Lang.T("admin.common.delete")</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<JobLevelDto>? Levels;
    private SaveJobLevelDto Form { get; set; } = new();
    private Guid? EditingId;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await Load();
    }

    private async Task Load()
    {
        Levels = await AuthApi.GetJobLevelsAsync();
    }

    private void Edit(JobLevelDto level)
    {
        EditingId = level.Id;
        Form = new SaveJobLevelDto
        {
            Name = level.Name,
            ReferenceCoverageDays = level.ReferenceCoverageDays,
            WarrantyDays = level.WarrantyDays,
            SortOrder = level.SortOrder,
            IsActive = level.IsActive
        };
    }

    private void CancelEdit()
    {
        EditingId = null;
        Form = new SaveJobLevelDto();
    }

    private async Task Save()
    {
        Error = null;
        if (string.IsNullOrWhiteSpace(Form.Name)) return;

        var (result, error) = EditingId == null
            ? await AuthApi.CreateJobLevelAsync(Form)
            : await AuthApi.UpdateJobLevelAsync(EditingId.Value, Form);

        if (result == null)
        {
            Error = error ?? Lang.T("admin.pricing.saveError");
            return;
        }
        CancelEdit();
        await Load();
    }

    private async Task Delete(Guid id)
    {
        var ok = await AuthApi.DeleteJobLevelAsync(id);
        if (!ok)
        {
            Error = Lang.T("admin.pricing.deleteLevelError");
            return;
        }
        await Load();
    }
}
