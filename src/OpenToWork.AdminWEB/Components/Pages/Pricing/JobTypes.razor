@page "/pricing/job-types"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.pricing.typesTitle")</PageTitle>

<div class="neu-page-header">
    <div>
        <h1>@Lang.T("admin.pricing.typesTitle")</h1>
        <p class="neu-page-header-subtitle">@Lang.T("admin.pricing.typesSubtitle")</p>
    </div>
    <div class="neu-page-actions">
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/job-levels")'>@Lang.T("admin.pricing.viewJobLevels")</button>
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/promo-codes")'>@Lang.T("admin.pricing.viewPromoCodes")</button>
        <button class="neu-btn neu-btn--sm neu-btn--primary" @onclick="OpenCreateModal">@Lang.T("admin.pricing.newJobType")</button>
    </div>
</div>

@if (Error != null)
{
    <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
}

@if (Types == null)
{
    <div class="neu-surface neu-empty">@Lang.T("admin.common.loading")</div>
}
else if (Types.Count == 0)
{
    <div class="neu-surface neu-empty">
        <div class="neu-empty-icon">&#9632;</div>
        @Lang.T("admin.pricing.typesEmpty")
    </div>
}
else
{
    <div class="neu-list">
        @foreach (var type in Types)
        {
            <div class="neu-row">
                <div class="neu-row-main">
                    <span class="neu-row-title">@type.Name</span>
                    <div class="neu-row-meta">
                        <span class="neu-badge neu-badge--muted">@type.JobLevelName</span>
                        @if (type.CurrentPrice.HasValue)
                        {
                            <span>@Lang.T("admin.pricing.currentPrice"): <strong>@FormatEur(type.CurrentPrice, type.Currency)</strong></span>
                        }
                        else
                        {
                            <span class="neu-badge neu-badge--warning">@Lang.T("admin.pricing.noPrice")</span>
                        }
                    </div>
                </div>
                <div class="neu-row-actions">
                    <button class="neu-btn neu-btn--sm neu-btn--primary" @onclick="() => OpenPriceModal(type)">@Lang.T("admin.pricing.setPrice")</button>
                    <button class="neu-btn neu-btn--sm" @onclick="() => OpenEditModal(type)">@Lang.T("admin.common.edit")</button>
                    <button class="neu-btn neu-btn--sm neu-btn--danger" @onclick="() => Delete(type.Id)">@Lang.T("admin.common.delete")</button>
                </div>
            </div>
        }
    </div>
}

@if (ShowEditModal)
{
    <div class="neu-modal-overlay" @onclick="CloseEditModal">
        <div class="neu-modal" @onclick:stopPropagation="true">
            <h3 class="neu-modal-title">@(EditingId == null ? Lang.T("admin.pricing.newJobType") : Lang.T("admin.common.edit"))</h3>
            @if (ModalError != null)
            {
                <p style="color: var(--danger); font-size: 0.8rem;">@ModalError</p>
            }
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.name")</label>
                <input class="neu-input" type="text" @bind="Form.Name" placeholder="@Lang.T("admin.pricing.typeNamePlaceholder")" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.level")</label>
                <select class="neu-select" @bind="Form.PT_JobLevelId">
                    <option value="">-</option>
                    @foreach (var level in Levels)
                    {
                        <option value="@level.Id">@level.Name</option>
                    }
                </select>
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.sortOrder")</label>
                <input class="neu-input" type="number" @bind="Form.SortOrder" />
            </div>
            <div class="neu-modal-actions">
                <button class="neu-btn" @onclick="CloseEditModal">@Lang.T("admin.common.cancel")</button>
                <button class="neu-btn neu-btn--primary" @onclick="SaveJobType">@Lang.T("admin.common.save")</button>
            </div>
        </div>
    </div>
}

@if (ShowPriceModal && PriceTarget != null)
{
    <div class="neu-modal-overlay" @onclick="ClosePriceModal">
        <div class="neu-modal" @onclick:stopPropagation="true">
            <h3 class="neu-modal-title">@Lang.T("admin.pricing.setPrice") — @PriceTarget.Name</h3>
            @if (ModalError != null)
            {
                <p style="color: var(--danger); font-size: 0.8rem;">@ModalError</p>
            }
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.basePrice")</label>
                <input class="neu-input" type="number" min="0" step="0.01" @bind="PriceForm.BasePrice" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.notes")</label>
                <input class="neu-input" type="text" @bind="PriceForm.Notes" placeholder="@Lang.T("admin.pricing.notesPlaceholder")" />
            </div>

            @if (PriceHistory.Count > 0)
            {
                <p style="font-size: 0.78rem; color: var(--text-muted); margin: 1rem 0 0.5rem;">@Lang.T("admin.pricing.history")</p>
                <div class="neu-price-card" style="gap: 0.5rem;">
                    @foreach (var p in PriceHistory)
                    {
                        <div class="neu-price-row">
                            <span>@p.EffectiveFrom.ToString("yyyy-MM-dd") @(p.EffectiveTo.HasValue ? "→ " + p.EffectiveTo.Value.ToString("yyyy-MM-dd") : $"({Lang.T("admin.pricing.current")})")</span>
                            <strong>@FormatEur(p.BasePrice, p.Currency)</strong>
                        </div>
                    }
                </div>
            }
            <div class="neu-modal-actions">
                <button class="neu-btn" @onclick="ClosePriceModal">@Lang.T("admin.common.cancel")</button>
                <button class="neu-btn neu-btn--primary" @onclick="SavePrice">@Lang.T("admin.common.save")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<JobTypeDto>? Types;
    private List<JobLevelDto> Levels { get; set; } = new();
    private string? Error;
    private string? ModalError;

    private bool ShowEditModal;
    private Guid? EditingId;
    private SaveJobTypeDto Form { get; set; } = new();

    private bool ShowPriceModal;
    private JobTypeDto? PriceTarget;
    private SetJobTypePriceDto PriceForm { get; set; } = new();
    private List<JobTypePriceDto> PriceHistory { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        Levels = await AuthApi.GetJobLevelsAsync();
        await Load();
    }

    private async Task Load()
    {
        Types = await AuthApi.GetJobTypesAsync();
    }

    private void OpenCreateModal()
    {
        EditingId = null;
        Form = new SaveJobTypeDto();
        ModalError = null;
        ShowEditModal = true;
    }

    private void OpenEditModal(JobTypeDto type)
    {
        EditingId = type.Id;
        Form = new SaveJobTypeDto { Name = type.Name, PT_JobLevelId = type.PT_JobLevelId, SortOrder = type.SortOrder, IsActive = type.IsActive };
        ModalError = null;
        ShowEditModal = true;
    }

    private void CloseEditModal() => ShowEditModal = false;

    private async Task SaveJobType()
    {
        ModalError = null;
        if (string.IsNullOrWhiteSpace(Form.Name) || Form.PT_JobLevelId == Guid.Empty)
        {
            ModalError = Lang.T("admin.pricing.jobTypeRequired");
            return;
        }

        var (result, error) = EditingId == null
            ? await AuthApi.CreateJobTypeAsync(Form)
            : await AuthApi.UpdateJobTypeAsync(EditingId.Value, Form);

        if (result == null)
        {
            ModalError = error ?? Lang.T("admin.pricing.saveError");
            return;
        }
        ShowEditModal = false;
        await Load();
    }

    private async Task Delete(Guid id)
    {
        Error = null;
        var ok = await AuthApi.DeleteJobTypeAsync(id);
        if (!ok) Error = Lang.T("admin.pricing.saveError");
        else await Load();
    }

    private async Task OpenPriceModal(JobTypeDto type)
    {
        PriceTarget = type;
        PriceForm = new SetJobTypePriceDto { BasePrice = type.CurrentPrice ?? 0, Currency = type.Currency };
        PriceHistory = await AuthApi.GetPriceHistoryAsync(type.Id);
        ModalError = null;
        ShowPriceModal = true;
    }

    private void ClosePriceModal() => ShowPriceModal = false;

    private async Task SavePrice()
    {
        ModalError = null;
        if (PriceTarget == null) return;
        if (PriceForm.BasePrice < 0)
        {
            ModalError = Lang.T("admin.pricing.priceInvalid");
            return;
        }

        var (result, error) = await AuthApi.SetJobTypePriceAsync(PriceTarget.Id, PriceForm);
        if (result == null)
        {
            ModalError = error ?? Lang.T("admin.pricing.saveError");
            return;
        }
        ShowPriceModal = false;
        await Load();
    }

    private static string FormatEur(decimal? amount, string currency) => amount.HasValue
        ? amount.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-ES")) + " " + currency
        : "-";
}
