@page "/pricing/promo-codes"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.pricing.promoTitle")</PageTitle>

<div class="neu-page-header">
    <div>
        <h1>@Lang.T("admin.pricing.promoTitle")</h1>
        <p class="neu-page-header-subtitle">@Lang.T("admin.pricing.promoSubtitle")</p>
    </div>
    <div class="neu-page-actions">
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/job-levels")'>@Lang.T("admin.pricing.viewJobLevels")</button>
        <button class="neu-btn neu-btn--sm" @onclick='() => Nav.NavigateTo("/pricing/job-types")'>@Lang.T("admin.pricing.viewJobTypes")</button>
        <button class="neu-btn neu-btn--sm neu-btn--primary" @onclick="OpenCreateModal">@Lang.T("admin.pricing.newPromoCode")</button>
    </div>
</div>

@if (Error != null)
{
    <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
}

@if (Codes == null)
{
    <div class="neu-surface neu-empty">@Lang.T("admin.common.loading")</div>
}
else if (Codes.Count == 0)
{
    <div class="neu-surface neu-empty">
        <div class="neu-empty-icon">&#9632;</div>
        @Lang.T("admin.pricing.promoEmpty")
    </div>
}
else
{
    <div class="neu-list">
        @foreach (var promo in Codes)
        {
            <div class="neu-row">
                <div class="neu-row-main">
                    <span class="neu-row-title">@promo.Code@(string.IsNullOrEmpty(promo.Description) ? "" : $" — {promo.Description}")</span>
                    <div class="neu-row-meta">
                        <span class="neu-badge @(promo.DiscountType == (int)PromoDiscountType.Percentage ? "neu-badge--success" : "neu-badge--muted")">
                            @(promo.DiscountType == (int)PromoDiscountType.Percentage ? $"-{promo.DiscountValue:0.##}%" : $"-{FormatEur(promo.DiscountValue)}")
                        </span>
                        <span>@Lang.T("admin.pricing.appliesTo"): <strong>@(promo.JobTypeName ?? promo.JobLevelName ?? Lang.T("admin.pricing.appliesToAll"))</strong></span>
                        <span>@Lang.T("admin.pricing.validity"): <strong>@promo.ValidFrom.ToString("yyyy-MM-dd")@(promo.ValidUntil.HasValue ? " → " + promo.ValidUntil.Value.ToString("yyyy-MM-dd") : "")</strong></span>
                        <span>@Lang.T("admin.pricing.uses"): <strong>@promo.UsesCount@(promo.MaxUses.HasValue ? $" / {promo.MaxUses}" : "")</strong></span>
                        <span class="neu-badge @(promo.IsActive ? "neu-badge--success" : "neu-badge--warning")">
                            @(promo.IsActive ? Lang.T("admin.common.active") : Lang.T("admin.common.inactive"))
                        </span>
                    </div>
                </div>
                <div class="neu-row-actions">
                    <button class="neu-btn neu-btn--sm" @onclick="() => OpenEditModal(promo)">@Lang.T("admin.common.edit")</button>
                    <button class="neu-btn neu-btn--sm neu-btn--danger" @onclick="() => Delete(promo.Id)">@Lang.T("admin.common.delete")</button>
                </div>
            </div>
        }
    </div>
}

@if (ShowModal)
{
    <div class="neu-modal-overlay" @onclick="CloseModal">
        <div class="neu-modal" @onclick:stopPropagation="true">
            <h3 class="neu-modal-title">@(EditingId == null ? Lang.T("admin.pricing.newPromoCode") : Lang.T("admin.common.edit"))</h3>
            @if (ModalError != null)
            {
                <p style="color: var(--danger); font-size: 0.8rem;">@ModalError</p>
            }
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.code")</label>
                <input class="neu-input" type="text" @bind="Form.Code" placeholder="ALEJO26" style="text-transform: uppercase;" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.description")</label>
                <input class="neu-input" type="text" @bind="Form.Description" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.discountType")</label>
                <select class="neu-select" @bind="Form.DiscountType">
                    <option value="0">@Lang.T("admin.pricing.discountPercentage")</option>
                    <option value="1">@Lang.T("admin.pricing.discountFixed")</option>
                </select>
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.discountValue")</label>
                <input class="neu-input" type="number" min="0" step="0.01" @bind="Form.DiscountValue" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.restrictLevel")</label>
                <select class="neu-select" @bind="Form.PT_JobLevelId">
                    <option value="">@Lang.T("admin.pricing.appliesToAll")</option>
                    @foreach (var level in Levels)
                    {
                        <option value="@level.Id">@level.Name</option>
                    }
                </select>
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.restrictType")</label>
                <select class="neu-select" @bind="Form.PT_JobTypeId">
                    <option value="">@Lang.T("admin.pricing.appliesToAll")</option>
                    @foreach (var type in Types.Where(t => Form.PT_JobLevelId == null || t.PT_JobLevelId == Form.PT_JobLevelId))
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </select>
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.validUntil")</label>
                <input class="neu-input" type="date" value="@(Form.ValidUntil?.ToString("yyyy-MM-dd"))" @onchange="e => Form.ValidUntil = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null" />
            </div>
            <div class="neu-field">
                <label>@Lang.T("admin.pricing.maxUses")</label>
                <input class="neu-input" type="number" min="1" step="1" @bind="Form.MaxUses" placeholder="@Lang.T("admin.pricing.maxUsesPlaceholder")" />
            </div>
            <label class="neu-checkbox">
                <input type="checkbox" @bind="Form.IsActive" /> @Lang.T("admin.common.active")
            </label>
            <div class="neu-modal-actions">
                <button class="neu-btn" @onclick="CloseModal">@Lang.T("admin.common.cancel")</button>
                <button class="neu-btn neu-btn--primary" @onclick="Save">@Lang.T("admin.common.save")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<PromoCodeDto>? Codes;
    private List<JobLevelDto> Levels { get; set; } = new();
    private List<JobTypeDto> Types { get; set; } = new();
    private string? Error;
    private string? ModalError;
    private bool ShowModal;
    private Guid? EditingId;
    private SavePromoCodeDto Form { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        Levels = await AuthApi.GetJobLevelsAsync();
        Types = await AuthApi.GetJobTypesAsync();
        await Load();
    }

    private async Task Load()
    {
        Codes = await AuthApi.GetPromoCodesAsync();
    }

    private void OpenCreateModal()
    {
        EditingId = null;
        Form = new SavePromoCodeDto { ValidFrom = DateTime.UtcNow };
        ModalError = null;
        ShowModal = true;
    }

    private void OpenEditModal(PromoCodeDto promo)
    {
        EditingId = promo.Id;
        Form = new SavePromoCodeDto
        {
            Code = promo.Code,
            Description = promo.Description,
            DiscountType = promo.DiscountType,
            DiscountValue = promo.DiscountValue,
            PT_JobLevelId = promo.PT_JobLevelId,
            PT_JobTypeId = promo.PT_JobTypeId,
            ValidFrom = promo.ValidFrom,
            ValidUntil = promo.ValidUntil,
            MaxUses = promo.MaxUses,
            IsActive = promo.IsActive
        };
        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal() => ShowModal = false;

    private async Task Save()
    {
        ModalError = null;
        if (string.IsNullOrWhiteSpace(Form.Code) || Form.DiscountValue <= 0)
        {
            ModalError = Lang.T("admin.pricing.promoRequired");
            return;
        }

        var (result, error) = EditingId == null
            ? await AuthApi.CreatePromoCodeAsync(Form)
            : await AuthApi.UpdatePromoCodeAsync(EditingId.Value, Form);

        if (result == null)
        {
            ModalError = error ?? Lang.T("admin.pricing.saveError");
            return;
        }
        ShowModal = false;
        await Load();
    }

    private async Task Delete(Guid id)
    {
        Error = null;
        var ok = await AuthApi.DeletePromoCodeAsync(id);
        if (!ok) Error = Lang.T("admin.pricing.saveError");
        else await Load();
    }

    private static string FormatEur(decimal amount) => amount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-ES")) + " €";
}
