@page "/vacancies/{VacancyId:guid}/contract"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.contract.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.contract.title")</h1>
        <p class="admin-page-header-subtitle">
            @(Contract?.ContractNumber ?? Vacancy?.Title ?? "")
        </p>
    </div>
    <div class="admin-page-actions">
        @if (Contract != null)
        {
            var badge = GetStatusBadgeInfo(Contract.Status);
            <span class="admin-status @badge.CssClass">@Lang.T(badge.Label)</span>
            <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="GoToDocument">@Lang.T("admin.contract.viewDocument")</button>
        }
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoBack">@Lang.T("admin.contract.backToVacancy")</button>
    </div>
</div>

@if (IsLoading)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (Vacancy == null)
{
    <div class="admin-empty"><div class="admin-empty-text">@Lang.T("admin.vacancies.notFound")</div></div>
}
else if (IsEditing)
{
    @* === Formulario (sin contrato o borrador) === *@
    @if (FormError != null)
    {
        <p style="color: var(--danger); font-size: 0.85rem;">@FormError</p>
    }
    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.scopeTitle")</h3>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 1rem 0;">@Lang.T("admin.contract.scopeServicesHint")</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.5rem; margin-bottom: 1.25rem;">
            @foreach (var svc in ScopeServiceCodes)
            {
                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; cursor: pointer;">
                    <input type="checkbox" checked="@FormScope.Contains(svc.Code)" @onchange="e => ToggleScope(svc.Code, (bool)(e.Value ?? false))" />
                    @Lang.T(svc.Key)
                </label>
            }
        </div>
        <div class="admin-recruitment-grid">
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.targetCandidates")</label>
                <input type="number" min="1" step="1" @bind="FormTargetCandidates" class="admin-modal-input" />
            </div>
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.jobType")</label>
                <select value="@FormJobType.ToString()" @onchange="OnJobTypeChanged" class="admin-modal-input">
                    <option value="0">@Lang.T("admin.contract.jobTypeOperational")</option>
                    <option value="1">@Lang.T("admin.contract.jobTypeSupervisors")</option>
                    <option value="2">@Lang.T("admin.contract.jobTypeBusiness")</option>
                    <option value="3">@Lang.T("admin.contract.jobTypeQualified")</option>
                </select>
            </div>
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.targetCoverage")</label>
                <input type="number" min="1" step="1" @bind="FormCoverageDays" class="admin-modal-input" />
            </div>
        </div>
        <p style="font-size: 0.75rem; color: var(--text-muted);">@Lang.T("admin.contract.coverageRefHint")</p>
    </div>

    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.warrantyTitle")</h3>
        @foreach (var line in VacancyLines)
        {
            <div style="@(VacancyLines.Count > 1 ? "border: 1px solid var(--card-border); border-radius: 12px; padding: 1rem; margin-bottom: 1rem;" : "")">
                @if (VacancyLines.Count > 1)
                {
                    <p style="font-weight: 600; margin: 0 0 0.5rem 0;">@line.Title</p>
                }
                <div class="ot-input-group" style="max-width: 320px;">
                    <label class="ot-input-label">@Lang.T("admin.contract.warrantyDays")</label>
                    <input type="number" min="0" step="1" @bind="line.FormWarrantyDays" class="admin-modal-input" />
                </div>
                @if (line.JobLevelWarrantyDays.HasValue)
                {
                    <p style="font-size: 0.75rem; color: var(--text-muted); margin: 0.25rem 0 0 0;">@Lang.T("admin.contract.warrantyReferenceHint") @line.JobLevelWarrantyDays @Lang.T("admin.contract.warrantyReferenceDays") (@line.JobLevelName)</p>
                }
            </div>
        }
    </div>

    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.economicsTitle")</h3>
        @if (VacancyLines.Count > 1)
        {
            <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 1rem 0;">@VacancyLines.Count @Lang.T("admin.contract.multiVacancyHint")</p>
        }

        @foreach (var line in VacancyLines)
        {
            <div style="@(VacancyLines.Count > 1 ? "border: 1px solid var(--card-border); border-radius: 12px; padding: 1rem; margin-bottom: 1rem;" : "")">
                @if (VacancyLines.Count > 1)
                {
                    <p style="font-weight: 600; margin: 0 0 0.5rem 0;">@line.Title</p>
                }

                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.jobTypeVacancy")</span>
                    <strong>@(line.JobTypeName ?? Lang.T("admin.contract.jobTypeUnmapped")) @(line.JobLevelName != null ? $"({line.JobLevelName})" : "")</strong>
                </div>

                @if (!line.ManualOverride)
                {
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.listPrice")</span>
                        <strong>@(line.ListPrice.HasValue ? FormatEur(line.ListPrice) : Lang.T("admin.contract.noListPrice"))</strong>
                    </div>

                    <div class="admin-recruitment-grid" style="margin-top: 0.5rem; align-items: end;">
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.contract.promoCode")</label>
                            <input type="text" @bind="line.PromoCodeInput" class="admin-modal-input" placeholder="ALEJO26" />
                        </div>
                        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ApplyPromoCodeAsync(line)" disabled="@line.IsValidatingPromo">@Lang.T("admin.contract.applyPromo")</button>
                    </div>
                    @if (line.PromoError != null)
                    {
                        <p style="color: var(--danger); font-size: 0.8rem;">@line.PromoError</p>
                    }
                    @if (line.AppliedPromo != null)
                    {
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.discount")</span>
                            <strong style="color: var(--success);">-@FormatEur(line.AppliedPromo.DiscountAmount) (@line.AppliedPromo.Code)</strong>
                        </div>
                        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.finalPrice")</span>
                            <strong>@FormatEur(line.AppliedPromo.FinalAmount)</strong>
                        </div>
                    }
                }
                else
                {
                    <div class="admin-recruitment-grid">
                        <div class="ot-input-group">
                            <label class="ot-input-label">@Lang.T("admin.contract.manualPrice")</label>
                            <input type="number" min="0" step="0.01" @bind="line.FormManualPrice" class="admin-modal-input" />
                        </div>
                    </div>
                    <div class="ot-input-group" style="margin-top: 0.5rem;">
                        <label class="ot-input-label">@Lang.T("admin.contract.overrideReason")</label>
                        <input type="text" @bind="line.FormOverrideReason" class="admin-modal-input" placeholder="@Lang.T("admin.contract.overrideReasonPlaceholder")" />
                    </div>
                }
                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; margin-top: 0.75rem; cursor: pointer;">
                    <input type="checkbox" checked="@line.ManualOverride" @onchange="e => OnManualOverrideChanged(line, (bool)(e.Value ?? false))" />
                    @Lang.T("admin.contract.manualOverrideToggle")
                </label>
            </div>
        }

        <div class="admin-recruitment-info-row" style="border-top: 1px solid var(--card-border); padding-top: 0.6rem; margin-top: 0.25rem;">
            <span>@Lang.T("admin.contract.feeAmount")</span>
            <strong>@FormatEur(TotalFeeAmount)</strong>
        </div>

        <div class="admin-recruitment-grid" style="margin-top: 1rem;">
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.feeApplication")</label>
                <select @bind="FormFeeApplicationType" class="admin-modal-input">
                    <option value="0">@Lang.T("admin.contract.feePerPosition")</option>
                    <option value="1">@Lang.T("admin.contract.feePerProcess")</option>
                    <option value="2">@Lang.T("admin.contract.feeGlobalPrice")</option>
                </select>
            </div>
        </div>
        <div class="admin-recruitment-grid" style="margin-top: 0.5rem;">
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.paymentOpening") (%)</label>
                <input type="number" min="0" max="100" step="0.01" @bind="FormOpeningPct" class="admin-modal-input" />
            </div>
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.paymentValidation") (%)</label>
                <input type="number" min="0" max="100" step="0.01" @bind="FormValidationPct" class="admin-modal-input" />
            </div>
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.paymentConsolidation") (%)</label>
                <input type="number" min="0" step="0.01" @bind="FormConsolidationPct" class="admin-modal-input" />
            </div>
        </div>
        @if (FormPaymentSumError)
        {
            <p style="color: var(--danger); font-size: 0.8rem;">@Lang.T("admin.contract.paymentSumError")</p>
        }
        <div class="ot-input-group" style="margin-top: 0.75rem;">
            <label class="ot-input-label">@Lang.T("admin.contract.feeExceptions")</label>
            <textarea @bind="FormFeeExceptions" class="admin-modal-input" rows="2" placeholder="@Lang.T("admin.contract.feeExceptionsPlaceholder")"></textarea>
        </div>
    </div>

    <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="SaveContractAsync" disabled="@IsSaving">
            @(Contract == null ? Lang.T("admin.contract.generate") : Lang.T("admin.common.save"))
        </button>
        @if (Contract != null && Contract.Status == (int)ContractStatus.Draft)
        {
            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="SendContractAsync" disabled="@IsSaving">
                @Lang.T("admin.contract.send")
            </button>
        }
    </div>
}
else if (Contract != null)
{
    @* === Vista documento (Sent/Accepted/Rejected/Cancelled) === *@
    @if (Contract.Status == (int)ContractStatus.Rejected && !string.IsNullOrEmpty(Contract.RejectionReason))
    {
        <div class="admin-recruitment-card" style="margin-top: 1.5rem; border-left: 4px solid var(--danger);">
            <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.rejectReason")</h3>
            <p style="margin: 0; font-size: 0.9rem;">@Contract.RejectionReason</p>
        </div>
    }
    @if (Contract.Status == (int)ContractStatus.Accepted)
    {
        <p style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.75rem;">@Lang.T("admin.contract.readOnlyHint")</p>
    }

    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.scopeTitle")</h3>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.scopeServices")</span><strong>@GetScopeText()</strong></div>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.targetCandidates")</span><strong>@(Contract.TargetCandidates?.ToString() ?? "-")</strong></div>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.targetCoverage")</span><strong>@(Contract.TargetCoverageDays?.ToString() ?? "-") @Lang.T("admin.contract.businessDays")</strong></div>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.jobType")</span><strong>@GetJobTypeLabel(Contract.JobTypeCategory)</strong></div>
    </div>

    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.warrantyTitle")</h3>
        @foreach (var line in Contract.Vacancies)
        {
            @if (Contract.Vacancies.Count > 1)
            {
                <div class="admin-recruitment-info-row"><span style="font-weight: 600;">@line.Title</span><span></span></div>
            }
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.warrantyDays")</span><strong>@(line.WarrantyDays?.ToString() ?? "-")</strong></div>
        }
    </div>

    <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
        <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.economicsTitle")</h3>
        @foreach (var line in Contract.Vacancies)
        {
            @if (Contract.Vacancies.Count > 1)
            {
                <div class="admin-recruitment-info-row"><span style="font-weight: 600;">@line.Title</span><span></span></div>
            }
            @if (!line.IsManualOverride)
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.listPrice")</span><strong>@FormatEur(line.BasePrice)</strong></div>
                @if (!string.IsNullOrEmpty(line.PromoCode))
                {
                    <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.discount")</span><strong style="color: var(--success);">-@FormatEur(line.DiscountAmount) (@line.PromoCode)</strong></div>
                }
            }
            else
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.manualPrice")</span><strong>@FormatEur(line.BasePrice)</strong></div>
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.overrideReason")</span><strong>@line.OverrideReason</strong></div>
            }
        }
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.feeAmount")</span><strong>@FormatEur(Contract.FeeAmount)</strong></div>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.feeApplication")</span><strong>@GetFeeApplicationLabel(Contract.FeeApplicationType)</strong></div>
        <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.paymentDistribution")</span><strong>@FormatPct(Contract.PaymentOpeningPct) @Lang.T("admin.contract.paymentOpening") / @FormatPct(Contract.PaymentValidationPct) @Lang.T("admin.contract.paymentValidation") / @FormatPct(Contract.PaymentConsolidationPct) @Lang.T("admin.contract.paymentConsolidation")</strong></div>
        @if (!string.IsNullOrWhiteSpace(Contract.FeeExceptions))
        {
            <div class="admin-recruitment-info-row" style="flex-direction: column; align-items: flex-start; gap: 0.3rem;">
                <span>@Lang.T("admin.contract.feeExceptions")</span>
                <strong style="white-space: pre-line; font-weight: 400;">@Contract.FeeExceptions</strong>
            </div>
        }
 @if (Contract.AcceptedAt.HasValue)
        {
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.acceptedAt")</span><strong>@Contract.AcceptedAt.Value.ToString("yyyy-MM-dd")</strong></div>
        }
        @if (Contract.RejectedAt.HasValue)
        {
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.contract.rejectedAt")</span><strong>@Contract.RejectedAt.Value.ToString("yyyy-MM-dd")</strong></div>
        }
    </div>

    @if (Contract.Status == (int)ContractStatus.Accepted)
    {
        <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
            <h3 class="admin-recruitment-card-title">@Lang.T("admin.contract.tranchesTitle")</h3>
            @if (Tranches.Count == 0)
            {
                <p style="color: var(--text-muted); font-size: 0.85rem;">@Lang.T("admin.contract.tranchesEmpty")</p>
            }
            else
            {
                @foreach (var tranche in Tranches)
                {
                    <div class="admin-recruitment-info-row" style="align-items: flex-start;">
                        <div>
                            <span>@GetTrancheLabel(tranche.TrancheType) (@FormatPct(tranche.Percentage))</span>
                            @if (tranche.Status == (int)PaymentTrancheStatus.Pagado)
                            {
                                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.2rem;">
                                    @Lang.T("admin.contract.paidOn") @tranche.PaidAt?.ToString("yyyy-MM-dd") @Lang.T("admin.contract.paidByPrefix") @tranche.PaidByName
                                    @if (!string.IsNullOrWhiteSpace(tranche.Notes))
                                    {
                                        <div style="font-style: italic;">"@tranche.Notes"</div>
                                    }
                                </div>
                            }
                        </div>
                        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem;">
                            <strong>@FormatEur(tranche.Amount)</strong>
                            @if (tranche.Status == (int)PaymentTrancheStatus.Pagado)
                            {
                                <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.contract.tranchePaid")</span>
                            }
                            else if (MarkingPaidTrancheId == tranche.Id)
                            {
                                <div style="display: flex; gap: 0.3rem; align-items: center;">
                                    <input type="text" @bind="MarkPaidNotes" placeholder="@Lang.T("admin.contract.trancheNotesPlaceholder")" class="ot-input-field" style="font-size: 0.75rem; padding: 0.3rem 0.5rem; width: 160px;" />
                                    <button class="ot-btn ot-btn--primary ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick="() => ConfirmMarkPaidAsync(tranche.Id)">@Lang.T("admin.common.confirm")</button>
                                    <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => MarkingPaidTrancheId = null'>@Lang.T("admin.common.cancel")</button>
                                </div>
                            }
                            else
                            {
                                <span class="admin-result-badge admin-result-badge--warning">@Lang.T("admin.contract.tranchePending")</span>
                                <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => { MarkingPaidTrancheId = tranche.Id; MarkPaidNotes = null; }'>@Lang.T("admin.contract.markAsPaid")</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
            <h3 class="admin-recruitment-card-title">@Lang.T("admin.warrantyReplacement.panelTitle")</h3>
            @if (WarrantyReplacements.Count == 0)
            {
                <p style="color: var(--text-muted); font-size: 0.85rem;">@Lang.T("admin.warrantyReplacement.panelEmpty")</p>
            }
            else
            {
                @foreach (var wr in WarrantyReplacements)
                {
                    <div class="admin-recruitment-info-row" style="align-items: flex-start; flex-direction: column; gap: 0.4rem;">
                        <div style="display:flex; justify-content:space-between; width:100%; align-items:flex-start;">
                            <div>
                                <strong>@wr.VacancyTitle</strong>
                                <div style="font-size:0.8rem; color:var(--text-muted);">@GetReplacementReasonLabel(wr.Reason)</div>
                                @if (wr.IsExclusion)
                                {
                                    <span class="admin-result-badge admin-result-badge--danger" style="margin-top:0.2rem; display:inline-block;">@Lang.T("admin.warrantyReplacement.exclusionWarning")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(wr.Notes))
                                {
                                    <div style="font-size:0.75rem; font-style:italic; color:var(--text-muted); margin-top:0.2rem;">"@wr.Notes"</div>
                                }
                            </div>
                            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.3rem;">
                                @if (wr.ReplacementNumber > 0)
                                {
                                    <span class="admin-result-badge admin-result-badge--info">@(wr.ReplacementNumber == 1 ? Lang.T("admin.warrantyReplacement.replacementFirst") : Lang.T("admin.warrantyReplacement.replacementSecond"))</span>
                                }
                                <span class="admin-result-badge @GetReplacementStatusBadgeClass(wr.Status)">@GetReplacementStatusLabel(wr.Status)</span>
                            </div>
                        </div>
                        <div style="font-size:0.78rem; color:var(--text-muted);">
                            @Lang.T("admin.warrantyReplacement.requestedBy") @wr.RequestedByName · @wr.RequestedAt.ToString("dd/MM/yyyy")
                            @if (!string.IsNullOrWhiteSpace(wr.OriginalCandidateName))
                            {
                                <text> · @Lang.T("admin.warrantyReplacement.originalCandidate"): @wr.OriginalCandidateName</text>
                            }
                        </div>
                        @if (wr.ChargeAmount.HasValue)
                        {
                            <div style="font-size:0.78rem;">
                                <strong>@FormatEur(wr.ChargeAmount.Value)</strong>
                                <span class="admin-result-badge @(wr.ChargeStatus == (int)PaymentTrancheStatus.Pagado ? "admin-result-badge--success" : "admin-result-badge--warning")" style="margin-left:0.3rem;">
                                    @(wr.ChargeStatus == (int)PaymentTrancheStatus.Pagado ? Lang.T("admin.contract.tranchePaid") : Lang.T("admin.contract.tranchePending"))
                                </span>
                            </div>
                        }
                        @if (wr.Status == (int)WarrantyReplacementStatus.Completada && !string.IsNullOrWhiteSpace(wr.ReplacementCandidateName))
                        {
                            <div style="font-size:0.78rem; color:var(--text-muted);">@Lang.T("admin.warrantyReplacement.replacementCandidate"): @wr.ReplacementCandidateName</div>
                        }
                        @if (wr.Status == (int)WarrantyReplacementStatus.EnCurso)
                        {
                            @if (LinkingReplacementId == wr.Id)
                            {
                                <div style="display:flex; gap:0.4rem; align-items:center; width:100%; flex-wrap:wrap;">
                                    <select class="admin-select" @bind="LinkSelection">
                                        <option value="">@Lang.T("admin.warrantyReplacement.linkPlaceholder")</option>
                                        @if (LinkCandidates != null)
                                        {
                                            @foreach (var n in LinkCandidates.Negotiations.Where(x => x.Status == (int)NegotiationStatus.Cerrada && x.Id != wr.OriginalNegotiationId))
                                            {
                                                <option value="n:@n.Id">@(n.Candidates.FirstOrDefault(c => c.ApplicationId == n.WinningApplicationId)?.CandidateName ?? n.Id.ToString())</option>
                                            }
                                            @foreach (var d in LinkCandidates.Deliveries.Where(x => x.Id != wr.OriginalDeliveryId))
                                            {
                                                <option value="d:@d.Id">@d.CandidateName</option>
                                            }
                                        }
                                    </select>
                                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="() => ConfirmLinkAsync(wr.Id)">@Lang.T("admin.warrantyReplacement.link")</button>
                                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => LinkingReplacementId = null">@Lang.T("admin.common.cancel")</button>
                                </div>
                            }
                            else
                            {
                                <div style="display:flex; gap:0.4rem;">
                                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => StartLinkAsync(wr)">@Lang.T("admin.warrantyReplacement.link")</button>
                                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ConfirmCancelReplacementAsync(wr.Id)">@Lang.T("admin.warrantyReplacement.cancel")</button>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </div>
    }

        @if (Contract.Status == (int)ContractStatus.Sent)
        {
            <div style="display: flex; gap: 0.5rem; margin-top: 1.5rem;">
                <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="() => DecideAsync(true)">@Lang.T("admin.contract.accept")</button>
                <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => ShowRejectReason = true">@Lang.T("admin.contract.reject")</button>
            </div>
        }
    @if (ShowRejectReason)
    {
        <div class="admin-recruitment-card" style="margin-top: 1rem; border-left: 4px solid var(--danger);">
            <div class="ot-input-group">
                <label class="ot-input-label">@Lang.T("admin.contract.rejectReason") *</label>
                <textarea @bind="RejectReasonInput" class="admin-modal-input" rows="2"></textarea>
            </div>
            @if (RejectError)
            {
                <p style="color: var(--danger); font-size: 0.8rem;">@Lang.T("admin.contract.rejectReasonRequired")</p>
            }
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="ConfirmRejectAsync">@Lang.T("admin.contract.reject")</button>
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ShowRejectReason = false">@Lang.T("admin.common.cancel")</button>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid VacancyId { get; set; }

    private VacancyDto? Vacancy;
    private AdminVacancyContractDto? Contract;
    private bool IsLoading { get; set; } = true;

    // Modo edicion: sin contrato, o contrato en Draft (o Rejected que se reabre al guardar).
    private bool IsEditing => Contract == null || Contract.Status == (int)ContractStatus.Draft;

    // Formulario
    private HashSet<string> FormScope { get; set; } = new();
    private int? FormTargetCandidates { get; set; }
    private int FormJobType { get; set; }
    private int? FormCoverageDays { get; set; }
    private int FormFeeApplicationType { get; set; }
    private decimal FormOpeningPct { get; set; } = 30m;
    private decimal FormValidationPct { get; set; } = 50m;
    private decimal FormConsolidationPct { get; set; } = 20m;
    private string? FormFeeExceptions { get; set; }
    private string? FormError { get; set; }
    private bool FormPaymentSumError { get; set; }
    private bool IsSaving { get; set; }

    // Precio por vacante: el contrato puede cubrir mas de una (lista + promo, o manual, por linea).
    private class VacancyLineForm
    {
        public Guid VacancyId { get; set; }
        public string Title { get; set; } = string.Empty;
        public string? JobTypeName { get; set; }
        public string? JobLevelName { get; set; }
        public decimal? ListPrice { get; set; }
        public string PromoCodeInput { get; set; } = string.Empty;
        public string? PromoError { get; set; }
        public PromoValidationResultDto? AppliedPromo { get; set; }
        public bool IsValidatingPromo { get; set; }
        public bool ManualOverride { get; set; }
        public decimal? FormManualPrice { get; set; }
        public string? FormOverrideReason { get; set; }

        // Garantia de esta vacante especifica (no del contrato).
        public int? FormWarrantyDays { get; set; }
        public int? JobLevelWarrantyDays { get; set; }
    }

    private List<VacancyLineForm> VacancyLines { get; set; } = new();

    private decimal TotalFeeAmount => VacancyLines.Sum(l => l.ManualOverride
        ? l.FormManualPrice ?? 0
        : l.AppliedPromo?.FinalAmount ?? l.ListPrice ?? 0);

    // Decision
    private bool ShowRejectReason { get; set; }
    private string? RejectReasonInput { get; set; }
    private bool RejectError { get; set; }

    // Tramos de pago
    private List<ContractPaymentDto> Tranches { get; set; } = new();
    private Guid? MarkingPaidTrancheId { get; set; }
    private string? MarkPaidNotes { get; set; }

    // Garantias de reposicion (paso 20)
    private List<WarrantyReplacementDto> WarrantyReplacements { get; set; } = new();
    private Guid? LinkingReplacementId { get; set; }
    private string LinkSelection { get; set; } = "";
    private WarrantyReplacementCandidatesDto? LinkCandidates { get; set; }

    private static readonly (string Code, string Key)[] ScopeCatalog =
    {
        ("publicacion", "admin.contract.scopePublicacion"),
        ("busqueda", "admin.contract.scopeBusqueda"),
        ("screening", "admin.contract.scopeScreening"),
        ("entrevista", "admin.contract.scopeEntrevista"),
        ("evaluacion", "admin.contract.scopeEvaluacion"),
        ("referencias", "admin.contract.scopeReferencias"),
        ("shortlist", "admin.contract.scopeShortlist"),
        ("briefing", "admin.contract.scopeBriefing"),
        ("seguimiento", "admin.contract.scopeSeguimiento")
    };

    private static IEnumerable<(string Code, string Key)> ScopeServiceCodes => ScopeCatalog;

    private List<JobTypeDto> _jobTypes = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        Vacancy = await AuthApi.GetVacancyDetailAsync(VacancyId);
        if (Vacancy != null)
        {
            Contract = await AuthApi.GetContractByCompanyAsync(Vacancy.CompanyId);
            _jobTypes = await AuthApi.GetJobTypesAsync();
            BuildVacancyLines();
        }
        LoadForm();
        await LoadTranchesAsync();
        await LoadWarrantyReplacementsAsync();
        IsLoading = false;
    }

    private async Task LoadTranchesAsync()
    {
        if (Contract != null && Contract.Status == (int)ContractStatus.Accepted)
            Tranches = await AuthApi.GetContractPaymentsAsync(Contract.Id);
        else
            Tranches = new();
    }

    private string GetTrancheLabel(int trancheType) => (PaymentTrancheType)trancheType switch
    {
        PaymentTrancheType.Apertura => Lang.T("admin.contract.paymentOpening"),
        PaymentTrancheType.Validacion => Lang.T("admin.contract.paymentValidation"),
        PaymentTrancheType.Consolidacion => Lang.T("admin.contract.paymentConsolidation"),
        PaymentTrancheType.ReposicionSegunda => Lang.T("admin.contract.paymentReplacement"),
        _ => "-"
    };

    private async Task LoadWarrantyReplacementsAsync()
    {
        if (Contract != null && Contract.Status == (int)ContractStatus.Accepted)
            WarrantyReplacements = await AuthApi.GetWarrantyReplacementsByContractAsync(Contract.Id);
        else
            WarrantyReplacements = new();
    }

    private async Task StartLinkAsync(WarrantyReplacementDto wr)
    {
        LinkingReplacementId = wr.Id;
        LinkSelection = "";
        LinkCandidates = await AuthApi.GetWarrantyReplacementCandidatesAsync(wr.VacancyId);
    }

    private async Task ConfirmLinkAsync(Guid replacementId)
    {
        if (string.IsNullOrEmpty(LinkSelection)) return;
        var parts = LinkSelection.Split(':', 2);
        if (parts.Length != 2 || !Guid.TryParse(parts[1], out var id)) return;

        var dto = new LinkWarrantyReplacementDto();
        if (parts[0] == "n") dto.NegotiationId = id; else dto.DeliveryId = id;

        var (result, _) = await AuthApi.LinkWarrantyReplacementAsync(replacementId, dto);
        if (result != null)
        {
            LinkingReplacementId = null;
            await LoadWarrantyReplacementsAsync();
        }
    }

    private async Task ConfirmCancelReplacementAsync(Guid replacementId)
    {
        var (result, _) = await AuthApi.CancelWarrantyReplacementAsync(replacementId);
        if (result != null)
            await LoadWarrantyReplacementsAsync();
    }

    private string GetReplacementReasonLabel(int reason) => (WarrantyReplacementReason)reason switch
    {
        WarrantyReplacementReason.BajoDesempeno => Lang.T("admin.warrantyReplacement.reasonBajoDesempeno"),
        WarrantyReplacementReason.ProblemasAsistencia => Lang.T("admin.warrantyReplacement.reasonProblemasAsistencia"),
        WarrantyReplacementReason.FaltaGraveORobo => Lang.T("admin.warrantyReplacement.reasonFaltaGraveORobo"),
        WarrantyReplacementReason.BajaMedica => Lang.T("admin.warrantyReplacement.reasonBajaMedica"),
        WarrantyReplacementReason.RenunciaVoluntaria => Lang.T("admin.warrantyReplacement.reasonRenunciaVoluntaria"),
        WarrantyReplacementReason.Otro => Lang.T("admin.warrantyReplacement.reasonOtro"),
        WarrantyReplacementReason.ImpagoDeNomina => Lang.T("admin.warrantyReplacement.reasonImpagoDeNomina"),
        WarrantyReplacementReason.CambioSustancialDeCondiciones => Lang.T("admin.warrantyReplacement.reasonCambioSustancialDeCondiciones"),
        WarrantyReplacementReason.CierreDelNegocio => Lang.T("admin.warrantyReplacement.reasonCierreDelNegocio"),
        WarrantyReplacementReason.IncumplimientoNormativo => Lang.T("admin.warrantyReplacement.reasonIncumplimientoNormativo"),
        _ => reason.ToString()
    };

    private string GetReplacementStatusLabel(int status) => (WarrantyReplacementStatus)status switch
    {
        WarrantyReplacementStatus.EnCurso => Lang.T("admin.warrantyReplacement.statusEnCurso"),
        WarrantyReplacementStatus.Completada => Lang.T("admin.warrantyReplacement.statusCompletada"),
        WarrantyReplacementStatus.Cancelada => Lang.T("admin.warrantyReplacement.statusCancelada"),
        WarrantyReplacementStatus.ExcluidaDeGarantia => Lang.T("admin.warrantyReplacement.statusExcluida"),
        _ => status.ToString()
    };

    private string GetReplacementStatusBadgeClass(int status) => (WarrantyReplacementStatus)status switch
    {
        WarrantyReplacementStatus.EnCurso => "admin-result-badge--warning",
        WarrantyReplacementStatus.Completada => "admin-result-badge--success",
        WarrantyReplacementStatus.Cancelada => "admin-result-badge--muted",
        WarrantyReplacementStatus.ExcluidaDeGarantia => "admin-result-badge--danger",
        _ => "admin-result-badge--muted"
    };

    private async Task ConfirmMarkPaidAsync(Guid trancheId)
    {
        if (await AuthApi.MarkTranchePaidAsync(trancheId, MarkPaidNotes))
        {
            MarkingPaidTrancheId = null;
            MarkPaidNotes = null;
            await LoadTranchesAsync();
        }
    }

    private void BuildVacancyLines()
    {
        if (Contract != null)
        {
            // El contrato ya existe: puede cubrir mas de una vacante de la empresa (no solo
            // la de esta URL) - hay que mostrarlas y guardarlas todas, o un "Guardar" desde
            // aca borraria silenciosamente las que no viajen en el DTO (ver AdminContractService.SaveAsync).
            VacancyLines = Contract.Vacancies.Select(cv => new VacancyLineForm
            {
                VacancyId = cv.VacancyId,
                Title = cv.Title,
                JobTypeName = cv.JobTypeName,
                JobLevelName = cv.JobLevelName,
                ListPrice = _jobTypes.FirstOrDefault(t => t.Id == cv.JobTypeId)?.CurrentPrice,
                ManualOverride = cv.IsManualOverride,
                FormManualPrice = cv.IsManualOverride && cv.FinalPrice.HasValue ? Math.Round(cv.FinalPrice.Value, 2) : null,
                FormOverrideReason = cv.OverrideReason,
                PromoCodeInput = !cv.IsManualOverride && !string.IsNullOrEmpty(cv.PromoCode) ? cv.PromoCode : "",
                AppliedPromo = !cv.IsManualOverride && !string.IsNullOrEmpty(cv.PromoCode)
                    ? new PromoValidationResultDto { IsValid = true, Code = cv.PromoCode, DiscountAmount = cv.DiscountAmount, FinalAmount = cv.FinalPrice ?? 0 }
                    : null,
                FormWarrantyDays = cv.WarrantyDays,
                JobLevelWarrantyDays = _jobTypes.FirstOrDefault(t => t.Id == cv.JobTypeId)?.LevelWarrantyDays
            }).ToList();
        }
        else if (Vacancy != null)
        {
            var jobType = Vacancy.JobTypeId.HasValue ? _jobTypes.FirstOrDefault(t => t.Id == Vacancy.JobTypeId.Value) : null;
            VacancyLines = new List<VacancyLineForm>
            {
                new()
                {
                    VacancyId = VacancyId,
                    Title = Vacancy.Title,
                    JobTypeName = Vacancy.JobTypeName,
                    JobLevelName = Vacancy.JobLevelName,
                    ListPrice = jobType?.CurrentPrice,
                    FormWarrantyDays = jobType?.LevelWarrantyDays,
                    JobLevelWarrantyDays = jobType?.LevelWarrantyDays
                }
            };
        }
    }

    private void LoadForm()
    {
        if (Contract == null)
        {
            FormTargetCandidates = Vacancy?.RequiredApplicants;
            FormCoverageDays = ReferenceDays(FormJobType);
            return;
        }

        FormScope = new HashSet<string>(Contract.ScopeServices);
        FormTargetCandidates = Contract.TargetCandidates;
        FormJobType = Contract.JobTypeCategory;
        FormCoverageDays = Contract.TargetCoverageDays;
        FormFeeApplicationType = Contract.FeeApplicationType;
        FormOpeningPct = Math.Round(Contract.PaymentOpeningPct, 2);
        FormValidationPct = Math.Round(Contract.PaymentValidationPct, 2);
        FormConsolidationPct = Math.Round(Contract.PaymentConsolidationPct, 2);
        FormFeeExceptions = Contract.FeeExceptions;
    }

    private void OnManualOverrideChanged(VacancyLineForm line, bool value)
    {
        line.ManualOverride = value;
        if (value) line.FormManualPrice ??= line.ListPrice ?? line.AppliedPromo?.FinalAmount;
    }

    private async Task ApplyPromoCodeAsync(VacancyLineForm line)
    {
        line.PromoError = null;
        line.AppliedPromo = null;
        if (string.IsNullOrWhiteSpace(line.PromoCodeInput)) return;

        line.IsValidatingPromo = true;
        var result = await AuthApi.ValidatePromoCodeAsync(line.PromoCodeInput.Trim(), line.VacancyId);
        line.IsValidatingPromo = false;

        if (result == null || !result.IsValid)
            line.PromoError = result?.ErrorMessage ?? Lang.T("admin.contract.promoValidateError");
        else
            line.AppliedPromo = result;
    }

    private void ToggleScope(string code, bool selected)
    {
        if (selected) FormScope.Add(code);
        else FormScope.Remove(code);
    }

    private void OnJobTypeChanged(ChangeEventArgs e)
    {
        FormJobType = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        FormCoverageDays = ReferenceDays(FormJobType);
    }

    private static int ReferenceDays(int jobType) => jobType switch
    {
        (int)ContractJobType.Operational => 10,
        (int)ContractJobType.SupervisorsTechnicians => 15,
        (int)ContractJobType.BusinessManagers => 20,
        (int)ContractJobType.QualifiedProfiles => 30,
        _ => 15
    };

    private async Task SaveContractAsync()
    {
        if (IsSaving) return;
        FormError = null;
        FormPaymentSumError = false;

        if (FormOpeningPct + FormValidationPct + FormConsolidationPct != 100m)
        {
            FormPaymentSumError = true;
            return;
        }

        IsSaving = true;
        var dto = new AdminSaveVacancyContractDto
        {
            VacancyLines = VacancyLines.Select(l => new ContractVacancyLineDto
            {
                VacancyId = l.VacancyId,
                PromoCode = !l.ManualOverride && l.AppliedPromo is { IsValid: true } ? l.AppliedPromo.Code : null,
                ManualPrice = l.ManualOverride ? l.FormManualPrice : null,
                OverrideReason = l.ManualOverride ? l.FormOverrideReason : null,
                WarrantyDays = l.FormWarrantyDays
            }).ToList(),
            ScopeServices = FormScope.ToList(),
            TargetCandidates = FormTargetCandidates,
            JobTypeCategory = FormJobType,
            TargetCoverageDays = FormCoverageDays,
            Currency = "EUR",
            FeeApplicationType = FormFeeApplicationType,
            PaymentOpeningPct = FormOpeningPct,
            PaymentValidationPct = FormValidationPct,
            PaymentConsolidationPct = FormConsolidationPct,
            FeeExceptions = FormFeeExceptions
        };
        var result = Contract != null
            ? await AuthApi.SaveContractAsync(Contract.Id, dto)
            : await AuthApi.CreateContractAsync(Vacancy!.CompanyId, dto);

        if (result.Contract == null)
        {
            FormError = result.Error ?? Lang.T("admin.contract.saveError");
        }
        else
        {
            Contract = result.Contract;
            BuildVacancyLines();
            LoadForm();
        }
        IsSaving = false;
    }

    private async Task SendContractAsync()
    {
        if (IsSaving) return;
        IsSaving = true;
        if (await AuthApi.SendContractAsync(Contract!.Id))
            Contract = await AuthApi.GetContractAsync(Contract.Id);
        IsSaving = false;
    }

    private async Task ConfirmRejectAsync()
    {
        RejectError = string.IsNullOrWhiteSpace(RejectReasonInput);
        if (RejectError) return;

        if (await AuthApi.DecideContractAsync(Contract!.Id, false, RejectReasonInput))
            Contract = await AuthApi.GetContractAsync(Contract.Id);
        ShowRejectReason = false;
    }

    private async Task DecideAsync(bool accepted)
    {
        if (await AuthApi.DecideContractAsync(Contract!.Id, accepted))
        {
            Contract = await AuthApi.GetContractAsync(Contract.Id);
            await LoadTranchesAsync();
            await LoadWarrantyReplacementsAsync();
        }
    }

    private void GoBack() => Nav.NavigateTo($"/vacancies/{VacancyId}");

    private void GoToDocument() => Nav.NavigateTo($"/contracts/{Contract!.Id}/document", forceLoad: true);

    private string GetScopeText()
    {
        if (FormScope.Count == 0 && Contract != null)
            FormScope = new HashSet<string>(Contract.ScopeServices);
        var codes = Contract?.ScopeServices ?? new List<string>();
        if (codes.Count == 0) return "-";
        var names = ScopeCatalog
            .Where(s => codes.Contains(s.Code))
            .Select(s => Lang.T(s.Key));
        return string.Join(", ", names);
    }

    private static string FormatEur(decimal? amount) => amount.HasValue
        ? amount.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-ES")) + " €"
        : "-";

    private static string FormatPct(decimal pct)
        => pct.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("es-ES")) + "%";

    private string GetJobTypeLabel(int jobType) => jobType switch
    {
        (int)ContractJobType.Operational => Lang.T("admin.contract.jobTypeOperational"),
        (int)ContractJobType.SupervisorsTechnicians => Lang.T("admin.contract.jobTypeSupervisors"),
        (int)ContractJobType.BusinessManagers => Lang.T("admin.contract.jobTypeBusiness"),
        (int)ContractJobType.QualifiedProfiles => Lang.T("admin.contract.jobTypeQualified"),
        _ => "-"
    };

    private string GetFeeApplicationLabel(int type) => type switch
    {
        (int)FeeApplicationType.PerPosition => Lang.T("admin.contract.feePerPosition"),
        (int)FeeApplicationType.PerProcess => Lang.T("admin.contract.feePerProcess"),
        (int)FeeApplicationType.GlobalPrice => Lang.T("admin.contract.feeGlobalPrice"),
        _ => "-"
    };

    private (string CssClass, string Label) GetStatusBadgeInfo(int status) => ((ContractStatus)status) switch
    {
        ContractStatus.Draft => ("admin-status--draft", "admin.contract.statusDraft"),
        ContractStatus.Sent => ("admin-status--info", "admin.contract.statusSent"),
        ContractStatus.Accepted => ("admin-status--active", "admin.contract.statusAccepted"),
        ContractStatus.Rejected => ("admin-status--closed", "admin.contract.statusRejected"),
        ContractStatus.Cancelled => ("admin-status--closed", "admin.contract.statusCancelled"),
        _ => ("admin-status--draft", "admin.contract.statusDraft")
    };
}
