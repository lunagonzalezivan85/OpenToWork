@page "/"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.SharedUI.Components
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@Lang.T("admin.dashboard.title")</PageTitle>

@if (IsAuthenticated)
{
    @* === Cabecera conversacional === *@
    <div class="admin-hero">
        <h1 class="admin-hero-greeting">@Greeting</h1>
        <p class="admin-hero-subtitle">@Lang.T("admin.dashboard.welcome")</p>

        <div class="admin-cmd-bar">
            <span class="admin-cmd-icon">✨</span>
            <input class="admin-cmd-input"
                   placeholder="@Lang.T("admin.dashboard.promptPlaceholder")"
                   @bind="Prompt" @bind:event="oninput"
                   @onkeydown="OnPromptKeyDown" />
            <button class="admin-cmd-suggest" @onclick="OpenSuggestions">
                ✨ @Lang.T("admin.dashboard.aiSuggestions")
                @if (Insights.Count > 0)
                {
                    <span class="admin-cmd-suggest-count">@Insights.Count</span>
                }
            </button>
            <button class="admin-cmd-send" @onclick="SubmitPrompt" aria-label="@Lang.T("admin.dashboard.promptSend")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
            </button>
        </div>

        <div class="admin-chip-row">
            <button class="admin-chip" @onclick="GoPending">@Lang.T("admin.dashboard.chipPendingCandidates")</button>
            <button class="admin-chip" @onclick="GoToCompanyPipeline">@Lang.T("admin.dashboard.chipStalled")</button>
            <button class="admin-chip" @onclick="GoToVacancies">@Lang.T("admin.dashboard.chipOpenVacancies")</button>
            <button class="admin-chip" @onclick="GoToPayments">@Lang.T("admin.dashboard.chipPendingPayments")</button>
        </div>
    </div>

    @if (Metrics != null)
    {
        var totalCandidates = Metrics.TotalCandidates;
        var evaluatedPct = totalCandidates > 0 ? (int)Math.Round((double)Metrics.EvaluatedProfiles / totalCandidates * 100) : 0;
        var scoresPct = Metrics.EvaluatedProfiles > 0 ? (int)Math.Round((double)Metrics.ProfilesWithScores / Metrics.EvaluatedProfiles * 100) : 0;
        var totalVacancies = Metrics.OpenVacancies + Metrics.ClosedVacancies + Metrics.DraftVacancies;
        var openPct = totalVacancies > 0 ? (double)Metrics.OpenVacancies / totalVacancies * 100 : 0;
        var closedPct = totalVacancies > 0 ? (double)Metrics.ClosedVacancies / totalVacancies * 100 : 0;
        var draftPct = totalVacancies > 0 ? (double)Metrics.DraftVacancies / totalVacancies * 100 : 0;
        var totalCompanies = Metrics.CompaniesWithVacancies + Metrics.CompaniesWithoutVacancies;
        var withVacPct = totalCompanies > 0 ? (double)Metrics.CompaniesWithVacancies / totalCompanies * 100 : 0;
        var withoutVacPct = totalCompanies > 0 ? (double)Metrics.CompaniesWithoutVacancies / totalCompanies * 100 : 0;
        var circumference = 2 * Math.PI * 56;

        @* === Sección 0: Indicadores del Negocio *@
        @if (BusinessMetrics != null)
        {
            var bm = BusinessMetrics;
            <h2 class="admin-section-title">@Lang.T("admin.dashboard.sectionBusiness")</h2>
            <div class="admin-stat-grid admin-stat-grid--3col" style="margin-bottom: var(--space-lg);">
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToPayments">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.revenueCollected")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--emerald">💶</span>
                    </div>
                    <span class="admin-stat-v2-value">@FormatEur(bm.RevenueCollected)</span>
                    <span class="admin-stat-v2-badge">@Lang.T("admin.dashboard.revenuePending"): @FormatEur(bm.RevenuePending)</span>
                </div>
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToCompanyPipeline">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.winRate")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--blue">📈</span>
                    </div>
                    <span class="admin-stat-v2-value">@bm.WinRatePercentage.ToString("F0")%</span>
                    <span class="admin-stat-v2-badge">@bm.DealsWon @Lang.T("admin.dashboard.won") / @bm.DealsLost @Lang.T("admin.dashboard.lost")</span>
                </div>
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToVacancies">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.timeToHire")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--purple">⏱️</span>
                    </div>
                    <span class="admin-stat-v2-value">@(bm.AverageTimeToHireDays.HasValue ? bm.AverageTimeToHireDays.Value.ToString("F0") : "-")</span>
                    <span class="admin-stat-v2-badge">@bm.TimeToHireSampleSize @Lang.T("admin.dashboard.timeToHireDetail")</span>
                </div>
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToVacancies">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.placementSuccessRate")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--emerald">🎯</span>
                    </div>
                    <span class="admin-stat-v2-value">@bm.PlacementSuccessRatePercentage.ToString("F0")%</span>
                    <span class="admin-stat-v2-badge @(bm.PlacementSuccessRatePercentage >= 90 ? "admin-stat-v2-badge--success" : bm.PlacementSuccessRatePercentage >= 75 ? "admin-stat-v2-badge--warning" : "admin-stat-v2-badge--danger")">@bm.PlacementsWithWarrantyIssue / @bm.TotalHires @Lang.T("admin.dashboard.placementSuccessDetail")</span>
                </div>
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToCompanyPipeline">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.openPipelineValue")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--amber">💼</span>
                    </div>
                    <span class="admin-stat-v2-value">@FormatEur(bm.OpenPipelineValue)</span>
                    <span class="admin-stat-v2-badge">@bm.OpenContractsCount @Lang.T("admin.dashboard.openContractsDetail")</span>
                </div>
                <div class="admin-stat-v2 admin-clickable" @onclick="GoToCompanyPipeline">
                    <div class="admin-stat-v2-top">
                        <span class="admin-stat-label">@Lang.T("admin.dashboard.stalledCompanies")</span>
                        <span class="admin-stat-v2-icon admin-stat-v2-icon--red">⚠️</span>
                    </div>
                    <span class="admin-stat-v2-value">@bm.StalledCompaniesCount</span>
                    <span class="admin-stat-v2-badge @(bm.StalledCompaniesCount > 0 ? "admin-stat-v2-badge--danger" : "admin-stat-v2-badge--success")">@Lang.T("admin.dashboard.stalledCompaniesDetail")</span>
                </div>
            </div>
        }

        @* === Sección 1: Perfiles === *@
        <h2 class="admin-section-title">@Lang.T("admin.dashboard.sectionProfiles")</h2>
        <div class="admin-chart-grid">
            <!-- Progress: Perfiles evaluados -->
            <div class="admin-progress-card admin-clickable" @onclick="GoEvaluated">
                <div class="admin-progress-header">
                    <span class="admin-progress-title">@Lang.T("admin.dashboard.evaluatedProfiles")</span>
                    <span class="admin-progress-numbers"><strong>@Metrics.EvaluatedProfiles</strong> / @totalCandidates</span>
                </div>
                <div class="admin-progress-bar">
                    <div class="admin-progress-fill admin-progress-fill--success" style="width: @evaluatedPct%"></div>
                </div>
                <div class="admin-progress-detail">
                    <span><span class="dot" style="background: var(--success)"></span>@Lang.T("admin.dashboard.evaluated"): @Metrics.EvaluatedProfiles</span>
                    <span><span class="dot" style="background: var(--bg-tertiary)"></span>@Lang.T("admin.dashboard.pending"): @Metrics.PendingProfiles</span>
                    <span>@evaluatedPct%</span>
                </div>
            </div>

            <!-- Progress: Perfiles con scores -->
            <div class="admin-progress-card admin-clickable" @onclick="GoScores">
                <div class="admin-progress-header">
                    <span class="admin-progress-title">@Lang.T("admin.dashboard.profilesWithScores")</span>
                    <span class="admin-progress-numbers"><strong>@Metrics.ProfilesWithScores</strong> / @Metrics.EvaluatedProfiles</span>
                </div>
                <div class="admin-progress-bar">
                    <div class="admin-progress-fill admin-progress-fill--info" style="width: @scoresPct%"></div>
                </div>
                <div class="admin-progress-detail">
                    <span><span class="dot" style="background: #0066FF"></span>@Lang.T("admin.dashboard.withScores"): @Metrics.ProfilesWithScores</span>
                    <span><span class="dot" style="background: var(--bg-tertiary)"></span>@Lang.T("admin.dashboard.withoutScores"): @(Metrics.EvaluatedProfiles - Metrics.ProfilesWithScores)</span>
                    <span>@scoresPct%</span>
                </div>
            </div>
        </div>

        @* === Sección 2: Vacantes y Empresas *@
        <h2 class="admin-section-title">@Lang.T("admin.dashboard.sectionVacancies")</h2>
        <div class="admin-chart-grid">
            <!-- Donut: Vacantes por estado -->
            <div class="admin-chart-card admin-clickable" @onclick="GoToVacancies">
                <span class="admin-chart-card-title">@Lang.T("admin.dashboard.vacanciesByStatus")</span>
                <div class="admin-donut-wrapper">
                    <div class="admin-donut">
                        <svg width="140" height="140" viewBox="0 0 140 140">
                            <circle cx="70" cy="70" r="56" fill="none" stroke="var(--bg-tertiary)" stroke-width="16" />
                            @if (totalVacancies > 0)
                            {
                                <circle cx="70" cy="70" r="56" fill="none" stroke="#0066FF" stroke-width="16"
                                        stroke-dasharray="@(Math.Round(circumference * openPct / 100), 2) @(Math.Round(circumference, 2))"
                                        stroke-dashoffset="0" />
                                <circle cx="70" cy="70" r="56" fill="none" stroke="var(--warning)" stroke-width="16"
                                        stroke-dasharray="@(Math.Round(circumference * closedPct / 100), 2) @(Math.Round(circumference, 2))"
                                        stroke-dashoffset="@(-Math.Round(circumference * openPct / 100, 2))" />
                                <circle cx="70" cy="70" r="56" fill="none" stroke="var(--bg-tertiary)" stroke-width="16"
                                        stroke-dasharray="@(Math.Round(circumference * draftPct / 100), 2) @(Math.Round(circumference, 2))"
                                        stroke-dashoffset="@(-Math.Round(circumference * (openPct + closedPct) / 100, 2))" />
                            }
                        </svg>
                        <div class="admin-donut-center">
                            <div class="admin-donut-center-value">@totalVacancies</div>
                            <div class="admin-donut-center-label">@Lang.T("admin.dashboard.total")</div>
                        </div>
                    </div>
                    <div class="admin-donut-legend">
                        <div class="admin-legend-item">
                            <span class="admin-legend-dot" style="background: #0066FF"></span>
                            <span class="admin-legend-label">@Lang.T("admin.dashboard.openVacancies")</span>
                            <span class="admin-legend-value">@Metrics.OpenVacancies</span>
                        </div>
                        <div class="admin-legend-item">
                            <span class="admin-legend-dot" style="background: var(--warning)"></span>
                            <span class="admin-legend-label">@Lang.T("admin.dashboard.closedVacancies")</span>
                            <span class="admin-legend-value">@Metrics.ClosedVacancies</span>
                        </div>
                        <div class="admin-legend-item">
                            <span class="admin-legend-dot" style="background: var(--bg-tertiary)"></span>
                            <span class="admin-legend-label">@Lang.T("admin.dashboard.draftVacancies")</span>
                            <span class="admin-legend-value">@Metrics.DraftVacancies</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donut: Empresas con/sin vacantes -->
            <div class="admin-chart-card admin-clickable" @onclick="GoCompanies">
                <span class="admin-chart-card-title">@Lang.T("admin.dashboard.companiesVacancies")</span>
                <div class="admin-donut-wrapper">
                    <div class="admin-donut">
                        <svg width="140" height="140" viewBox="0 0 140 140">
                            <circle cx="70" cy="70" r="56" fill="none" stroke="var(--bg-tertiary)" stroke-width="16" />
                            @if (totalCompanies > 0)
                            {
                                <circle cx="70" cy="70" r="56" fill="none" stroke="#0066FF" stroke-width="16"
                                        stroke-dasharray="@(Math.Round(circumference * withVacPct / 100), 2) @(Math.Round(circumference, 2))"
                                        stroke-dashoffset="0" />
                                <circle cx="70" cy="70" r="56" fill="none" stroke="var(--text-muted)" stroke-width="16"
                                        stroke-dasharray="@(Math.Round(circumference * withoutVacPct / 100), 2) @(Math.Round(circumference, 2))"
                                        stroke-dashoffset="@(-Math.Round(circumference * withVacPct / 100, 2))" />
                            }
                        </svg>
                        <div class="admin-donut-center">
                            <div class="admin-donut-center-value">@totalCompanies</div>
                            <div class="admin-donut-center-label">@Lang.T("admin.dashboard.total")</div>
                        </div>
                    </div>
                    <div class="admin-donut-legend">
                        <div class="admin-legend-item">
                            <span class="admin-legend-dot" style="background: #0066FF"></span>
                            <span class="admin-legend-label">@Lang.T("admin.dashboard.companiesWithVacancies")</span>
                            <span class="admin-legend-value">@Metrics.CompaniesWithVacancies</span>
                        </div>
                        <div class="admin-legend-item">
                            <span class="admin-legend-dot" style="background: var(--text-muted)"></span>
                            <span class="admin-legend-label">@Lang.T("admin.dashboard.companiesWithoutVacancies")</span>
                            <span class="admin-legend-value">@Metrics.CompaniesWithoutVacancies</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* === Sección 3: Verificaciones de candidatos *@
        <h2 class="admin-section-title">@Lang.T("admin.dashboard.sectionVerifications")</h2>
        <div class="admin-chart-card">
            <span class="admin-chart-card-title">@Lang.T("admin.dashboard.candidateVerifications") (@totalCandidates @Lang.T("admin.dashboard.candidatesTotal"))</span>
            <div class="admin-bar-chart">
                <div class="admin-bar-row admin-clickable" @onclick="GoLinkedIn">
                    <span class="admin-bar-label">@Lang.T("admin.dashboard.withLinkedIn")</span>
                    <div class="admin-bar-track">
                        <div class="admin-bar-fill admin-bar-fill--linkedin" style="width: @(totalCandidates > 0 ? Metrics.CandidatesWithLinkedIn * 100 / totalCandidates : 0)%">
                            @(totalCandidates > 0 ? Metrics.CandidatesWithLinkedIn * 100 / totalCandidates : 0)%
                        </div>
                    </div>
                    <span class="admin-bar-value">@Metrics.CandidatesWithLinkedIn</span>
                </div>
                <div class="admin-bar-row admin-clickable" @onclick="GoPortfolio">
                    <span class="admin-bar-label">@Lang.T("admin.dashboard.withPortfolio")</span>
                    <div class="admin-bar-track">
                        <div class="admin-bar-fill admin-bar-fill--portfolio" style="width: @(totalCandidates > 0 ? Metrics.CandidatesWithPortfolio * 100 / totalCandidates : 0)%">
                            @(totalCandidates > 0 ? Metrics.CandidatesWithPortfolio * 100 / totalCandidates : 0)%
                        </div>
                    </div>
                    <span class="admin-bar-value">@Metrics.CandidatesWithPortfolio</span>
                </div>
                <div class="admin-bar-row admin-clickable" @onclick="GoCV">
                    <span class="admin-bar-label">@Lang.T("admin.dashboard.withCV")</span>
                    <div class="admin-bar-track">
                        <div class="admin-bar-fill admin-bar-fill--cv" style="width: @(totalCandidates > 0 ? Metrics.CandidatesWithCV * 100 / totalCandidates : 0)%">
                            @(totalCandidates > 0 ? Metrics.CandidatesWithCV * 100 / totalCandidates : 0)%
                        </div>
                    </div>
                    <span class="admin-bar-value">@Metrics.CandidatesWithCV</span>
                </div>
                <div class="admin-bar-row admin-clickable" @onclick="GoEvaluated">
                    <span class="admin-bar-label">@Lang.T("admin.dashboard.profilesComplete")</span>
                    <div class="admin-bar-track">
                        <div class="admin-bar-fill admin-bar-fill--evaluated" style="width: @evaluatedPct%">
                            @evaluatedPct%
                        </div>
                    </div>
                    <span class="admin-bar-value">@Metrics.EvaluatedProfiles</span>
                </div>
                <div class="admin-bar-row admin-clickable" @onclick="GoPending">
                    <span class="admin-bar-label">@Lang.T("admin.dashboard.profilesIncomplete")</span>
                    <div class="admin-bar-track">
                        <div class="admin-bar-fill admin-bar-fill--pending" style="width: @(totalCandidates > 0 ? Metrics.PendingProfiles * 100 / totalCandidates : 0)%">
                            @(totalCandidates > 0 ? Metrics.PendingProfiles * 100 / totalCandidates : 0)%
                        </div>
                    </div>
                    <span class="admin-bar-value">@Metrics.PendingProfiles</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-loading">@Lang.T("admin.common.loading")</div>
    }

    @* === Modal: Sugerencias de la IA === *@
    @if (ShowSuggestions)
    {
        <div class="admin-modal-overlay" @onclick="CloseSuggestions">
            <div class="admin-modal admin-ai-modal" @onclick:stopPropagation="true">
                <div class="admin-ai-header">
                    <span class="admin-ai-icon">✨</span>
                    <span class="admin-modal-title" style="margin-bottom: 0;">@Lang.T("admin.dashboard.aiSuggestions")</span>
                </div>
                <div class="admin-ai-list" style="margin-top: var(--space-md);">
                    @if (Insights.Count == 0)
                    {
                        <span class="admin-ai-empty">@Lang.T("admin.dashboard.aiEmpty")</span>
                    }
                    @foreach (var insight in Insights)
                    {
                        <div class="admin-ai-item">
                            <span>@insight.Text</span>
                            <button class="admin-ai-action" @onclick="() => RunInsight(insight)">@insight.ActionLabel</button>
                        </div>
                    }
                </div>
                <div class="admin-modal-actions" style="margin-top: var(--space-md);">
                    <button class="admin-ai-action" @onclick="CloseSuggestions">@Lang.T("admin.dashboard.aiClose")</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool IsAuthenticated { get; set; }
    private DashboardMetricsDto? Metrics { get; set; }
    private BusinessMetricsDto? BusinessMetrics { get; set; }
    private string Prompt { get; set; } = string.Empty;
    private string? UserName { get; set; }
    private bool ShowSuggestions { get; set; }
    private List<AiInsight> Insights { get; set; } = new();

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var key = hour < 12 ? "admin.dashboard.greetingMorning"
                    : hour < 19 ? "admin.dashboard.greetingAfternoon"
                    : "admin.dashboard.greetingEvening";
            return string.IsNullOrEmpty(UserName) ? Lang.T(key) : $"{Lang.T(key)}, {UserName}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        IsAuthenticated = true;

        Metrics = await AuthApi.GetMetricsAsync();
        BusinessMetrics = await AuthApi.GetBusinessMetricsAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                 ?? authState.User.FindFirst("email")?.Value;
        if (!string.IsNullOrEmpty(email))
        {
            var raw = email.Split('@')[0];
            UserName = char.ToUpperInvariant(raw[0]) + raw[1..];
        }

        BuildInsights();
    }

    private void BuildInsights()
    {
        Insights.Clear();
        if (Metrics == null) return;

        if (Metrics.PendingProfiles > 0)
            Insights.Add(new AiInsight(
                string.Format(Lang.T("admin.dashboard.insightPendingProfiles"), Metrics.PendingProfiles),
                Lang.T("admin.dashboard.actionView"), GoPending));

        if (BusinessMetrics != null)
        {
            if (BusinessMetrics.StalledCompaniesCount > 0)
                Insights.Add(new AiInsight(
                    string.Format(Lang.T("admin.dashboard.insightStalled"), BusinessMetrics.StalledCompaniesCount),
                    Lang.T("admin.dashboard.actionReview"), GoToCompanyPipeline));
            if (BusinessMetrics.OpenContractsCount > 0)
                Insights.Add(new AiInsight(
                    string.Format(Lang.T("admin.dashboard.insightContracts"), BusinessMetrics.OpenContractsCount),
                    Lang.T("admin.dashboard.actionView"), GoToCompanyPipeline));
            if (BusinessMetrics.RevenuePending > 0)
                Insights.Add(new AiInsight(
                    string.Format(Lang.T("admin.dashboard.insightRevenue"), FormatEur(BusinessMetrics.RevenuePending)),
                    Lang.T("admin.dashboard.actionView"), GoToPayments));
        }

        if (Metrics.DraftVacancies > 0)
            Insights.Add(new AiInsight(
                string.Format(Lang.T("admin.dashboard.insightDrafts"), Metrics.DraftVacancies),
                Lang.T("admin.dashboard.actionReview"), GoToVacancies));
    }

    private void SubmitPrompt()
    {
        var q = Prompt.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(q)) return;

        if (q.Contains("candidat") || q.Contains("perfil") || q.Contains("profile"))
            GoToResults("candidate");
        else if (q.Contains("empresa") || q.Contains("compan") || q.Contains("pipeline"))
            GoToCompanyPipeline();
        else if (q.Contains("vacant") || q.Contains("vacanc") || q.Contains("job"))
            GoToVacancies();
        else if (q.Contains("pago") || q.Contains("payment") || q.Contains("ingreso") || q.Contains("revenue"))
            GoToPayments();
        else
            GoToResults();

        Prompt = string.Empty;
    }

    private void OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitPrompt();
    }

    private void OpenSuggestions() => ShowSuggestions = true;
    private void CloseSuggestions() => ShowSuggestions = false;

    private void RunInsight(AiInsight insight)
    {
        ShowSuggestions = false;
        insight.OnAction();
    }

    private sealed record AiInsight(string Text, string ActionLabel, Action OnAction);

    private string FormatEur(decimal amount) => $"{amount:N2} EUR";

    private void GoToPayments() => Nav.NavigateTo("/payments");
    private void GoToCompanyPipeline() => Nav.NavigateTo("/companies/pipeline");

    private void GoToResults(string? role = null, string? filter = null, string? section = null)
    {
        var parts = new List<string>();
        if (role != null) parts.Add($"role={role}");
        if (filter != null) parts.Add($"filter={filter}");
        if (section != null) parts.Add($"section={section}");
        var query = parts.Count > 0 ? "?" + string.Join("&", parts) : "";
        Nav.NavigateTo($"/dashboard/results{query}");
    }

    private void GoEvaluated() => GoToResults("candidate", "evaluated");
    private void GoPending() => GoToResults("candidate", "pending");
    private void GoScores() => GoToResults("candidate", "scores");
    private void GoLinkedIn() => GoToResults("candidate", "linkedin");
    private void GoPortfolio() => GoToResults("candidate", "portfolio");
    private void GoCV() => GoToResults("candidate", "cv");
    private void GoCompanies() => GoToResults("company");
    private void GoToVacancies() => GoToResults(section: "vacancies");
}
