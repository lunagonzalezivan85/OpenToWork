@page "/settings/company-profile"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi

<PageTitle>@Lang.T("admin.companyProfile.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.companyProfile.title")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.companyProfile.subtitle")</p>
    </div>
</div>

@if (!IsSuperAdmin)
{
    <div class="admin-empty">
        <div class="admin-empty-text">@Lang.T("admin.staff.notAuthorized")</div>
    </div>
}
else if (IsLoading)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else
{
    <div class="admin-tabs">
        <button class="admin-tab @(ActiveTab == "company" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("company")'>@Lang.T("admin.companyProfile.tabCompany")</button>
        <button class="admin-tab @(ActiveTab == "apis" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("apis")'>@Lang.T("admin.companyProfile.tabApis")</button>
    </div>

    @if (ActiveTab == "company")
    {
    @if (SavedMessage)
    {
        <p style="color: var(--success); font-size: 0.85rem;">@Lang.T("admin.companyProfile.saved")</p>
    }
    @if (Error != null)
    {
        <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
    }

    <EditForm Model="Form" OnValidSubmit="Save">
        <div class="admin-chart-grid">
            <div class="admin-chart-card">
                <span class="admin-chart-card-title">@Lang.T("admin.companyProfile.sectionIdentity")</span>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.legalName")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.LegalName" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.taxId")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.TaxId" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.address")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.Address" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.mercantileRegistry")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.MercantileRegistry" />
                </div>
            </div>
            <div class="admin-chart-card">
                <span class="admin-chart-card-title">@Lang.T("admin.companyProfile.sectionLegalRep")</span>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.legalRepName")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.LegalRepName" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.legalRepPosition")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.LegalRepPosition" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.legalRepDni")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.LegalRepDni" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.jurisdictionCity")</label>
                    <InputText class="ot-input-field" @bind-Value="Form.JurisdictionCity" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.companyProfile.privacyEmail")</label>
                    <InputText class="ot-input-field" type="email" @bind-Value="Form.PrivacyEmail" placeholder="privacidad@tratodirecto.com" />
                    <span style="font-size: 0.75rem; color: var(--text-muted);">@Lang.T("admin.companyProfile.privacyEmailHint")</span>
                </div>
            </div>
            <div class="admin-chart-card" style="grid-column: 1 / -1;">
                <span class="admin-chart-card-title">@Lang.T("admin.companyProfile.sectionPreview")</span>
                <p style="font-size: 0.82rem; line-height: 1.6; color: var(--text-secondary); margin: 0;">
                    De una parte, <strong>@NonEmpty(Form.LegalName)</strong>, con domicilio social en @NonEmpty(Form.Address), CIF @NonEmpty(Form.TaxId), inscrita en el @NonEmpty(Form.MercantileRegistry), representada en este acto por D./Dña. @NonEmpty(Form.LegalRepName), en calidad de @NonEmpty(Form.LegalRepPosition), con DNI/NIE @NonEmpty(Form.LegalRepDni).
                </p>
                <p class="admin-page-header-subtitle" style="margin: 0;">@Lang.T("admin.companyProfile.previewNote")</p>
            </div>
        </div>
        <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium" style="margin-top: var(--space-md);" disabled="@IsSaving">@Lang.T("admin.common.save")</button>
    </EditForm>

    <p class="admin-page-header-subtitle" style="margin-top: var(--space-md);">@Lang.T("admin.companyProfile.usageNote")</p>
    }
    else
    {
    <h2 style="margin-top: var(--space-lg);">@Lang.T("admin.aiSettings.sectionTitle")</h2>
    <p class="admin-page-header-subtitle">@Lang.T("admin.aiSettings.subtitle")</p>

    @if (AiSavedMessage)
    {
        <p style="color: var(--success); font-size: 0.85rem;">@Lang.T("admin.companyProfile.saved")</p>
    }
    @if (AiError != null)
    {
        <p style="color: var(--danger); font-size: 0.85rem;">@AiError</p>
    }

    <EditForm Model="AiForm" OnValidSubmit="SaveAi">
        <div class="admin-chart-grid">
            <div class="admin-chart-card">
                <span class="admin-chart-card-title">@Lang.T("admin.aiSettings.sectionProvider")</span>
                <label style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--space-sm);">
                    <input type="checkbox" @bind="AiForm.Enabled" /> @Lang.T("admin.aiSettings.enabled")
                </label>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.aiSettings.provider")</label>
                    <InputSelect class="ot-input-field" @bind-Value="AiForm.Provider" @bind:after="OnAiProviderChanged">
                        <option value="">@Lang.T("admin.aiSettings.providerNone")</option>
                        <option value="gemini">Google Gemini</option>
                        <option value="groq">Groq</option>
                        <option value="openai">OpenAI</option>
                        <option value="anthropic">Claude (Anthropic)</option>
                        <option value="custom">@Lang.T("admin.aiSettings.providerCustom")</option>
                    </InputSelect>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.aiSettings.baseUrl")</label>
                    <InputText class="ot-input-field" @bind-Value="AiForm.BaseUrl" placeholder="@AiBaseUrlPlaceholder" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.aiSettings.model")</label>
                    @if (AiModelOptions.Count > 0)
                    {
                        <InputSelect class="ot-input-field" @bind-Value="AiForm.Model">
                            <option value="">@Lang.T("admin.aiSettings.modelSelect")</option>
                            @foreach (var m in AiModelOptions)
                            {
                                <option value="@m">@m</option>
                            }
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="ot-input-field" @bind-Value="AiForm.Model" placeholder="@Lang.T("admin.aiSettings.modelFreeHint")" />
                    }
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">@Lang.T("admin.aiSettings.apiKey")</label>
                    <InputText type="password" class="ot-input-field" @bind-Value="AiForm.ApiKey" placeholder="@(AiForm.HasApiKey ? Lang.T("admin.aiSettings.apiKeySaved") : "sk-...")" />
                    <span style="font-size: 0.75rem; color: var(--text-muted);">@Lang.T("admin.aiSettings.apiKeyHint")</span>
                </div>
            </div>
            <div class="admin-chart-card">
                <span class="admin-chart-card-title">@Lang.T("admin.aiSettings.sectionUsage")</span>
                <p class="admin-page-header-subtitle" style="margin: 0 0 var(--space-sm) 0;">@Lang.T("admin.aiSettings.usageHint")</p>
                <label style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--space-sm);">
                    <input type="checkbox" @bind="AiForm.CvAnalysisEnabled" /> @Lang.T("admin.aiSettings.cvAnalysis")
                </label>
                <label style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--space-sm);">
                    <input type="checkbox" @bind="AiForm.CommandBarEnabled" /> @Lang.T("admin.aiSettings.commandBar")
                </label>
                <label style="display: flex; align-items: center; gap: 0.4rem; margin-bottom: var(--space-sm);">
                    <input type="checkbox" @bind="AiForm.AdminSuggestionsEnabled" /> @Lang.T("admin.aiSettings.adminSuggestions")
                </label>
                <label style="display: flex; align-items: center; gap: 0.4rem;">
                    <input type="checkbox" @bind="AiForm.MatchingEnabled" /> @Lang.T("admin.aiSettings.matching")
                </label>
            </div>
        </div>
        <button type="submit" class="ot-btn ot-btn--primary ot-btn--medium" style="margin-top: var(--space-md);" disabled="@IsSavingAi">@Lang.T("admin.common.save")</button>
    </EditForm>
    }
}

@code {
    private bool IsSuperAdmin;
    private bool IsLoading = true;
    private bool IsSaving;
    private bool SavedMessage;
    private string? Error;

    private string ActiveTab { get; set; } = "company";
    private void SwitchTab(string tab) => ActiveTab = tab;

    private bool IsSavingAi;
    private bool AiSavedMessage;
    private string? AiError;

    private CompanyProfileForm Form = new();
    private AiSettingsDto AiForm = new();

    private static readonly Dictionary<string, string[]> AiModelsByProvider = new()
    {
        ["gemini"] = new[] { "gemini-2.5-pro", "gemini-2.5-flash", "gemini-2.5-flash-lite", "gemini-2.0-flash" },
        ["groq"] = new[] { "llama-3.3-70b-versatile", "llama-3.1-8b-instant", "openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3-32b", "moonshotai/kimi-k2-instruct" },
        ["openai"] = new[] { "gpt-5", "gpt-5-mini", "gpt-5-nano", "gpt-4.1", "gpt-4.1-mini", "gpt-4o", "gpt-4o-mini" },
        ["anthropic"] = new[] { "claude-sonnet-4-5", "claude-opus-4-1", "claude-haiku-4-5", "claude-sonnet-4" }
    };

    private List<string> AiModelOptions
    {
        get
        {
            if (!AiModelsByProvider.TryGetValue(AiForm.Provider, out var models))
                return new List<string>();

            var list = models.ToList();
            if (!string.IsNullOrWhiteSpace(AiForm.Model) && !list.Contains(AiForm.Model))
                list.Insert(0, AiForm.Model);
            return list;
        }
    }

    private string AiBaseUrlPlaceholder => AiForm.Provider switch
    {
        "gemini" => "https://generativelanguage.googleapis.com",
        "groq" => "https://api.groq.com/openai/v1",
        "openai" => "https://api.openai.com/v1",
        "anthropic" => "https://api.anthropic.com/v1",
        _ => Lang.T("admin.aiSettings.baseUrlCustomHint")
    };

    private void OnAiProviderChanged()
    {
        AiForm.Model = string.Empty;
    }

    private static string NonEmpty(string value) => string.IsNullOrWhiteSpace(value) ? "[●]" : value;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var staffRoleRaw = await LocalStorage.GetItemAsync("otwadmin-staff-role");
        IsSuperAdmin = int.TryParse(staffRoleRaw, out var role) && role == (int)AdminStaffRole.SuperAdmin;

        if (IsSuperAdmin)
        {
            await LoadAsync();
            await LoadAiAsync();
        }

        IsLoading = false;
    }

    private async Task LoadAiAsync()
    {
        AiForm = await AuthApi.GetAiSettingsAsync() ?? new AiSettingsDto();
    }

    private async Task SaveAi()
    {
        AiError = null;
        AiSavedMessage = false;
        IsSavingAi = true;

        var (result, error) = await AuthApi.UpdateAiSettingsAsync(AiForm);
        IsSavingAi = false;

        if (result == null)
        {
            AiError = error ?? Lang.T("admin.common.errorGeneric");
            return;
        }

        AiForm = result;
        AiSavedMessage = true;
    }

    private async Task LoadAsync()
    {
        var items = await AuthApi.GetSystemConfigAsync();
        var byKey = (items ?? new()).ToDictionary(i => i.Key, i => i.Value ?? "");

        string Get(string key) => byKey.GetValueOrDefault(key, "");

        Form = new CompanyProfileForm
        {
            LegalName = Get("company_legal_name"),
            TaxId = Get("company_tax_id"),
            Address = Get("company_address"),
            MercantileRegistry = Get("company_mercantile_registry"),
            LegalRepName = Get("legal_rep_name"),
            LegalRepPosition = Get("legal_rep_position"),
            LegalRepDni = Get("legal_rep_dni"),
            JurisdictionCity = Get("jurisdiction_city"),
            PrivacyEmail = Get("company_privacy_email")
        };
    }

    private async Task Save()
    {
        IsSaving = true;
        SavedMessage = false;
        Error = null;

        var dto = new UpdateSystemConfigDto
        {
            Items = new List<SystemConfigItemDto>
            {
                new() { Key = "company_legal_name", Value = Form.LegalName },
                new() { Key = "company_tax_id", Value = Form.TaxId },
                new() { Key = "company_address", Value = Form.Address },
                new() { Key = "company_mercantile_registry", Value = Form.MercantileRegistry },
                new() { Key = "legal_rep_name", Value = Form.LegalRepName },
                new() { Key = "legal_rep_position", Value = Form.LegalRepPosition },
                new() { Key = "legal_rep_dni", Value = Form.LegalRepDni },
                new() { Key = "jurisdiction_city", Value = Form.JurisdictionCity },
                new() { Key = "company_privacy_email", Value = Form.PrivacyEmail }
            }
        };

        var ok = await AuthApi.UpdateSystemConfigAsync(dto);
        if (ok)
            SavedMessage = true;
        else
            Error = Lang.T("admin.common.errorGeneric");

        IsSaving = false;
    }

    private class CompanyProfileForm
    {
        public string LegalName { get; set; } = "";
        public string TaxId { get; set; } = "";
        public string Address { get; set; } = "";
        public string MercantileRegistry { get; set; } = "";
        public string LegalRepName { get; set; } = "";
        public string LegalRepPosition { get; set; } = "";
        public string LegalRepDni { get; set; } = "";
        public string JurisdictionCity { get; set; } = "";
        public string PrivacyEmail { get; set; } = "";
    }
}
