@page "/settings/presentation-videos"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi

@* Configuracion > Videos de candidatos (3-Oct): enciende o apaga el video de presentacion de 1 minuto
   en el portal del candidato y muestra cuanto ocupan los videos guardados. *@

<PageTitle>@Lang.T("admin.presentationVideos.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.presentationVideos.title")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.presentationVideos.subtitle")</p>
    </div>
</div>

@if (!IsSuperAdmin)
{
    <div class="admin-empty">
        <div class="admin-empty-text">@Lang.T("admin.staff.notAuthorized")</div>
    </div>
}
else if (Settings == null)
{
    <div class="admin-empty">
        <div class="admin-empty-text">@(LoadFailed ? Lang.T("admin.common.errorGeneric") : Lang.T("admin.common.loading"))</div>
    </div>
}
else
{
    <div class="admin-chart-grid">
        <div class="admin-chart-card" style="min-height: 0;">
            <label style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" checked="@Settings.Enabled" @onchange="ToggleAsync" disabled="@IsSaving" />
                @Lang.T("admin.presentationVideos.toggle")
            </label>
            <p class="admin-page-header-subtitle" style="margin: 0;">@Lang.T("admin.presentationVideos.toggleHint")</p>
        </div>

        <div class="admin-chart-card" style="min-height: 0;">
            <span class="admin-chart-card-title">@Lang.T("admin.presentationVideos.usageTitle")</span>
            <p style="margin: 0; font-size: 1.4rem; font-weight: 700;">
                @Settings.VideoCount @Lang.T("admin.presentationVideos.videos") · @FormatSize(Settings.TotalBytes)
            </p>
            <p class="admin-page-header-subtitle" style="margin: 0;">@Lang.T("admin.presentationVideos.usageHint")</p>
        </div>
    </div>

    @if (Error != null)
    {
        <p style="color: var(--danger); font-size: 0.85rem;">@Error</p>
    }
}

@code {
    private bool IsSuperAdmin;
    private bool IsSaving;
    private bool LoadFailed;
    private PresentationVideoSettingsDto? Settings;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var staffRoleRaw = await LocalStorage.GetItemAsync("otwadmin-staff-role");
        IsSuperAdmin = int.TryParse(staffRoleRaw, out var role) && role == (int)AdminStaffRole.SuperAdmin;

        if (IsSuperAdmin)
        {
            Settings = await AuthApi.GetPresentationVideoSettingsAsync();
            LoadFailed = Settings == null;
        }
    }

    private async Task ToggleAsync(ChangeEventArgs e)
    {
        if (Settings == null) return;
        var enabled = e.Value is bool b && b;
        IsSaving = true;
        Error = null;
        if (await AuthApi.SetPresentationVideosEnabledAsync(enabled))
            Settings.Enabled = enabled;
        else
            Error = Lang.T("admin.common.errorGeneric");
        IsSaving = false;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_000_000_000 => $"{bytes / 1_000_000_000.0:0.0} GB",
        >= 1_000_000 => $"{bytes / 1_000_000.0:0.0} MB",
        _ => $"{bytes / 1000.0:0} KB"
    };
}
