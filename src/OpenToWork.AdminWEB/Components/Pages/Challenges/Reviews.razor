@page "/challenges/reviews"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.Challenges
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

@* Cola de revision. El servidor ya filtra: SuperAdmin ve todo, Reclutador solo sus candidatos asignados. *@

<PageTitle>@L("reviewsTitle")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@L("reviewsTitle")</h1>
        <p class="admin-page-header-subtitle">@L("reviewsSubtitle")</p>
    </div>
    <div class="admin-page-actions">
        <label class="admin-form-label"><input type="checkbox" checked="@_includeCompleted" @onchange="ToggleCompletedAsync" /> @L("includeCompleted")</label>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => Nav.NavigateTo("/challenges")'>@L("title")</button>
    </div>
</div>

@if (_error != null)
{
    <div class="alert alert-error">@L(_error)</div>
}
else if (_items == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (_items.Count == 0)
{
    <div class="admin-empty"><div class="admin-empty-text">@L("reviewsEmpty")</div></div>
}
else
{
    <table class="ot-table">
        <thead><tr><th>@L("candidate")</th><th>@L("challenge")</th><th>@L("submittedAt")</th><th>@L("statusCol")</th><th>@L("pendingItems")</th><th>@L("recruiter")</th><th></th></tr></thead>
        <tbody>
            @foreach (var i in _items)
            {
                <tr>
                    <td>@i.CandidateName</td>
                    <td>@i.ChallengeTitle <span class="chp-muted">v@(i.VersionNumber)</span></td>
                    <td>@i.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="admin-status @(i.ReviewStatus == ReviewStatus.Completed ? "admin-status--success" : "admin-status--draft")">@L($"review.{i.ReviewStatus}")</span></td>
                    <td>@i.PendingItems</td>
                    <td>@(i.AssignedRecruiter ?? "—")</td>
                    <td><button class="ot-btn ot-btn--primary ot-btn--small" @onclick='() => Nav.NavigateTo($"/challenges/reviews/{i.AttemptId}")'>@L(i.ReviewStatus == ReviewStatus.Completed ? "view" : "reviewAction")</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ReviewQueueItemDto>? _items;
    private bool _includeCompleted;
    private string? _error;

    private string L(string key) => Lang.T($"challenges.admin.{key}");

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0) await Lang.InitializeAsync();
        await LoadAsync();
    }

    private async Task ToggleCompletedAsync()
    {
        _includeCompleted = !_includeCompleted;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (items, error) = await AuthApi.GetChallengeReviewQueueAsync(_includeCompleted);
        _items = items;
        _error = error == null ? null : error == "forbidden" ? "forbidden" : "genericError";
    }
}
