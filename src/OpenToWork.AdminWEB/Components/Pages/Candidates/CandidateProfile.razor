    private bool HasStageNotes(int stage)
    {
        if (Recruitment == null) return false;
        return stage switch
        {
            1 => Recruitment.InvestigationChecklist.Any(c => c.IsCompleted || !string.IsNullOrEmpty(c.Notes)),
            2 => Recruitment.TechnicalEvaluations.Count > 0,
            3 => Recruitment.CulturalInterviews.Count > 0,
            _ => false
        };
    }

