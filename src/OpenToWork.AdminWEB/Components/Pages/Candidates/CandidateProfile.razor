@page "/candidates/profile/{UserId:guid}"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@(Profile?.CandidateName ?? Lang.T("admin.profile.title"))</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@(Profile?.CandidateName ?? Lang.T("admin.profile.title"))</h1>
        <p class="admin-page-header-subtitle">@(Profile?.Title ?? "")</p>
    </div>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoBack">@Lang.T("admin.dashboard.backToDashboard")</button>
    </div>
</div>

@if (Profile == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else
{
    @* === Pipeline stepper === *@
    <div class="admin-candidate-pipeline-bar">
        @if (Recruitment == null)
        {
            <div class="admin-pipeline-bar-empty">
                <span>@Lang.T("admin.recruitment.noProcess")</span>
                <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="StartInvestigation">
                    @Lang.T("admin.recruitment.investigate")
                </button>
            </div>
        }
        else if (Recruitment.Dismissal != null)
        {
            <div class="admin-pipeline-bar-dismissed">
                <span class="admin-result-badge admin-result-badge--danger">@Lang.T("admin.recruitment.dismissed")</span>
            </div>
        }
        else
        {
            <div class="admin-pipeline-stepper-inline">
                @for (int i = 0; i <= 4; i++)
                {
                    var stageClass = i < Recruitment.CurrentStage ? "admin-pipeline-step--done" :
                        i == Recruitment.CurrentStage ? "admin-pipeline-step--active" : "";
                    <div class="admin-pipeline-step @stageClass">
                        <div class="admin-pipeline-step-circle">
                            @if (i < Recruitment.CurrentStage)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="14" height="14"><polyline points="20 6 9 17 4 12" /></svg>
                            }
                            else
                            {
                                @(i + 1)
                            }
                        </div>
                        <span class="admin-pipeline-step-label">@GetStageName(i)</span>
                    </div>
                    @if (i < 4)
                    {
                        <div class="admin-pipeline-step-line @(i < Recruitment.CurrentStage ? "admin-pipeline-step-line--done" : "")"></div>
                    }
                }
            </div>
            <div class="admin-pipeline-bar-actions">
                @if (Recruitment.CurrentStage < 4)
                {
                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="MoveToNextStage">
                        @Lang.T("admin.recruitment.moveToNext") → @GetStageName(Recruitment.CurrentStage + 1)
                    </button>
                }
                <a href="/candidates/pipeline/@UserId" class="ot-btn ot-btn--outline ot-btn--small">
                    @Lang.T("admin.recruitment.detailTitle")
                </a>
            </div>
        }
    </div>

    <div class="admin-candidate-profile-split">
        @* === Left panel 35% — Personal data === *@
        <div class="admin-candidate-profile-left">
            <div class="admin-profile-header-card">
                <div class="admin-profile-avatar">
                    @if (!string.IsNullOrEmpty(Profile.ProfilePictureUrl))
                    {
                        <img src="@Profile.ProfilePictureUrl" alt="avatar" />
                    }
                    else
                    {
                        <span>@AvatarText</span>
                    }
                </div>
                <div class="admin-profile-header-info">
                    <h2>@(Profile.CandidateName ?? Profile.Email)</h2>
                    <p class="admin-profile-header-title">@(Profile.Title ?? "")</p>
                    <div class="admin-profile-header-badges">
                        @if (Profile.IsActive)
                        {
                            <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.candidates.active")</span>
                        }
                        else
                        {
                            <span class="admin-result-badge admin-result-badge--muted">@Lang.T("admin.candidates.inactive")</span>
                        }
                        @if (Profile.WizardCompleted == true)
                        {
                            <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.dashboard.evaluated")</span>
                        }
                        else
                        {
                            <span class="admin-result-badge admin-result-badge--warning">@Lang.T("admin.dashboard.pending")</span>
                        }
                    </div>
                </div>
            </div>

            <div class="admin-profile-section">
                <h3 class="admin-profile-section-title">@Lang.T("admin.profile.contactInfo")</h3>
                <div class="admin-profile-info-list">
                    <div class="admin-profile-info-row">
                        <span class="admin-profile-info-label">@Lang.T("admin.profile.email")</span>
                        <span class="admin-profile-info-value">@Profile.Email</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Profile.Phone))
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.phone")</span>
                            <span class="admin-profile-info-value">@Profile.Phone</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Profile.Country))
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.location")</span>
                            <span class="admin-profile-info-value">@(Profile.City), @(Profile.Country)</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Profile.Address))
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.address")</span>
                            <span class="admin-profile-info-value">@Profile.Address</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Profile.Identification))
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.recruitment.identification")</span>
                            <span class="admin-profile-info-value">@Profile.Identification</span>
                        </div>
                    }
                    @if (Profile.BirthDate.HasValue)
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.recruitment.birthDate")</span>
                            <span class="admin-profile-info-value">@Profile.BirthDate.Value.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="admin-profile-section">
                <h3 class="admin-profile-section-title">@Lang.T("admin.profile.accountInfo")</h3>
                <div class="admin-profile-info-list">
                    <div class="admin-profile-info-row">
                        <span class="admin-profile-info-label">@Lang.T("admin.profile.createdAt")</span>
                        <span class="admin-profile-info-value">@Profile.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                    @if (Profile.LastLoginAt.HasValue)
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.lastLogin")</span>
                            <span class="admin-profile-info-value">@Profile.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    }
                    @if (Profile.CompletedAt.HasValue)
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.completedAt")</span>
                            <span class="admin-profile-info-value">@Profile.CompletedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</span>
                        </div>
                    }
                    @if (Profile.YearsOfExperience.HasValue)
                    {
                        <div class="admin-profile-info-row">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.yearsExperience")</span>
                            <span class="admin-profile-info-value">@Profile.YearsOfExperience.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* === Right panel 65% — Recruitment data === *@
        <div class="admin-candidate-profile-right">
            @if (!string.IsNullOrEmpty(Profile.Summary))
            {
                <div class="admin-profile-section">
                    <h3 class="admin-profile-section-title">@Lang.T("admin.profile.summary")</h3>
                    <p class="admin-profile-summary">@Profile.Summary</p>
                </div>
            }

            <div class="admin-profile-section">
                <h3 class="admin-profile-section-title">@Lang.T("admin.recruitment.recruitmentInfo")</h3>
                <div class="admin-profile-info-grid">
                    @if (!string.IsNullOrEmpty(Profile.LinkedInUrl))
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">LinkedIn</span>
                            <span class="admin-profile-info-value"><a href="@Profile.LinkedInUrl" target="_blank">@Lang.T("admin.recruitment.viewProfile")</a></span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Profile.PortfolioUrl))
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">@Lang.T("admin.profile.portfolio")</span>
                            <span class="admin-profile-info-value"><a href="@Profile.PortfolioUrl" target="_blank">@Lang.T("admin.recruitment.viewProfile")</a></span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Profile.CvUrl))
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">CV</span>
                            <span class="admin-profile-info-value"><a href="@Profile.CvUrl" target="_blank">@Lang.T("admin.recruitment.viewCV")</a></span>
                        </div>
                    }
                    @if (Profile.Availability.HasValue)
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">@Lang.T("admin.recruitment.availability")</span>
                            <span class="admin-profile-info-value">@GetAvailability(Profile.Availability.Value)</span>
                        </div>
                    }
                    @if (Profile.WorkAuthorization.HasValue)
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">@Lang.T("admin.recruitment.workAuthorization")</span>
                            <span class="admin-profile-info-value">@GetWorkAuthorization(Profile.WorkAuthorization.Value)</span>
                        </div>
                    }
                    @if (Profile.IsProfilePublic.HasValue)
                    {
                        <div class="admin-profile-info-item">
                            <span class="admin-profile-info-label">@Lang.T("admin.recruitment.profileVisibility")</span>
                            <span class="admin-profile-info-value">@(Profile.IsProfilePublic.Value ? Lang.T("admin.recruitment.public") : Lang.T("admin.recruitment.private"))</span>
                        </div>
                    }
                </div>
            </div>

            @if (Profile.Skills.Count > 0)
            {
                <div class="admin-profile-section">
                    <h3 class="admin-profile-section-title">@Lang.T("admin.profile.skills") (@Profile.Skills.Count)</h3>
                    <div class="admin-profile-badges">
                        @foreach (var skill in Profile.Skills)
                        {
                            <span class="admin-result-badge admin-result-badge--info">@skill.Name</span>
                        }
                    </div>
                </div>
            }

            @if (Profile.Experiences.Count > 0)
            {
                <div class="admin-profile-section">
                    <h3 class="admin-profile-section-title">@Lang.T("admin.profile.experience") (@Profile.Experiences.Count)</h3>
                    <div class="admin-profile-timeline">
                        @foreach (var exp in Profile.Experiences)
                        {
                            <div class="admin-profile-timeline-item">
                                <div class="admin-profile-timeline-dot"></div>
                                <div class="admin-profile-timeline-content">
                                    <div class="admin-profile-timeline-title">@exp.JobTitle</div>
                                    <div class="admin-profile-timeline-subtitle">@exp.CompanyName</div>
                                    <div class="admin-profile-timeline-date">
                                        @exp.StartDate.ToString("MMM yyyy") - @(exp.IsCurrentJob ? Lang.T("admin.profile.present") : exp.EndDate?.ToString("MMM yyyy"))
                                        @if (!string.IsNullOrEmpty(exp.Location))
                                        {
                                            <span> · @exp.Location</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(exp.Description))
                                    {
                                        <p class="admin-profile-timeline-desc">@exp.Description</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Profile.Educations.Count > 0)
            {
                <div class="admin-profile-section">
                    <h3 class="admin-profile-section-title">@Lang.T("admin.profile.education") (@Profile.Educations.Count)</h3>
                    <div class="admin-profile-timeline">
                        @foreach (var edu in Profile.Educations)
                        {
                            <div class="admin-profile-timeline-item">
                                <div class="admin-profile-timeline-dot"></div>
                                <div class="admin-profile-timeline-content">
                                    <div class="admin-profile-timeline-title">@edu.Degree</div>
                                    <div class="admin-profile-timeline-subtitle">@edu.Institution</div>
                                    @if (!string.IsNullOrEmpty(edu.FieldOfStudy))
                                    {
                                        <div class="admin-profile-timeline-subtitle">@edu.FieldOfStudy</div>
                                    }
                                    <div class="admin-profile-timeline-date">
                                        @(edu.StartDate?.ToString("MMM yyyy") ?? "-") - @(edu.IsInProgress ? Lang.T("admin.profile.inProgress") : edu.EndDate?.ToString("MMM yyyy") ?? "-")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Profile.Certifications.Count > 0)
            {
                <div class="admin-profile-section">
                    <h3 class="admin-profile-section-title">@Lang.T("admin.profile.certifications") (@Profile.Certifications.Count)</h3>
                    <div class="admin-profile-cert-grid">
                        @foreach (var cert in Profile.Certifications)
                        {
                            <div class="admin-profile-cert-card">
                                <div class="admin-profile-cert-name">@cert.Name</div>
                                @if (!string.IsNullOrEmpty(cert.Issuer))
                                {
                                    <div class="admin-profile-cert-issuer">@cert.Issuer</div>
                                }
                                @if (cert.IssueDate.HasValue)
                                {
                                    <div class="admin-profile-cert-date">@cert.IssueDate.Value.ToString("MMM yyyy")</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* === Investigation checklist (when in Investigation stage) === *@
        @if (Recruitment != null && Recruitment.Dismissal == null && Recruitment.CurrentStage == 1)
        {
            <div class="admin-profile-section admin-investigation-section">
                <h3 class="admin-profile-section-title">
                    @Lang.T("admin.recruitment.investigationChecklist")
                    <span class="admin-skill-count" style="margin-left: 0.5rem;">
                        @Recruitment.InvestigationChecklist.Count(c => c.IsCompleted) / @Recruitment.InvestigationChecklist.Count
                    </span>
                </h3>
                <div class="admin-investigation-list">
                    @foreach (var item in Recruitment.InvestigationChecklist.OrderBy(c => c.Step))
                    {
                        <div class="admin-investigation-item @(item.IsCompleted ? "admin-investigation-item--done" : "")">
                            <div class="admin-investigation-check">
                                <input type="checkbox" checked="@item.IsCompleted" @onchange="() => ToggleStep(item)" />
                            </div>
                            <div class="admin-investigation-content">
                                <div class="admin-investigation-step-name">@(item.Label ?? GetInvestigationStepName(item.Step))</div>
                                @if (item.IsCustom)
                                {
                                    <span class="admin-result-badge admin-result-badge--info" style="margin-left: 0.5rem; font-size: 0.65rem;">Custom</span>
                                }
                                @if (item.IsCompleted)
                                {
                                    <div class="admin-investigation-meta">
                                        @Lang.T("admin.recruitment.completedBy") @item.CompletedByName · @item.CompletedAt?.ToString("yyyy-MM-dd HH:mm")
                                    </div>
                                }
                            </div>
                            @if (item.IsCustom)
                            {
                                <button class="admin-row-btn" title="Eliminar" @onclick="() => DeleteCustomValidation(item.Id)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                        <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                </button>
                            }
                        </div>
                    }

                    @* Add custom validation *@
                    <div class="admin-investigation-add">
                        <input type="text" @bind="NewValidationLabel" placeholder="@Lang.T("admin.recruitment.addValidationPlaceholder")" class="admin-investigation-add-input" />
                        <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrWhiteSpace(NewValidationLabel)" @onclick="AddCustomValidation">
                            @Lang.T("admin.recruitment.addValidation")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @* === Assign modal === *@
    @if (ShowAssign)
    {
        <div class="admin-modal-overlay" @onclick='() => ShowAssign = false'>
            <div class="admin-modal" @onclick:stopPropagation="true">
                <h3 class="admin-modal-title">@Lang.T("admin.recruitment.assignCandidate")</h3>
                <div class="admin-modal-body">
                    <label>@Lang.T("admin.recruitment.assignTo")</label>
                    <select @bind="SelectedAssignToUserId" class="admin-modal-select">
                        <option value="">@Lang.T("admin.recruitment.selectUser")</option>
                        @foreach (var u in AssignableUsers)
                        {
                            <option value="@u.Id">@u.Email</option>
                        }
                    </select>
                </div>
                <div class="admin-modal-actions">
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => ShowAssign = false'>@Lang.T("admin.common.cancel")</button>
                    <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrEmpty(SelectedAssignToUserId)" @onclick="ConfirmAssign">
                        @Lang.T("admin.recruitment.confirmAssign")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }
    private AdminUserProfileDto? Profile { get; set; }
    private RecruitmentDetailDto? Recruitment { get; set; }
    private List<AdminUserDto> AssignableUsers { get; set; } = new();
    private bool ShowAssign { get; set; }
    private string SelectedAssignToUserId { get; set; } = "";
    private string NewValidationLabel { get; set; } = "";

    private string AvatarText
    {
        get
        {
            var name = Profile?.CandidateName ?? Profile?.Email ?? "";
            return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var token = await LocalStorage.GetItemAsync("otwadmin-token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        Profile = await AuthApi.GetUserProfileAsync(UserId);
        Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        AssignableUsers = await AuthApi.GetUsersAsync(1, 100, 2);
    }

    private void GoBack() => Nav.NavigateTo("/candidates");

    private async Task StartInvestigation()
    {
        ShowAssign = true;
    }

    private async Task ConfirmAssign()
    {
        if (string.IsNullOrEmpty(SelectedAssignToUserId)) return;
        var assignToId = Guid.Parse(SelectedAssignToUserId);
        var result = await AuthApi.AssignCandidateAsync(new AssignCandidateDto
        {
            UserId = UserId,
            AssignedToUserId = assignToId
        });
        if (result != null)
        {
            ShowAssign = false;
            Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        }
    }

    private async Task MoveToNextStage()
    {
        if (Recruitment == null) return;
        var ok = await AuthApi.MoveStageAsync(Recruitment.Id, Recruitment.CurrentStage + 1);
        if (ok)
        {
            Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        }
    }

    private async Task ToggleStep(InvestigationChecklistDto item)
    {
        if (Recruitment == null) return;
        var ok = await AuthApi.ToggleInvestigationStepAsync(Recruitment.Id, new ToggleInvestigationStepDto
        {
            Step = item.Step,
            IsCompleted = !item.IsCompleted
        });
        if (ok)
        {
            Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        }
    }

    private async Task AddCustomValidation()
    {
        if (Recruitment == null || string.IsNullOrWhiteSpace(NewValidationLabel)) return;
        var result = await AuthApi.AddCustomValidationAsync(Recruitment.Id, NewValidationLabel.Trim());
        if (result != null)
        {
            NewValidationLabel = "";
            Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        }
    }

    private async Task DeleteCustomValidation(Guid checklistId)
    {
        var ok = await AuthApi.DeleteCustomValidationAsync(checklistId);
        if (ok)
        {
            Recruitment = await AuthApi.GetRecruitmentByUserAsync(UserId);
        }
    }

    private string GetInvestigationStepName(int step) => step switch
    {
        0 => Lang.T("admin.recruitment.invStep0"),
        1 => Lang.T("admin.recruitment.invStep1"),
        2 => Lang.T("admin.recruitment.invStep2"),
        3 => Lang.T("admin.recruitment.invStep3"),
        4 => Lang.T("admin.recruitment.invStep4"),
        _ => ""
    };

    private string GetStageName(int stage) => stage switch
    {
        0 => Lang.T("admin.recruitment.stage0"),
        1 => Lang.T("admin.recruitment.stage1"),
        2 => Lang.T("admin.recruitment.stage2"),
        3 => Lang.T("admin.recruitment.stage3"),
        4 => Lang.T("admin.recruitment.stage4"),
        5 => Lang.T("admin.recruitment.stage5"),
        _ => ""
    };

    private string GetAvailability(int a) => a switch
    {
        0 => Lang.T("admin.recruitment.availImmediate"),
        1 => Lang.T("admin.recruitment.avail15"),
        2 => Lang.T("admin.recruitment.avail30"),
        3 => Lang.T("admin.recruitment.avail60"),
        _ => "—"
    };

    private string GetWorkAuthorization(int w) => w switch
    {
        0 => Lang.T("admin.recruitment.authCitizen"),
        1 => Lang.T("admin.recruitment.authResident"),
        2 => Lang.T("admin.recruitment.authVisa"),
        3 => Lang.T("admin.recruitment.authNone"),
        _ => "—"
    };
}
