@page "/candidates"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@Lang.T("admin.candidates.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.candidates.title")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.candidates.subtitle")</p>
    </div>
    <div class="admin-page-actions">
        <button type="button" class="ot-btn ot-btn--primary ot-btn--small" @onclick="GoToRegister">
            + Registrar Candidato
        </button>
        <button type="button" class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoToSearchLinkedin">
            Buscar LinkedIn
        </button>
        <button type="button" class="ot-btn ot-btn--outline ot-btn--small" @onclick="ExportCsv" disabled="@IsExporting">
            @Lang.T("admin.candidates.exportCsv")
        </button>
    </div>
</div>

@* === Tabs === *@
<div class="admin-tabs">
    <button class="admin-tab @(ActiveTab == "notStarted" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("notStarted")'>
        @Lang.T("admin.candidates.tabNotStarted")
        @if (TabCounts.TryGetValue("notStarted", out var nsCount) && nsCount > 0)
        {
            <span class="admin-tab-badge">@nsCount</span>
        }
    </button>
    <button class="admin-tab @(ActiveTab == "inProcess" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("inProcess")'>
        @Lang.T("admin.candidates.tabInProcess")
        @if (TabCounts.TryGetValue("inProcess", out var ipCount) && ipCount > 0)
        {
            <span class="admin-tab-badge admin-tab-badge--info">@ipCount</span>
        }
    </button>
    <button class="admin-tab @(ActiveTab == "finished" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("finished")'>
        @Lang.T("admin.candidates.tabFinished")
        @if (TabCounts.TryGetValue("finished", out var fCount) && fCount > 0)
        {
            <span class="admin-tab-badge admin-tab-badge--success">@fCount</span>
        }
    </button>
    <button class="admin-tab @(ActiveTab == "dismissed" ? "admin-tab--active" : "")" @onclick='() => SwitchTab("dismissed")'>
        @Lang.T("admin.candidates.tabDismissed")
        @if (TabCounts.TryGetValue("dismissed", out var dCount) && dCount > 0)
        {
            <span class="admin-tab-badge admin-tab-badge--danger">@dCount</span>
        }
    </button>
</div>

<div class="admin-users-toolbar">
    <div class="admin-users-toolbar-row">
        <div class="admin-users-search">
            <input type="text" @bind="SearchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" placeholder="@Lang.T("admin.candidates.searchPlaceholder")" />
        </div>
        <label class="admin-select-all">
            <input type="checkbox" @onchange="ToggleSelectAll" checked="@IsAllSelected" />
            @Lang.T("admin.candidates.selectAll")
        </label>
        <div class="admin-sort-controls">
            <select class="admin-sort-select" @bind="SortColumn" @bind:after="LoadData">
                <option value="date">@Lang.T("admin.candidates.sortDate")</option>
                <option value="name">@Lang.T("admin.candidates.sortName")</option>
                <option value="email">@Lang.T("admin.candidates.sortEmail")</option>
                <option value="skills">@Lang.T("admin.candidates.sortSkills")</option>
                <option value="experience">@Lang.T("admin.candidates.sortExperience")</option>
                <option value="applications">@Lang.T("admin.candidates.sortApplications")</option>
            </select>
            <button type="button" class="admin-sort-dir" @onclick="ToggleSortDirection" title="@Lang.T("admin.candidates.sortBy")">
                @(SortDesc ? "↓" : "↑")
            </button>
        </div>
    </div>
</div>

@if (SelectedIds.Count > 0)
{
    <div class="admin-bulk-actions">
        <span class="admin-bulk-count">@SelectedIds.Count @Lang.T("admin.candidates.selected")</span>
        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="BulkActivate">
            @Lang.T("admin.candidates.bulkActivate")
        </button>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="BulkDeactivate">
            @Lang.T("admin.candidates.bulkDeactivate")
        </button>
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ClearSelection">
            @Lang.T("admin.common.cancel")
        </button>
    </div>
}

@if (IsLoading)
{
    <div class="admin-loading">@Lang.T("admin.candidates.loading")</div>
}
else if (Result == null || Result.Items.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-text">@Lang.T("admin.candidates.empty")</div>
    </div>
}
else
{
    <div class="admin-oneui-list">
        @foreach (var c in Result.Items)
        {
            <div class="admin-oneui-item @(c.IsActive ? "" : "admin-oneui-item--inactive")">
                <input type="checkbox" class="admin-candidate-check" checked="@SelectedIds.Contains(c.Id)" @onchange="() => ToggleSelect(c.Id)" />

                @if (c.OverallScore.HasValue)
                {
                    <div class="admin-score-circle @(c.OverallScore.Value >= 70 ? "admin-score-circle--high" : c.OverallScore.Value >= 40 ? "admin-score-circle--mid" : "admin-score-circle--low")">
                        @c.OverallScore.Value
                    </div>
                }
                else
                {
                    <div class="admin-score-circle admin-score-circle--none">—</div>
                }

                <div class="admin-oneui-avatar">@(GetInitials(c.FullName))</div>

                <div class="admin-oneui-body">
                    <div class="admin-oneui-title">
                        <span class="admin-candidate-link" @onclick="() => ViewProfile(c.Id)">@c.FullName</span>
                        @if (c.IsVerifiedTD)
                        {
                            <span class="admin-verified-badge" title="Verificado TD">
                                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                </svg>
                            </span>
                        }
                        @if (c.WizardCompleted)
                        {
                            <span class="admin-result-badge admin-result-badge--success">@Lang.T("admin.candidates.filterEvaluated")</span>
                        }
                        else
                        {
                            <span class="admin-result-badge admin-result-badge--muted">@Lang.T("admin.candidates.filterPending")</span>
                        }
                        @if (!c.IsActive)
                        {
                            <span class="admin-result-badge admin-result-badge--danger">@Lang.T("admin.candidates.inactive")</span>
                        }
                        <PlacementBadge Placement="c.Placement" />
                    </div>
                    <div class="admin-oneui-subtitle">
                        <span>@c.Email</span>
                        @if (!string.IsNullOrEmpty(c.Title))
                        {
                            <span>· @c.Title</span>
                        }
                        <span>· @c.CreatedAt.ToString("yyyy-MM-dd")</span>
                    </div>
                    @if (c.TopSkills.Any())
                    {
                        <div class="admin-skill-tags">
                            @foreach (var skill in c.TopSkills)
                            {
                                <span class="admin-skill-tag">@skill</span>
                            }
                        </div>
                    }
                </div>

                <div class="admin-oneui-meta">
                    <div class="admin-candidate-stat">
                        <span class="admin-candidate-stat-value">@c.SkillCount</span>
                        <span class="admin-candidate-stat-label">@Lang.T("admin.candidates.columnSkills")</span>
                    </div>
                    <div class="admin-candidate-stat">
                        <span class="admin-candidate-stat-value">@c.ExperienceCount</span>
                        <span class="admin-candidate-stat-label">@Lang.T("admin.candidates.columnExperience")</span>
                    </div>
                    <div class="admin-candidate-stat">
                        <span class="admin-candidate-stat-value">@c.ApplicationCount</span>
                        <span class="admin-candidate-stat-label">@Lang.T("admin.candidates.columnApplications")</span>
                    </div>
                    <div class="admin-candidate-docs">
                        <span class="admin-candidate-doc @(c.HasLinkedIn ? "admin-candidate-doc--on" : "")" title="LinkedIn">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.09h4.56V24H.22V8.09zM8.34 8.09h4.37v2.18h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7v9.1h-4.55v-8.07c0-1.93-.04-4.41-2.69-4.41-2.69 0-3.1 2.1-3.1 4.27V24H8.34V8.09z"/></svg>
                        </span>
                        <span class="admin-candidate-doc @(c.HasPortfolio ? "admin-candidate-doc--on" : "")" title="Portfolio">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                        </span>
                        <span class="admin-candidate-doc @(c.HasCV ? "admin-candidate-doc--on" : "")" title="CV">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </span>
                    </div>
                    <div class="admin-row-actions">
                        @if (ActiveTab == "notStarted")
                        {
                            <button class="admin-row-btn admin-row-btn--primary" title="@Lang.T("admin.recruitment.assignCandidate")" @onclick="() => ShowAssignModal(c.Id, c.FullName)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />
                                </svg>
                            </button>
                        }
                        @if (ActiveTab == "inProcess" || ActiveTab == "finished")
                        {
                            <button class="admin-row-btn admin-row-btn--primary" title="@Lang.T("admin.recruitment.detailTitle")" @onclick="() => ViewPipeline(c.Id)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                    <rect x="3" y="3" width="6" height="18" rx="1" /><rect x="9" y="3" width="6" height="12" rx="1" /><rect x="15" y="3" width="6" height="6" rx="1" />
                                </svg>
                            </button>
                        }
                        <button class="admin-row-btn" title="@Lang.T("admin.candidates.viewProfile")" @onclick="() => ViewProfile(c.Id)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Result.TotalPages > 1)
    {
        <div class="admin-pagination">
            <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">
                @Lang.T("admin.candidates.prev")
            </button>
            <span>@Lang.T("admin.candidates.page") @CurrentPage @Lang.T("admin.candidates.of") @Result.TotalPages</span>
            <button class="ot-btn ot-btn--outline ot-btn--small" disabled="@(CurrentPage >= Result.TotalPages)" @onclick="NextPage">
                @Lang.T("admin.candidates.next")
            </button>
        </div>
    }
}

@* === Assign Modal === *@
@if (ShowAssign)
{
    <div class="admin-modal-overlay" @onclick="CloseAssignModal">
        <div class="admin-modal" @onclick:stopPropagation="true">
            <h3 class="admin-modal-title">@Lang.T("admin.recruitment.assignCandidate")</h3>
            <div class="admin-modal-body">
                <div class="admin-assign-candidate-name">@AssignCandidateName</div>
                <label>@Lang.T("admin.recruitment.assignTo")</label>
                @if (AssignableUsers.Count == 0)
                {
                    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
                }
                else
                {
                    <select @bind="SelectedAssignToUserId" class="admin-modal-select">
                        <option value="">@Lang.T("admin.recruitment.selectUser")</option>
                        @foreach (var u in AssignableUsers)
                        {
                            <option value="@u.Id.ToString()">@u.Email</option>
                        }
                    </select>
                }
                <label>@Lang.T("admin.recruitment.dismissNotes")</label>
                <textarea @bind="AssignNotes" rows="2" class="admin-modal-textarea"></textarea>
            </div>
            <div class="admin-modal-actions">
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseAssignModal">@Lang.T("admin.common.cancel")</button>
                <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrEmpty(SelectedAssignToUserId)" @onclick="ConfirmAssign">
                    @Lang.T("admin.recruitment.confirmAssign")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CandidateConsoleResultDto? Result { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsExporting { get; set; }
    private string SearchTerm { get; set; } = "";
    private string ActiveTab { get; set; } = "notStarted";
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 20;
    private string SortColumn { get; set; } = "date";
    private bool SortDesc { get; set; } = true;
    private HashSet<Guid> SelectedIds { get; set; } = new();
    private CancellationTokenSource? _searchCts;
    private Dictionary<string, int> TabCounts { get; set; } = new();

    private bool ShowAssign { get; set; }
    private Guid AssignCandidateId { get; set; }
    private string AssignCandidateName { get; set; } = "";
    private List<AdminUserDto> AssignableUsers { get; set; } = new();
    private string SelectedAssignToUserId { get; set; } = "";
    private string AssignNotes { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await LoadData();
        await LoadTabCounts();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();

        Result = await AuthApi.GetCandidatesAsync(
            CurrentPage, PageSize,
            string.IsNullOrWhiteSpace(SearchTerm) ? null : SearchTerm,
            null, null, null, null, null,
            null, SortColumn, SortDesc, ActiveTab);

        IsLoading = false;
        StateHasChanged();
    }

    private async Task LoadTabCounts()
    {
        TabCounts.Clear();
        foreach (var tab in new[] { "notStarted", "inProcess", "finished", "dismissed" })
        {
            var data = await AuthApi.GetCandidatesAsync(1, 1, null, null, null, null, null, null, null, null, true, tab);
            if (data != null)
                TabCounts[tab] = data.TotalCount;
        }
        StateHasChanged();
    }

    private async Task SwitchTab(string tab)
    {
        ActiveTab = tab;
        CurrentPage = 1;
        SelectedIds.Clear();
        await LoadData();
    }

    private async void OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        CurrentPage = 1;
        await LoadData();
    }

    private async Task SortByColumn(string column)
    {
        if (SortColumn == column)
            SortDesc = !SortDesc;
        else
        {
            SortColumn = column;
            SortDesc = true;
        }
        await LoadData();
    }

    private void SortBy(string column) => _ = SortByColumn(column);

    private async Task ToggleSortDirection()
    {
        SortDesc = !SortDesc;
        await LoadData();
    }

    private async Task PrevPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (Result != null && CurrentPage < Result.TotalPages)
        {
            CurrentPage++;
            await LoadData();
        }
    }

    private void ToggleSelect(Guid id)
    {
        if (SelectedIds.Contains(id))
            SelectedIds.Remove(id);
        else
            SelectedIds.Add(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked && Result != null)
            SelectedIds = new HashSet<Guid>(Result.Items.Select(c => c.Id));
        else
            SelectedIds.Clear();
    }

    private bool IsAllSelected => Result != null && Result.Items.Count > 0 && Result.Items.All(c => SelectedIds.Contains(c.Id));

    private void ClearSelection()
    {
        SelectedIds.Clear();
        StateHasChanged();
    }

    private async Task BulkActivate()
    {
        if (SelectedIds.Count == 0) return;
        var ok = await AuthApi.BulkActivateCandidatesAsync(SelectedIds.ToList());
        if (ok)
        {
            SelectedIds.Clear();
            await LoadData();
        }
    }

    private async Task BulkDeactivate()
    {
        if (SelectedIds.Count == 0) return;
        var ok = await AuthApi.BulkDeactivateCandidatesAsync(SelectedIds.ToList());
        if (ok)
        {
            SelectedIds.Clear();
            await LoadData();
        }
    }

    private void ViewProfile(Guid id)
    {
        Nav.NavigateTo($"/candidates/profile/{id}");
    }

    private void ViewPipeline(Guid candidateId)
    {
        Nav.NavigateTo($"/candidates/pipeline/{candidateId}");
    }

    private void GoToRegister()
    {
        Nav.NavigateTo("/candidates/register");
    }

    private void GoToSearchLinkedin()
    {
        Nav.NavigateTo("/candidates/search-linkedin");
    }

    private async Task ExportCsv()
    {
        IsExporting = true;
        StateHasChanged();
        var bytes = await AuthApi.ExportCandidatesCsvAsync();
        if (bytes != null)
        {
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("fileDownload.save", $"candidates-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", base64);
        }
        IsExporting = false;
        StateHasChanged();
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }

    private async Task ShowAssignModal(Guid candidateId, string candidateName)
    {
        AssignCandidateId = candidateId;
        AssignCandidateName = candidateName;
        SelectedAssignToUserId = "";
        AssignNotes = "";
        ShowAssign = true;
        AssignableUsers = await AuthApi.GetUsersAsync(1, 100, 2);
        StateHasChanged();
    }

    private void CloseAssignModal()
    {
        ShowAssign = false;
        StateHasChanged();
    }

    private async Task ConfirmAssign()
    {
        if (string.IsNullOrEmpty(SelectedAssignToUserId)) return;
        var assignToId = Guid.Parse(SelectedAssignToUserId);
        var result = await AuthApi.AssignCandidateAsync(new AssignCandidateDto
        {
            UserId = AssignCandidateId,
            AssignedToUserId = assignToId,
            Notes = string.IsNullOrWhiteSpace(AssignNotes) ? null : AssignNotes
        });
        if (result != null)
        {
            ShowAssign = false;
            await LoadData();
            await LoadTabCounts();
        }
    }
}
