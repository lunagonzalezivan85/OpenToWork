@page "/candidates/search-linkedin"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Buscar en LinkedIn</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>Buscar en LinkedIn</h1>
        <p class="admin-page-header-subtitle">Encuentra perfiles de LinkedIn por pais, ciudad y puesto</p>
    </div>
    <div class="admin-page-actions">
        <button type="button" class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoBack">
            Volver
        </button>
    </div>
</div>

<div class="ot-card" style="max-width: 900px; margin-bottom: var(--space-lg);">
    <div style="padding: var(--space-xl);">
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-md); margin-bottom: var(--space-md);">
            <div class="ot-form-group" style="margin-bottom: 0;">
                <label class="ot-form-label">Puesto</label>
                <input type="text" @bind="SearchPosition" class="ot-form-input" placeholder="Ej: camarero, desarrollador..." />
            </div>
            <div class="ot-form-group" style="margin-bottom: 0;">
                <label class="ot-form-label">Ciudad</label>
                <input type="text" @bind="SearchCity" class="ot-form-input" placeholder="Ej: Madrid, Bogota..." />
            </div>
            <div class="ot-form-group" style="margin-bottom: 0;">
                <label class="ot-form-label">Pais</label>
                <input type="text" @bind="SearchCountry" class="ot-form-input" placeholder="Ej: Espana, Colombia..." />
            </div>
        </div>

        <div style="display: flex; gap: var(--space-md); align-items: center;">
            <button type="button" class="ot-btn ot-btn--primary" @onclick="Search" disabled="@IsSearching">
                @if (IsSearching)
                {
                    <span>Buscando...</span>
                }
                else
                {
                    <span>Buscar</span>
                }
            </button>
            @if (SearchResults != null && SearchResults.Count > 0)
            {
                <span style="font-size: 0.82rem; color: var(--text-secondary, #3A506B);">
                    @SearchResults.Count resultados encontrados
                </span>
            }
        </div>
    </div>
</div>

@if (IsSearching)
{
    <div class="ot-card" style="max-width: 900px;">
        <div style="padding: var(--space-xl); text-align: center;">
            <div style="display: inline-block; width: 36px; height: 36px; border: 3px solid var(--accent-light, #E8F1FF); border-top-color: var(--accent-primary, #0066FF); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: var(--space-md);"></div>
            <p style="color: var(--text-secondary, #3A506B); font-size: 0.88rem;">Buscando perfiles en LinkedIn...</p>
        </div>
    </div>
}

@if (SearchResults != null && SearchResults.Count > 0)
{
    <div style="display: flex; flex-direction: column; gap: var(--space-md); max-width: 900px;">
        @foreach (var profile in SearchResults)
        {
            <div class="ot-card" style="cursor: pointer;" @onclick="() => OpenProfile(profile.Url)">
                <div style="padding: var(--space-md) var(--space-lg); display: flex; align-items: flex-start; gap: var(--space-md);">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: var(--accent-light, #E8F1FF); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" style="color: var(--accent-primary, #0066FF);">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect x="2" y="9" width="4" height="12" />
                            <circle cx="4" cy="4" r="2" />
                        </svg>
                    </div>
                    <div style="flex: 1; min-width: 0;">
                        <h4 style="font-size: 0.92rem; font-weight: 600; margin-bottom: 4px;">@profile.Name</h4>
                        @if (!string.IsNullOrEmpty(profile.Title))
                        {
                            <p style="font-size: 0.82rem; color: var(--text-secondary, #3A506B); margin-bottom: 4px;">@profile.Title</p>
                        }
                        @if (!string.IsNullOrEmpty(profile.Snippet))
                        {
                            <p style="font-size: 0.8rem; color: var(--text-muted, #778DA9); line-height: 1.5;">@profile.Snippet</p>
                        }
                        <p style="font-size: 0.78rem; color: var(--accent-primary, #0066FF); margin-top: 6px; word-break: break-all;">@profile.Url</p>
                    </div>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="color: var(--text-muted, #778DA9); flex-shrink: 0; margin-top: 4px;">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                </div>
            </div>
        }
    </div>
}
else if (SearchResults != null && SearchResults.Count == 0 && !IsSearching)
{
    <div class="ot-card" style="max-width: 900px;">
        <div style="padding: var(--space-xl); text-align: center;">
            <p style="color: var(--text-secondary, #3A506B); font-size: 0.88rem;">No se encontraron perfiles. Intenta con otros terminos de busqueda.</p>
        </div>
    </div>
}

<style>
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private string? SearchPosition { get; set; }
    private string? SearchCity { get; set; }
    private string? SearchCountry { get; set; }
    private bool IsSearching { get; set; }
    private List<LinkedinSearchResultDto>? SearchResults { get; set; }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchPosition) && string.IsNullOrWhiteSpace(SearchCity) && string.IsNullOrWhiteSpace(SearchCountry))
        {
            await JS.InvokeVoidAsync("notify.error", "Ingresa al menos un criterio de busqueda");
            return;
        }

        IsSearching = true;
        SearchResults = null;
        StateHasChanged();

        try
        {
            var request = new LinkedinSearchRequestDto
            {
                Position = SearchPosition,
                City = SearchCity,
                Country = SearchCountry
            };

            var response = await AuthApi.SearchLinkedinAsync(request);

            if (response == null || !response.Success)
            {
                await JS.InvokeVoidAsync("notify.error", !string.IsNullOrWhiteSpace(response?.Error) ? response.Error : "Error en la busqueda");
                SearchResults = new List<LinkedinSearchResultDto>();
            }
            else
            {
                SearchResults = response.Results;
                if (SearchResults.Count > 0)
                    await JS.InvokeVoidAsync("notify.success", $"{SearchResults.Count} perfiles encontrados");
                else
                    await JS.InvokeVoidAsync("notify.warning", "No se encontraron perfiles");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("notify.error", $"Error: {ex.Message}");
            SearchResults = new List<LinkedinSearchResultDto>();
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private async Task OpenProfile(string url)
    {
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/candidates");
    }
}
