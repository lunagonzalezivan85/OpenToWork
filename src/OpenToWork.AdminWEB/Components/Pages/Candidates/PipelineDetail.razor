    private string GetWorkAuthLabels(string? was)
    {
        if (string.IsNullOrEmpty(was)) return "—";
        var ids = was.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
        var labels = ids.Select(id => GetWorkAuthLabel(int.TryParse(id, out var v) ? v : 0)).Where(l => l != "—").ToList();
        return labels.Count > 0 ? string.Join(", ", labels) : "—";
    }

