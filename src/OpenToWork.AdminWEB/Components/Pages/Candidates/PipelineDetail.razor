@page "/candidates/pipeline/{UserId:guid}"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.recruitment.detailTitle")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.recruitment.detailTitle")</h1>
        <p class="admin-page-header-subtitle">@(Detail?.FullName ?? "")</p>
    </div>
    <div class="admin-page-actions">
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="GoBack">@Lang.T("admin.dashboard.backToDashboard")</button>
    </div>
</div>

@if (IsLoading)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (Detail == null)
{
    <div class="admin-empty"><div class="admin-empty-text">@Lang.T("admin.recruitment.notFound")</div></div>
}
else
{
    @* === Stepper === *@
    <div class="admin-stepper">
        @for (int i = 0; i <= 4; i++)
        {
            var stageClass = Detail.CurrentStage == 5 ? "admin-stepper-item--dismissed" :
                i < Detail.CurrentStage ? "admin-stepper-item--done" :
                i == Detail.CurrentStage ? "admin-stepper-item--active" : "";
            <div class="admin-stepper-item @stageClass">
                <div class="admin-stepper-circle">
                    @if (i < Detail.CurrentStage && Detail.CurrentStage != 5)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" width="16" height="16"><polyline points="20 6 9 17 4 12" /></svg>
                    }
                    else
                    {
                        @(i + 1)
                    }
                </div>
                <div class="admin-stepper-label">@GetStageName(i)</div>
            </div>
            @if (i < 4)
            {
                <div class="admin-stepper-line @(i < Detail.CurrentStage ? "admin-stepper-line--done" : "")"></div>
            }
        }
    </div>

    @* === Info grid === *@
    <div class="admin-recruitment-grid">
        <div class="admin-recruitment-card">
            <h3 class="admin-recruitment-card-title">@Lang.T("admin.recruitment.candidateInfo")</h3>
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.candidates.columnEmail")</span><strong>@Detail.Email</strong></div>
            @if (!string.IsNullOrEmpty(Detail.Title))
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.candidates.columnTitle")</span><strong>@Detail.Title</strong></div>
            }
            @if (!string.IsNullOrEmpty(Detail.Phone))
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.profile.phone")</span><strong>@Detail.Phone</strong></div>
            }
            @if (!string.IsNullOrEmpty(Detail.Country))
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.profile.location")</span><strong>@(Detail.City), @Detail.Country</strong></div>
            }
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.recruitment.currentStage")</span><strong>@GetStageName(Detail.CurrentStage)</strong></div>
            <div class="admin-recruitment-info-row">
                <span>Vacante</span>
                <strong>
                    @if (Detail.VacancyId.HasValue)
                    {
                        <span>@Detail.VacancyTitle</span>
                        <button class="ot-btn ot-btn--outline ot-btn--small" style="margin-left: 0.5rem; font-size: 0.65rem; padding: 0.15rem 0.5rem;" @onclick="OpenVacancySelector">Cambiar</button>
                    }
                    else
                    {
                        <button class="ot-btn ot-btn--primary ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="OpenVacancySelector">+ Vincular vacante</button>
                    }
                </strong>
            </div>
            <div class="admin-recruitment-info-row">
                <span>Medio de transporte</span>
                <strong style="display: flex; align-items: center; gap: 0.4rem;">
                    <input type="checkbox" checked="@(Detail.HasTransport == true)" @onchange="ToggleTransport" style="width: 18px; height: 18px; cursor: pointer;" />
                    <span style="font-size: 0.85rem;">@(Detail.HasTransport == true ? "Sí" : "No")</span>
                </strong>
            </div>
        </div>

        <div class="admin-recruitment-card">
            <h3 class="admin-recruitment-card-title">
                Info migratoria
                @if (EditingMigration)
                {
                    <button class="ot-btn ot-btn--primary ot-btn--small" style="margin-left: 0.5rem; font-size: 0.7rem;" @onclick="SaveMigrationInfo">Guardar</button>
                    <button class="ot-btn ot-btn--outline ot-btn--small" style="margin-left: 0.25rem; font-size: 0.7rem;" @onclick="() => EditingMigration = false">Cancelar</button>
                }
                else
                {
                    <button class="ot-btn ot-btn--outline ot-btn--small" style="margin-left: 0.5rem; font-size: 0.7rem;" @onclick="EditMigrationInfo">Editar</button>
                }
            </h3>
            @if (EditingMigration)
            {
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
                    <div class="ot-input-group">
                        <label class="ot-input-label">Nacionalidad</label>
                        <input type="text" @bind="EditNationality" class="ot-input-field" placeholder="Ej: Española" />
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">¿Tiene pasaporte?</label>
                        <select @bind="EditHasPassportStr" class="ot-input-field">
                            <option value="">Seleccionar...</option>
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="ot-input-group" style="grid-column: 1 / -1;">
                        <label class="ot-input-label">Permiso de trabajo / Autorización</label>
                        <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.25rem;">
                            @foreach (var opt in WorkAuthOptions)
                            {
                                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                                    <input type="checkbox" checked="@(EditWorkAuthList.Contains(opt.Value))" @onchange="@(e => ToggleWorkAuth(e, opt.Value))" style="width: 18px; height: 18px;" />
                                    <span>@opt.Label</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="admin-recruitment-info-row"><span>Nacionalidad</span><strong>@(Detail.Nationality ?? "—")</strong></div>
                <div class="admin-recruitment-info-row"><span>¿Tiene pasaporte?</span><strong>@(Detail.HasPassport == true ? "Sí" : Detail.HasPassport == false ? "No" : "—")</strong></div>
                @if (!string.IsNullOrEmpty(Detail.PassportNumber))
                {
                    <div class="admin-recruitment-info-row"><span>Nº pasaporte</span><strong>@Detail.PassportNumber</strong></div>
                }
                <div class="admin-recruitment-info-row" style="flex-direction: column; align-items: flex-start; gap: 0.4rem;">
                    <span>Permiso de trabajo / Autorización</span>
                    <strong>@(GetWorkAuthLabels(Detail.WorkAuthorizations))</strong>
                </div>
            }
        </div>

        <div class="admin-recruitment-card">
            <h3 class="admin-recruitment-card-title">@Lang.T("admin.recruitment.assignment")</h3>
            <div class="admin-recruitment-info-row">
                <span>@Lang.T("admin.recruitment.assignedTo")</span>
                <strong>@(Detail.AssignedToName ?? Lang.T("admin.recruitment.unassigned"))</strong>
            </div>
            @if (Detail.AssignedAt.HasValue)
            {
                <div class="admin-recruitment-info-row"><span>@Lang.T("admin.recruitment.assignedAt")</span><strong>@Detail.AssignedAt.Value.ToString("yyyy-MM-dd HH:mm")</strong></div>
            }
            <div class="admin-recruitment-info-row"><span>@Lang.T("admin.recruitment.stageEntered")</span><strong>@(Detail.StageEnteredAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</strong></div>
        </div>
    </div>

    @* === Preferences Form (Stage 0) === *@
    @if (Detail.Dismissal == null && Detail.CurrentStage == 0)
    {
        <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
            <h3 class="admin-recruitment-card-title">
                Preferencias del candidato
                @if (Preferences?.IsCompleted == true)
                {
                    <span class="admin-result-badge admin-result-badge--success" style="margin-left: 0.5rem;">Completado</span>
                }
                else
                {
                    <span class="admin-result-badge admin-result-badge--warning" style="margin-left: 0.5rem;">Pendiente</span>
                }
            </h3>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">Complete estas preferencias antes de avanzar al candidato a la siguiente etapa.</p>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem;">
                <div class="ot-input-group">
                    <label class="ot-input-label">Jornada deseada</label>
                    <select @bind="PrefWorkShift" class="ot-input-field">
                        <option value="0">Seleccionar...</option>
                        <option value="1">Mañana</option>
                        <option value="2">Tarde</option>
                        <option value="3">Noche</option>
                        <option value="4">Rotativa</option>
                    </select>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Tipo de contrato aceptado</label>
                    <select @bind="PrefContractType" class="ot-input-field">
                        <option value="0">Seleccionar...</option>
                        <option value="1">Indefinido</option>
                        <option value="2">Temporal</option>
                        <option value="3">Obra/Servicio</option>
                        <option value="4">Prácticas</option>
                    </select>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Disponibilidad de incorporación</label>
                    <select @bind="PrefAvailability" class="ot-input-field">
                        <option value="0">Seleccionar...</option>
                        <option value="1">Inmediata</option>
                        <option value="2">15 días</option>
                        <option value="3">30 días</option>
                        <option value="4">Más de 30 días</option>
                    </select>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Expectativa salarial (€)</label>
                    <input type="number" @bind="PrefSalary" class="ot-input-field" placeholder="0" />
                </div>
                <div class="ot-input-group" style="grid-column: span 2;">
                    <label class="ot-input-label">Días disponibles</label>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem;">
                        @foreach (var day in AvailableDayOptions)
                        {
                            var dayCode = day.Key;
                            <label style="display: flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.75rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; font-size: 0.85rem; transition: all var(--transition-fast); @(SelectedDays.Contains(dayCode) ? "border-color: var(--accent-primary); background: var(--accent-light); color: var(--accent-primary); font-weight: 600;" : "")">
                                <input type="checkbox" checked="@SelectedDays.Contains(dayCode)" @onchange="@(e => ToggleDay(dayCode, e.Value))" style="width: 16px; height: 16px; cursor: pointer;" />
                                @day.Value
                            </label>
                        }
                    </div>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Horario concreto disponible</label>
                    <input type="text" @bind="PrefSchedule" class="ot-input-field" placeholder="Ej: 08:00 - 16:00" />
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Disponible fines de semana</label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; background: var(--input-bg);">
                        <input type="checkbox" checked="@(PrefWeekends == true)" @onchange="@(e => PrefWeekends = (bool)e.Value)" style="width: 18px; height: 18px; cursor: pointer;" />
                        <span style="font-size: 0.9rem; color: var(--text-primary);">@(PrefWeekends == true ? "Sí" : "No")</span>
                    </label>
                </div>
                <div class="ot-input-group">
                    <label class="ot-input-label">Disponible festivos</label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; background: var(--input-bg);">
                        <input type="checkbox" checked="@(PrefHolidays == true)" @onchange="@(e => PrefHolidays = (bool)e.Value)" style="width: 18px; height: 18px; cursor: pointer;" />
                        <span style="font-size: 0.9rem; color: var(--text-primary);">@(PrefHolidays == true ? "Sí" : "No")</span>
                    </label>
                </div>
            </div>
            <div style="margin-top: 1rem;">
                <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@PrefSaving" @onclick="SavePreferences">
                    @(PrefSaving ? "Guardando..." : "Guardar preferencias")
                </button>
            </div>
        </div>
    }

    @* === Documents section === *@
    @if (Detail.Dismissal == null)
    {
        <div class="admin-recruitment-card" style="margin-top: 1.5rem;">
            <h3 class="admin-recruitment-card-title">
                Documentos
                <span class="admin-skill-count" style="margin-left: 0.5rem;">@Documents.Count</span>
            </h3>

            @if (Documents.Count > 0)
            {
                <div class="admin-investigation-list" style="margin-bottom: 1rem;">
                    @foreach (var doc in Documents)
                    {
                        <div class="admin-investigation-item @(doc.Status == 2 ? "admin-investigation-item--done" : "") @(doc.Status == 1 ? "admin-investigation-item--active" : "")">
                            <div class="admin-investigation-check">
                                <input type="checkbox" checked="@(doc.Status == 2)" disabled @onchange="() => ToggleDocStatus(doc)" />
                            </div>
                            <div class="admin-investigation-content">
                                <div class="admin-investigation-step-name">@doc.DocumentTypeName</div>
                                <span class="admin-result-badge @(doc.Status switch { 0 => "admin-result-badge--warning", 1 => "admin-result-badge--info", 2 => "admin-result-badge--success", _ => "" })" style="margin-left: 0.5rem; font-size: 0.65rem;">
                                    @(doc.Status switch { 0 => "Pendiente", 1 => "Enviado", 2 => "Verificado", _ => "—" })
                                </span>
                                @if (doc.DocumentTypeCategory != null)
                                {
                                    <span class="admin-result-badge admin-result-badge--info" style="margin-left: 0.25rem; font-size: 0.65rem;">@doc.DocumentTypeCategory</span>
                                }
                                @if (!string.IsNullOrEmpty(doc.Notes))
                                {
                                    <div class="admin-investigation-notes" style="font-size: 0.8rem;">@doc.Notes</div>
                                }
                                @if (doc.ExpiresAt.HasValue)
                                {
                                    <div class="admin-investigation-meta-text" style="font-size: 0.75rem;">Vence: @doc.ExpiresAt.Value.ToString("yyyy-MM-dd")</div>
                                }
                                @if (!string.IsNullOrEmpty(doc.FileUrl))
                                {
                                    <a href="@doc.FileUrl" target="_blank" style="font-size: 0.75rem; color: var(--accent-primary);">@doc.FileName</a>
                                }
                            </div>
                            <div style="display: flex; gap: 0.25rem;">
                                @if (doc.Status < 2)
                                {
                                    <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="() => MarkDocSubmitted(doc)">Marcar enviado</button>
                                    <button class="ot-btn ot-btn--primary ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="() => VerifyDoc(doc)">Verificar</button>
                                }
                                <button class="ot-btn ot-btn--outline ot-btn--small ot-btn--danger" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="() => RemoveDoc(doc)">✕</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">No hay documentos solicitados.</p>
            }

            @if (ShowAddDocForm)
            {
                <div style="border-top: 1px solid var(--border); padding-top: 1rem;">
                    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end;">
                        <div class="ot-input-group" style="flex: 1; min-width: 250px;">
                            <label class="ot-input-label">Documento a solicitar</label>
                            <select @bind="NewDocTypeId" class="ot-input-field">
                                <option value="">Seleccionar...</option>
                                @foreach (var dt in DocumentTypes)
                                {
                                    <option value="@dt.Id">@dt.Name @if (dt.IsRequired) { <text>(obligatorio)</text> }</option>
                                }
                            </select>
                        </div>
                        <div class="ot-input-group" style="flex: 1; min-width: 200px;">
                            <label class="ot-input-label">Notas</label>
                            <input type="text" @bind="NewDocNotes" class="ot-input-field" placeholder="Opcional" />
                        </div>
                        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="AddDocument">Solicitar</button>
                        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ShowAddDocForm = false">Cancelar</button>
                    </div>
                </div>
            }
            else
            {
                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ShowAddDocForm = true">+ Solicitar documento</button>
            }
        </div>
    }

    @* === Vacancy selector modal === *@
    @if (ShowVacancySelector)
    {
        <div class="admin-modal-overlay" @onclick="() => ShowVacancySelector = false">
            <div class="admin-modal" @onclick:stopPropagation="true" style="max-width: 500px;">
                <h3 class="admin-modal-title">Vincular vacante</h3>
                <div class="admin-modal-body">
                    @if (VacancyOptions.Count == 0)
                    {
                        <p style="color: var(--text-muted);">No hay vacantes activas disponibles.</p>
                    }
                    else
                    {
                        <input type="text" @bind="VacancySearch" @bind:event="oninput" class="ot-input-field" placeholder="Buscar vacante..." style="margin-bottom: 0.75rem;" />
                        var smartMatches = GetSmartMatchVacancies();
                        var filtered = VacancyOptions.Where(v => string.IsNullOrEmpty(VacancySearch) || (v.Title?.Contains(VacancySearch, StringComparison.OrdinalIgnoreCase) == true) || (v.CompanyName?.Contains(VacancySearch, StringComparison.OrdinalIgnoreCase) == true) || (v.Location?.Contains(VacancySearch, StringComparison.OrdinalIgnoreCase) == true) || (v.Description?.Contains(VacancySearch, StringComparison.OrdinalIgnoreCase) == true) || (v.Requirements?.Contains(VacancySearch, StringComparison.OrdinalIgnoreCase) == true)).ToList();
                        
                        @if (string.IsNullOrEmpty(VacancySearch) && ShowSmartMatches && smartMatches.Count > 0)
                        {
                            <div style="margin-bottom: 0.75rem;">
                                <div style="font-size: 0.8rem; font-weight: 600; color: var(--accent-primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
                                    <span>✨ Coincidencias del candidato</span>
                                    <span style="font-size: 0.7rem; background: var(--accent-light); padding: 0.1rem 0.4rem; border-radius: 0.5rem;">@smartMatches.Count</span>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 0.5rem; max-height: 200px; overflow-y: auto;">
                                    @if (Detail.VacancyId.HasValue)
                                    {
                                        <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; @(SelectedVacancyId == null ? "border-color: var(--accent-primary); background: var(--accent-light);" : "")">
                                            <input type="radio" name="vacancy" checked="@(!SelectedVacancyId.HasValue)" @onchange="() => SelectedVacancyId = null" />
                                            <div>
                                                <div style="font-weight: 600; font-size: 0.9rem;">Sin vacante</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">Desvincular candidato</div>
                                            </div>
                                        </label>
                                    }
                                    @foreach (var v in smartMatches)
                                    {
                                        <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border: 1.5px solid var(--accent-primary); border-radius: var(--radius-md); cursor: pointer; background: var(--accent-light); @(SelectedVacancyId == v.Id ? "border-width: 2.5px;" : "")">
                                            <input type="radio" name="vacancy" checked="@(SelectedVacancyId == v.Id)" @onchange="() => SelectedVacancyId = v.Id" />
                                            <div>
                                                <div style="font-weight: 600; font-size: 0.9rem;">@v.Title</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">@v.CompanyName @(v.Location != null ? $"· {v.Location}" : "")</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                            <div style="border-top: 1px solid var(--input-border); margin: 0.5rem 0 0.75rem; padding-top: 0.5rem; font-size: 0.8rem; font-weight: 600; color: var(--text-muted);">
                                Todas las vacantes (@filtered.Count)
                            </div>
                        }

                        @if (filtered.Count == 0)
                        {
                            <p style="color: var(--text-muted); text-align: center; padding: 1rem;">No se encontraron vacantes.</p>
                        }
                        else
                        {
                            <div style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem;">
                                @if (!string.IsNullOrEmpty(VacancySearch) && Detail.VacancyId.HasValue)
                                {
                                    <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; @(SelectedVacancyId == null ? "border-color: var(--accent-primary); background: var(--accent-light);" : "")">
                                        <input type="radio" name="vacancy" checked="@(!SelectedVacancyId.HasValue)" @onchange="() => SelectedVacancyId = null" />
                                        <div>
                                            <div style="font-weight: 600; font-size: 0.9rem;">Sin vacante</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">Desvincular candidato</div>
                                        </div>
                                    </label>
                                }
                                @foreach (var v in filtered)
                                {
                                    <label style="display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem; border: 1.5px solid var(--input-border); border-radius: var(--radius-md); cursor: pointer; @(SelectedVacancyId == v.Id ? "border-color: var(--accent-primary); background: var(--accent-light);" : "")">
                                        <input type="radio" name="vacancy" checked="@(SelectedVacancyId == v.Id)" @onchange="() => SelectedVacancyId = v.Id" />
                                        <div>
                                            <div style="font-weight: 600; font-size: 0.9rem;">@v.Title</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">@v.CompanyName @(v.Location != null ? $"· {v.Location}" : "")</div>
                                        </div>
                                    </label>
                                }
                            </div>
                        }
                    }
                </div>
                <div class="admin-modal-footer" style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem;">
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => ShowVacancySelector = false">Cancelar</button>
                    <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="ConfirmLinkVacancy">Vincular</button>
                </div>
            </div>
        </div>
    }

    @* === Move stage error === *@
    @if (!string.IsNullOrEmpty(MoveStageError))
    {
        <div class="admin-result-badge admin-result-badge--danger" style="margin-top: 1rem; display: block; padding: 0.75rem 1rem;">
            @MoveStageError
        </div>
    }

    @* === Actions === *@
    @if (Detail.Dismissal == null)
    {
        <div class="admin-recruitment-actions">
            @if (Detail.CurrentStage < 4)
            {
                <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="() => MoveToNextStage()">
                    @Lang.T("admin.recruitment.moveToNext") → @GetStageName(Detail.CurrentStage + 1)
                </button>
            }
            <button class="ot-btn ot-btn--outline ot-btn--small ot-btn--danger" @onclick="ShowDismissModal">
                @Lang.T("admin.recruitment.dismiss")
            </button>
        </div>
    }

    @* === Investigation checklist === *@
    @if (Detail.CurrentStage == 1 && Detail.Dismissal == null)
    {
        <h2 class="admin-section-title">
            @Lang.T("admin.recruitment.investigationChecklist")
            <span class="admin-skill-count" style="margin-left: 0.5rem;">
                @Detail.InvestigationChecklist.Count(c => c.IsCompleted) / @Detail.InvestigationChecklist.Count
            </span>
        </h2>

        @* Total investigation duration *@
        @if (Detail.InvestigationChecklist.Any(c => c.StartedAt.HasValue))
        {
            <div class="admin-investigation-summary">
                @Lang.T("admin.recruitment.totalDuration"): <strong>@GetTotalInvestigationDuration()</strong>
            </div>
        }

        <div class="admin-investigation-list">
            @if (Detail.InvestigationChecklist.Count > 0)
            {
                @foreach (var item in Detail.InvestigationChecklist.OrderBy(c => c.Step))
                {
                    <div class="admin-investigation-item @(item.IsCompleted ? "admin-investigation-item--done" : "") @(item.StartedAt.HasValue && !item.IsCompleted ? "admin-investigation-item--active" : "")">
                        <div class="admin-investigation-check">
                            <input type="checkbox" checked="@item.IsCompleted" disabled="@(Detail.CurrentStage != 1)" @onchange="() => ToggleStep(item)" />
                        </div>
                        <div class="admin-investigation-content">
                            <div class="admin-investigation-step-name">@(item.Label ?? GetInvestigationStepName(item.Step))</div>
                            @if (item.IsCustom)
                            {
                                <span class="admin-result-badge admin-result-badge--info" style="margin-left: 0.5rem; font-size: 0.65rem;">Custom</span>
                            }

                            @* Status badges *@
                            <div class="admin-investigation-meta">
                                @if (!item.StartedAt.HasValue && !item.IsCompleted)
                                {
                                    <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="() => StartStep(item.Step)">
                                        @Lang.T("admin.recruitment.startStep")
                                    </button>
                                }
                                else if (item.StartedAt.HasValue && !item.IsCompleted)
                                {
                                    <span class="admin-result-badge admin-result-badge--warning">
                                        @Lang.T("admin.recruitment.inProgress") · @GetElapsedDuration(item.StartedAt)
                                    </span>
                                }
                                else if (item.IsCompleted && item.StartedAt.HasValue)
                                {
                                    <span class="admin-result-badge admin-result-badge--success">
                                        @Lang.T("admin.recruitment.duration"): @GetStepDuration(item.StartedAt, item.CompletedAt)
                                    </span>
                                    <span class="admin-investigation-meta-text">
                                        @Lang.T("admin.recruitment.completedBy") @item.CompletedByName · @item.CompletedAt?.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(item.Notes) && EditingNotesId != item.Id)
                            {
                                <div class="admin-investigation-notes">
                                    @item.Notes
                                    @if (Detail.CurrentStage == 1)
                                    {
                                        <button class="admin-notes-edit-btn" @onclick='() => { NotesEditValue = item.Notes ?? ""; EditingNotesId = item.Id; }'>✎</button>
                                    }
                                </div>
                            }
                            else if (EditingNotesId == item.Id)
                            {
                                <div class="admin-notes-edit-form">
                                    <textarea @bind="NotesEditValue" rows="2" class="admin-investigation-add-input" style="resize: vertical; width: 100%;" placeholder="@Lang.T("admin.recruitment.notesPlaceholder")"></textarea>
                                    <div class="admin-reference-add-actions">
                                        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => EditingNotesId = null'>@Lang.T("admin.common.cancel")</button>
                                        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick='() => SaveNotes(item.Id)'>@Lang.T("admin.common.save")</button>
                                    </div>
                                </div>
                            }
                            else if (Detail.CurrentStage == 1 && string.IsNullOrEmpty(item.Notes))
                            {
                                <button class="admin-notes-add-btn" @onclick='() => { NotesEditValue = ""; EditingNotesId = item.Id; }'>+ @Lang.T("admin.recruitment.addNote")</button>
                            }

                            @* Step 2: Validate LinkedIn - show link + notes *@
                            @if (item.Step == 2 && Detail.CurrentStage == 1)
                            {
                                <div class="admin-step-context-panel">
                                    @if (!string.IsNullOrEmpty(Detail.Title))
                                    {
                                        <div class="admin-step-context-row"><span class="admin-step-context-label">@Lang.T("admin.recruitment.candidateTitle"):</span> @Detail.Title</div>
                                    }
                                    <div class="admin-step-context-row">
                                        <span class="admin-step-context-label">LinkedIn:</span>
                                        @if (!string.IsNullOrEmpty(Detail.LinkedInUrl))
                                        {
                                            <a href="@Detail.LinkedInUrl" target="_blank" class="admin-candidate-contact-value">@Detail.LinkedInUrl</a>
                                        }
                                        else
                                        {
                                            <span class="admin-reference-contact--missing">@Lang.T("admin.recruitment.searchOnLinkedIn")</span>
                                        }
                                    </div>
                                </div>
                            }

                            @* Step 3: Validate portfolio - show link + notes *@
                            @if (item.Step == 3 && Detail.CurrentStage == 1)
                            {
                                <div class="admin-step-context-panel">
                                    <div class="admin-step-context-row">
                                        <span class="admin-step-context-label">@Lang.T("admin.recruitment.portfolio"):</span>
                                        @if (!string.IsNullOrEmpty(Detail.PortfolioUrl))
                                        {
                                            <a href="@Detail.PortfolioUrl" target="_blank" class="admin-candidate-contact-value">@Lang.T("admin.recruitment.viewPortfolio")</a>
                                        }
                                        else
                                        {
                                            <span class="admin-reference-contact--missing">@Lang.T("admin.recruitment.noPortfolioRegistered")</span>
                                        }
                                    </div>
                                </div>
                            }

                            @* Step 4: Validate certifications - show all certs and education *@
                            @if (item.Step == 4 && Detail.CurrentStage == 1)
                            {
                                <div class="admin-step-context-panel">
                                    @if (Detail.Certifications.Count > 0)
                                    {
                                        <div class="admin-step-context-subtitle">@Lang.T("admin.recruitment.certifications") (@Detail.Certifications.Count)</div>
                                        @foreach (var cert in Detail.Certifications)
                                        {
                                            <div class="admin-cert-item">
                                                <div class="admin-cert-info">
                                                    <div class="admin-cert-name">@cert.Name</div>
                                                    @if (!string.IsNullOrEmpty(cert.Issuer))
                                                    {
                                                        <div class="admin-cert-issuer">@cert.Issuer</div>
                                                    }
                                                    @if (cert.IssueDate.HasValue)
                                                    {
                                                        <div class="admin-cert-date">@cert.IssueDate.Value.ToString("MMM yyyy")</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(cert.CredentialId))
                                                    {
                                                        <div class="admin-cert-meta">ID: @cert.CredentialId</div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                                                {
                                                    <a href="@cert.CredentialUrl" target="_blank" class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.65rem; padding: 0.15rem 0.5rem;">@Lang.T("admin.recruitment.verify")</a>
                                                }
                                                else
                                                {
                                                    <span class="admin-reference-contact--missing" style="font-size: 0.7rem;">@Lang.T("admin.recruitment.requestVerificationLink")</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="admin-empty-text" style="font-size: 0.78rem; padding: 0.3rem 0;">@Lang.T("admin.recruitment.noCertifications")</div>
                                    }

                                    @if (Detail.Educations.Count > 0)
                                    {
                                        <div class="admin-step-context-subtitle" style="margin-top: 0.5rem;">@Lang.T("admin.recruitment.education") (@Detail.Educations.Count)</div>
                                        @foreach (var edu in Detail.Educations)
                                        {
                                            <div class="admin-cert-item">
                                                <div class="admin-cert-info">
                                                    <div class="admin-cert-name">@edu.Degree</div>
                                                    <div class="admin-cert-issuer">@edu.Institution</div>
                                                    @if (edu.StartDate.HasValue)
                                                    {
                                                        <div class="admin-cert-date">@edu.StartDate.Value.ToString("yyyy") - @(edu.EndDate?.ToString("yyyy") ?? (edu.IsInProgress ? Lang.T("admin.recruitment.inProgress") : ""))</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }

                            @* Step 0: Call candidate - show phone with edit *@
                            @if (item.Step == 0 && Detail.CurrentStage == 1)
                            {
                                <div class="admin-candidate-contact-info">
                                    <div class="admin-candidate-contact-row">
                                        <span class="admin-candidate-contact-label">@Lang.T("admin.recruitment.candidatePhone"):</span>
                                        @if (EditingPhone)
                                        {
                                            <input type="text" @bind="PhoneEditValue" placeholder="@Lang.T("admin.recruitment.refContactPhone")" class="admin-investigation-add-input" style="flex: 1; max-width: 200px;" />
                                            <button class="ot-btn ot-btn--primary ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick="SavePhone">@Lang.T("admin.common.save")</button>
                                            <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick='() => EditingPhone = false'>@Lang.T("admin.common.cancel")</button>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrEmpty(Detail.Phone))
                                            {
                                                <a href="tel:@Detail.Phone" class="admin-candidate-contact-value">📞 @Detail.Phone</a>
                                                <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.65rem; padding: 0.15rem 0.5rem; margin-left: 0.3rem;" @onclick='() => { PhoneEditValue = Detail.Phone; EditingPhone = true; }'>✎</button>
                                            }
                                            else
                                            {
                                                <span class="admin-candidate-contact-row--missing">@Lang.T("admin.recruitment.noPhoneRegistered")</span>
                                                <button class="ot-btn ot-btn--primary ot-btn--small" style="font-size: 0.65rem; padding: 0.15rem 0.5rem; margin-left: 0.3rem;" @onclick='() => { PhoneEditValue = ""; EditingPhone = true; }'>@Lang.T("admin.recruitment.addPhone")</button>
                                            }
                                        }
                                    </div>
                                    <div class="admin-candidate-contact-row">
                                        <span class="admin-candidate-contact-label">@Lang.T("admin.recruitment.candidateEmail"):</span>
                                        <a href="mailto:@Detail.Email" class="admin-candidate-contact-value">✉ @Detail.Email</a>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Detail.Country) || !string.IsNullOrEmpty(Detail.City))
                                    {
                                        <div class="admin-candidate-contact-row">
                                            <span class="admin-candidate-contact-label">@Lang.T("admin.recruitment.candidateLocation"):</span>
                                            <span class="admin-candidate-contact-value">@Detail.City, @Detail.Country</span>
                                        </div>
                                    }
                                </div>
                            }

                            @* References sub-panel for step 1 (Call references) *@
                            @if (item.Step == 1 && Detail.CurrentStage == 1)
                            {
                                <div class="admin-references-panel">
                                    <div class="admin-references-header">
                                        <span>@Lang.T("admin.recruitment.referencesTitle") (@item.ReferenceChecks.Count)</span>
                                        <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem; padding: 0.2rem 0.6rem;" @onclick='() => ShowAddReference(item.Id)'>
                                            + @Lang.T("admin.recruitment.addReference")
                                        </button>
                                    </div>

                                    @if (item.ReferenceChecks.Count > 0)
                                    {
                                        <div class="admin-references-list">
                                            @foreach (var refItem in item.ReferenceChecks)
                                            {
                                                <div class="admin-reference-card">
                                                    <div class="admin-reference-info">
                                                        <div class="admin-reference-company">@refItem.CompanyName</div>
                                                        @if (!string.IsNullOrEmpty(refItem.ContactName))
                                                        {
                                                            <div class="admin-reference-contact">@refItem.ContactName</div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(refItem.ContactPhone))
                                                        {
                                                            <div class="admin-reference-contact">📞 <a href="tel:@refItem.ContactPhone">@refItem.ContactPhone</a></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="admin-reference-contact admin-reference-contact--missing">@Lang.T("admin.recruitment.noPhoneAskCandidate")</div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(refItem.ContactEmail))
                                                        {
                                                            <div class="admin-reference-contact">✉ @refItem.ContactEmail</div>
                                                        }
                                                        @if (refItem.CalledAt.HasValue)
                                                        {
                                                            <div class="admin-reference-meta">@Lang.T("admin.recruitment.calledAt"): @refItem.CalledAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(refItem.Notes))
                                                        {
                                                            <div class="admin-reference-notes">@refItem.Notes</div>
                                                        }
                                                    </div>
                                                    <div class="admin-reference-actions">
                                                        <select class="admin-reference-status" value="@refItem.Status" @onchange="@(e => UpdateReferenceStatus(refItem.Id, int.Parse(e.Value?.ToString() ?? "0")))">
                                                            <option value="0">@Lang.T("admin.recruitment.refPending")</option>
                                                            <option value="1">@Lang.T("admin.recruitment.refCalled")</option>
                                                            <option value="2">@Lang.T("admin.recruitment.refValidated")</option>
                                                            <option value="3">@Lang.T("admin.recruitment.refNoResponse")</option>
                                                        </select>
                                                        <button class="admin-row-btn" title="Eliminar" @onclick="() => DeleteReference(refItem.Id)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                                <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-empty-text" style="font-size: 0.78rem; padding: 0.5rem 0;">@Lang.T("admin.recruitment.noReferences")</div>
                                    }

                                    @* Show work experiences as suggestion if no references *@
                                    @if (item.ReferenceChecks.Count == 0 && Detail.WorkExperiences.Count > 0)
                                    {
                                        <div class="admin-references-suggestion">
                                            <div class="admin-references-suggestion-title">@Lang.T("admin.recruitment.suggestedFromWorkHistory"):</div>
                                            @foreach (var exp in Detail.WorkExperiences.GroupBy(e => e.CompanyName).Select(g => g.First()))
                                            {
                                                <div class="admin-references-suggestion-item">
                                                    <span>@exp.CompanyName</span>
                                                    <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.65rem; padding: 0.15rem 0.5rem;" @onclick="() => AddReferenceFromExperience(item.Id, exp.CompanyName)">
                                                        + @Lang.T("admin.recruitment.addReference")
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (AddingReferenceTo == item.Id)
                                    {
                                        <div class="admin-reference-add-form">
                                            <input type="text" @bind="NewRefCompany" placeholder="@Lang.T("admin.recruitment.refCompany")" class="admin-investigation-add-input" />
                                            <input type="text" @bind="NewRefContactName" placeholder="@Lang.T("admin.recruitment.refContactName")" class="admin-investigation-add-input" />
                                            <input type="text" @bind="NewRefContactPhone" placeholder="@Lang.T("admin.recruitment.refContactPhone")" class="admin-investigation-add-input" />
                                            <input type="text" @bind="NewRefContactEmail" placeholder="@Lang.T("admin.recruitment.refContactEmail")" class="admin-investigation-add-input" />
                                            <div class="admin-reference-add-actions">
                                                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick='() => AddingReferenceTo = null'>@Lang.T("admin.common.cancel")</button>
                                                <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrWhiteSpace(NewRefCompany)" @onclick="ConfirmAddReference">
                                                    @Lang.T("admin.recruitment.addReference")
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (item.IsCustom)
                        {
                            <button class="admin-row-btn" title="Eliminar" @onclick="() => DeleteCustomValidation(item.Id)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                    <polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </svg>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="admin-empty-text">@Lang.T("admin.recruitment.noChecklist")</div>
            }

            @* Add custom validation *@
            @if (Detail.Dismissal == null)
            {
                <div class="admin-investigation-add">
                    <input type="text" @bind="NewValidationLabel" placeholder="@Lang.T("admin.recruitment.addValidationPlaceholder")" class="admin-investigation-add-input" />
                    <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrWhiteSpace(NewValidationLabel)" @onclick="AddCustomValidation">
                        @Lang.T("admin.recruitment.addValidation")
                    </button>
                </div>
            }
        </div>
    }

    @* === Technical Evaluations (stage 2) === *@
    @if (Detail.CurrentStage == 2 && Detail.Dismissal == null)
    {
        <h2 class="admin-section-title">
            @Lang.T("admin.recruitment.technicalEvaluations")
            @if (Detail.TechnicalEvaluations.Count > 0)
            {
                <span class="admin-skill-count" style="margin-left: 0.5rem;">@Detail.TechnicalEvaluations.Count</span>
            }
        </h2>

        @if (Detail.TechnicalEvaluations.Count > 0)
        {
            <div class="admin-evaluations-list">
                @foreach (var eval in Detail.TechnicalEvaluations)
                {
                    <div class="admin-evaluation-card">
                        <div class="admin-evaluation-header">
                            <div class="admin-evaluation-name">@eval.EvaluationName</div>
                            <div class="admin-evaluation-score @(eval.Score >= 70 ? "admin-evaluation-score--pass" : "admin-evaluation-score--fail")">
                                @eval.Score.ToString("0.#")/100
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(eval.Description))
                        {
                            <div class="admin-evaluation-desc">@eval.Description</div>
                        }
                        @if (!string.IsNullOrEmpty(eval.Notes))
                        {
                            <div class="admin-evaluation-notes">@eval.Notes</div>
                        }
                        <div class="admin-evaluation-meta">
                            <span>@eval.EvaluatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            @if (!string.IsNullOrEmpty(eval.EvaluatedByName))
                            {
                                <span>· @eval.EvaluatedByName</span>
                            }
                            @if (!string.IsNullOrEmpty(eval.EvidenceUrl))
                            {
                                <a href="@eval.EvidenceUrl" target="_blank" class="admin-candidate-contact-value" style="margin-left: 0.5rem;">@Lang.T("admin.recruitment.viewEvidence")</a>
                            }
                        </div>
                        <div class="admin-evaluation-actions">
                            <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem;" @onclick='() => StartEditEvaluation(eval)'>@Lang.T("admin.common.edit")</button>
                            <button class="ot-btn ot-btn--outline ot-btn--small ot-btn--danger" style="font-size: 0.7rem;" @onclick='() => DeleteEvaluation(eval.Id)'>@Lang.T("admin.common.delete")</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="admin-empty-text">@Lang.T("admin.recruitment.noEvaluations")</div>
        }

        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="OpenAddEvaluationModal">
            + @Lang.T("admin.recruitment.addEvaluation")
        </button>

        @* Score summary *@
        @if (Detail.TechnicalEvaluations.Count > 0)
        {
            <div class="admin-evaluation-summary">
                <span class="admin-evaluation-summary-label">@Lang.T("admin.recruitment.averageScore"):</span>
                <span class="admin-evaluation-summary-value">@Math.Round(Detail.TechnicalEvaluations.Average(e => e.Score), 1).ToString("0.#")/100</span>
            </div>
        }
    }

    @* === Cultural Interview (stage 3) === *@
    @if (Detail.CurrentStage == 3 && Detail.Dismissal == null)
    {
        <h2 class="admin-section-title">
            @Lang.T("admin.recruitment.culturalInterview")
            @if (Detail.CulturalInterviews.Count > 0)
            {
                <span class="admin-skill-count" style="margin-left: 0.5rem;">@Detail.CulturalInterviews.Count</span>
            }
        </h2>

        @if (Detail.CulturalInterviews.Count > 0)
        {
            <div class="admin-evaluations-list">
                @foreach (var interview in Detail.CulturalInterviews)
                {
                    <div class="admin-evaluation-card">
                        <div class="admin-evaluation-header">
                            <div class="admin-evaluation-name">@interview.EvaluationName</div>
                            <div class="admin-evaluation-score @(interview.Score >= 70 ? "admin-evaluation-score--pass" : "admin-evaluation-score--fail")">
                                @interview.Score.ToString("0.#")/100
                            </div>
                        </div>

                        <div class="admin-cultural-recommendation">
                            <span class="admin-step-context-label">@Lang.T("admin.recruitment.recommendation"):</span>
                            <span class="admin-recommendation-badge admin-recommendation--@interview.Recommendation">
                                @GetRecommendationLabel(interview.Recommendation)
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(interview.Description))
                        {
                            <div class="admin-evaluation-desc">@interview.Description</div>
                        }
                        @if (!string.IsNullOrEmpty(interview.Notes))
                        {
                            <div class="admin-evaluation-notes">@interview.Notes</div>
                        }
                        <div class="admin-evaluation-meta">
                            <span>@interview.EvaluatedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            @if (!string.IsNullOrEmpty(interview.EvaluatedByName))
                            {
                                <span>· @interview.EvaluatedByName</span>
                            }
                        </div>
                        <div class="admin-evaluation-actions">
                            <button class="ot-btn ot-btn--outline ot-btn--small" style="font-size: 0.7rem;" @onclick='() => StartEditCultural(interview)'>@Lang.T("admin.common.edit")</button>
                            <button class="ot-btn ot-btn--outline ot-btn--small ot-btn--danger" style="font-size: 0.7rem;" @onclick='() => DeleteEvaluation(interview.Id)'>@Lang.T("admin.common.delete")</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="admin-empty-text" style="margin-bottom: 0.5rem;">@Lang.T("admin.recruitment.noCulturalInterview")</div>
        }

        <button class="ot-btn ot-btn--primary ot-btn--small" @onclick="OpenAddCulturalModal">
            + @Lang.T("admin.recruitment.addCulturalInterview")
        </button>

        @if (Detail.CulturalInterviews.Count > 0)
        {
            <div class="admin-evaluation-summary">
                <span class="admin-evaluation-summary-label">@Lang.T("admin.recruitment.averageScore"):</span>
                <span class="admin-evaluation-summary-value">@Math.Round(Detail.CulturalInterviews.Average(e => e.Score), 1).ToString("0.#")/100</span>
            </div>
        }
    }

    @* === Delivery summary (stage 4) === *@
    @if (Detail.CurrentStage == 4 && Detail.Dismissal == null)
    {
        <h2 class="admin-section-title">@Lang.T("admin.recruitment.deliverySummary")</h2>

        <div class="admin-delivery-summary">
            @* Investigation *@
            <div class="admin-delivery-card">
                <div class="admin-delivery-card-header">
                    <span class="admin-delivery-card-icon">1</span>
                    <span class="admin-delivery-card-title">@Lang.T("admin.recruitment.stage1")</span>
                </div>
                <div class="admin-delivery-card-body">
                    @{
                        var completedSteps = Detail.InvestigationChecklist.Where(c => c.IsCompleted).Count();
                        var totalSteps = Detail.InvestigationChecklist.Count;
                    }
                    <div class="admin-delivery-stat">
                        <span class="admin-delivery-stat-label">@Lang.T("admin.recruitment.checklistProgress")</span>
                        <span class="admin-delivery-stat-value">@completedSteps/@totalSteps</span>
                    </div>
                    <div class="admin-delivery-progress">
                        <div class="admin-delivery-progress-bar" style="width: @(totalSteps > 0 ? (completedSteps * 100 / totalSteps) : 0)%"></div>
                    </div>
                </div>
            </div>

            @* Technical evaluations *@
            <div class="admin-delivery-card">
                <div class="admin-delivery-card-header">
                    <span class="admin-delivery-card-icon">2</span>
                    <span class="admin-delivery-card-title">@Lang.T("admin.recruitment.stage2")</span>
                </div>
                <div class="admin-delivery-card-body">
                    @if (Detail.TechnicalEvaluations.Count > 0)
                    {
                        <div class="admin-delivery-stat">
                            <span class="admin-delivery-stat-label">@Lang.T("admin.recruitment.averageScore")</span>
                            <span class="admin-delivery-stat-value admin-delivery-stat-value--@(Detail.TechnicalEvaluations.Average(e => e.Score) >= 70 ? "pass" : "fail")">
                                @Math.Round(Detail.TechnicalEvaluations.Average(e => e.Score), 1).ToString("0.#")/100
                            </span>
                        </div>
                        <div class="admin-delivery-stat">
                            <span class="admin-delivery-stat-label">@Lang.T("admin.recruitment.evaluationsCount")</span>
                            <span class="admin-delivery-stat-value">@Detail.TechnicalEvaluations.Count</span>
                        </div>
                        <div class="admin-delivery-detail-toggle" @onclick="@(() => ToggleDeliveryDetail("tech"))">
                            @Lang.T("admin.recruitment.viewDetail")
                        </div>
                        @if (ShowDeliveryDetail == "tech")
                        {
                            <div class="admin-delivery-detail-list">
                                @foreach (var eval in Detail.TechnicalEvaluations)
                                {
                                    <div class="admin-delivery-detail-item">
                                        <span>@eval.EvaluationName</span>
                                        <span class="admin-delivery-detail-score @(eval.Score >= 70 ? "admin-delivery-detail-score--pass" : "admin-delivery-detail-score--fail")">@eval.Score.ToString("0.#")</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="admin-empty-text">@Lang.T("admin.recruitment.noEvaluations")</div>
                    }
                </div>
            </div>

            @* Cultural interviews *@
            <div class="admin-delivery-card">
                <div class="admin-delivery-card-header">
                    <span class="admin-delivery-card-icon">3</span>
                    <span class="admin-delivery-card-title">@Lang.T("admin.recruitment.stage3")</span>
                </div>
                <div class="admin-delivery-card-body">
                    @if (Detail.CulturalInterviews.Count > 0)
                    {
                        <div class="admin-delivery-stat">
                            <span class="admin-delivery-stat-label">@Lang.T("admin.recruitment.averageScore")</span>
                            <span class="admin-delivery-stat-value admin-delivery-stat-value--@(Detail.CulturalInterviews.Average(e => e.Score) >= 70 ? "pass" : "fail")">
                                @Math.Round(Detail.CulturalInterviews.Average(e => e.Score), 1).ToString("0.#")/100
                            </span>
                        </div>
                        <div class="admin-delivery-stat">
                            <span class="admin-delivery-stat-label">@Lang.T("admin.recruitment.recommendation")</span>
                            <span class="admin-recommendation-badge admin-recommendation--@Detail.CulturalInterviews.First().Recommendation">
                                @GetRecommendationLabel(Detail.CulturalInterviews.First().Recommendation)
                            </span>
                        </div>
                        <div class="admin-delivery-detail-toggle" @onclick="@(() => ToggleDeliveryDetail("cultural"))">
                            @Lang.T("admin.recruitment.viewDetail")
                        </div>
                        @if (ShowDeliveryDetail == "cultural")
                        {
                            <div class="admin-delivery-detail-list">
                                @foreach (var interview in Detail.CulturalInterviews)
                                {
                                    <div class="admin-delivery-detail-item">
                                        <span>@interview.EvaluationName</span>
                                        <span class="admin-delivery-detail-score @(interview.Score >= 70 ? "admin-delivery-detail-score--pass" : "admin-delivery-detail-score--fail")">@interview.Score.ToString("0.#")</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="admin-empty-text">@Lang.T("admin.recruitment.noCulturalInterview")</div>
                    }
                </div>
            </div>
        </div>

        @* Overall summary *@
        <div class="admin-delivery-overall">
            <span class="admin-delivery-overall-label">@Lang.T("admin.recruitment.overallScore")</span>
            <span class="admin-delivery-overall-value">@OverallScore.ToString("0.#")/100</span>
        </div>
    }

    @* === Stage history === *@
    @if (Detail.StageLogs.Count > 0)
    {
        <h2 class="admin-section-title">@Lang.T("admin.recruitment.stageHistory")</h2>
        <div class="admin-stage-history">
            @foreach (var log in Detail.StageLogs.OrderByDescending(l => l.CreatedAt))
            {
                <div class="admin-stage-history-item">
                    <span class="admin-stage-history-arrow">@GetStageName(log.FromStage) → @GetStageName(log.ToStage)</span>
                    <span class="admin-stage-history-meta">@log.ChangedByName · @log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    @if (!string.IsNullOrEmpty(log.Notes))
                    {
                        <div class="admin-stage-history-notes">@log.Notes</div>
                    }
                </div>
            }
        </div>
    }

    @* === Cultural interview modal === *@
    @if (ShowCulturalModal)
    {
        <div class="admin-modal-overlay" @onclick="CloseCulturalModal">
            <div class="admin-modal" @onclick:stopPropagation="true">
                <h3 class="admin-modal-title">@(EditingCulturalId == null ? Lang.T("admin.recruitment.addCulturalInterview") : Lang.T("admin.recruitment.editCulturalInterview"))</h3>
                <div class="admin-modal-body">
                    <label>@Lang.T("admin.recruitment.interviewTitle")</label>
                    <input type="text" @bind="CulturalName" class="admin-modal-input" placeholder="@Lang.T("admin.recruitment.interviewTitle")" />
                    <label>@Lang.T("admin.recruitment.evalScore")</label>
                    <div style="display: flex; gap: 0.3rem; align-items: center;">
                        <input type="number" @bind="CulturalScore" min="0" max="100" step="1" class="admin-modal-input" style="width: 120px;" />
                        <span style="font-size: 0.8rem; color: var(--text-muted);">/100</span>
                    </div>
                    <label>@Lang.T("admin.recruitment.recommendation")</label>
                    <select @bind="CulturalRecommendation" class="admin-modal-input">
                        <option value="0">@Lang.T("admin.recruitment.recPending")</option>
                        <option value="1">@Lang.T("admin.recruitment.recRecommended")</option>
                        <option value="2">@Lang.T("admin.recruitment.recNotRecommended")</option>
                        <option value="3">@Lang.T("admin.recruitment.recUndecided")</option>
                    </select>
                    <label>@Lang.T("admin.recruitment.evalDesc")</label>
                    <input type="text" @bind="CulturalDesc" class="admin-modal-input" placeholder="@Lang.T("admin.recruitment.evalDesc")" />
                    <label>@Lang.T("admin.recruitment.interviewNotes")</label>
                    <textarea @bind="CulturalNotes" rows="4" class="admin-modal-textarea" placeholder="@Lang.T("admin.recruitment.interviewNotesPlaceholder")"></textarea>
                </div>
                <div class="admin-modal-actions">
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseCulturalModal">@Lang.T("admin.common.cancel")</button>
                    <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrWhiteSpace(CulturalName)" @onclick="SaveCulturalModal">@Lang.T("admin.common.save")</button>
                </div>
            </div>
        </div>
    }

    @* === Evaluation modal === *@
    @if (ShowEvaluationModal)
    {
        <div class="admin-modal-overlay" @onclick="CloseEvaluationModal">
            <div class="admin-modal" @onclick:stopPropagation="true">
                <h3 class="admin-modal-title">@(EditingEvaluationId == null ? Lang.T("admin.recruitment.addEvaluation") : Lang.T("admin.recruitment.editEvaluation"))</h3>
                <div class="admin-modal-body">
                    <label>@Lang.T("admin.recruitment.evalName")</label>
                    <input type="text" @bind="ModalEvalName" class="admin-modal-input" placeholder="@Lang.T("admin.recruitment.evalName")" />
                    <label>@Lang.T("admin.recruitment.evalDesc")</label>
                    <input type="text" @bind="ModalEvalDesc" class="admin-modal-input" placeholder="@Lang.T("admin.recruitment.evalDesc")" />
                    <label>@Lang.T("admin.recruitment.evalScore")</label>
                    <div style="display: flex; gap: 0.3rem; align-items: center;">
                        <input type="number" @bind="ModalEvalScore" min="0" max="100" step="1" class="admin-modal-input" style="width: 120px;" />
                        <span style="font-size: 0.8rem; color: var(--text-muted);">/100</span>
                    </div>
                    <label>@Lang.T("admin.recruitment.evalUrl")</label>
                    <input type="text" @bind="ModalEvalUrl" class="admin-modal-input" placeholder="@Lang.T("admin.recruitment.evalUrl")" />
                    <label>@Lang.T("admin.recruitment.notesPlaceholder")</label>
                    <textarea @bind="ModalEvalNotes" rows="3" class="admin-modal-textarea"></textarea>
                </div>
                <div class="admin-modal-actions">
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseEvaluationModal">@Lang.T("admin.common.cancel")</button>
                    <button class="ot-btn ot-btn--primary ot-btn--small" disabled="@string.IsNullOrWhiteSpace(ModalEvalName)" @onclick="SaveEvaluationModal">@Lang.T("admin.common.save")</button>
                </div>
            </div>
        </div>
    }

    @* === Dismiss modal === *@
    @if (ShowDismiss)
    {
        <div class="admin-modal-overlay" @onclick="CloseDismissModal">
            <div class="admin-modal" @onclick:stopPropagation="true">
                <h3 class="admin-modal-title">@Lang.T("admin.recruitment.dismissCandidate")</h3>
                <div class="admin-modal-body">
                    <label>@Lang.T("admin.recruitment.dismissReason")</label>
                    <select @bind="DismissReason">
                        <option value="0">@Lang.T("admin.recruitment.reasonTechnical")</option>
                        <option value="1">@Lang.T("admin.recruitment.reasonReferences")</option>
                        <option value="2">@Lang.T("admin.recruitment.reasonSalary")</option>
                        <option value="3">@Lang.T("admin.recruitment.reasonNoShow")</option>
                        <option value="4">@Lang.T("admin.recruitment.reasonOther")</option>
                    </select>
                    <label>@Lang.T("admin.recruitment.dismissNotes")</label>
                    <textarea @bind="DismissNotes" rows="3" class="admin-modal-textarea"></textarea>
                </div>
                <div class="admin-modal-actions">
                    <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="CloseDismissModal">@Lang.T("admin.common.cancel")</button>
                    <button class="ot-btn ot-btn--primary ot-btn--small ot-btn--danger" @onclick="ConfirmDismiss">@Lang.T("admin.recruitment.confirmDismiss")</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }
    private RecruitmentDetailDto? Detail { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool ShowDismiss { get; set; }
    private int DismissReason { get; set; }
    private string DismissNotes { get; set; } = "";
    private string NewValidationLabel { get; set; } = "";
    private Guid? AddingReferenceTo { get; set; }
    private string NewRefCompany { get; set; } = "";
    private string NewRefContactName { get; set; } = "";
    private string NewRefContactPhone { get; set; } = "";
    private string NewRefContactEmail { get; set; } = "";
    private bool EditingPhone { get; set; }
    private string PhoneEditValue { get; set; } = "";
    private Guid? EditingNotesId { get; set; }
    private string NotesEditValue { get; set; } = "";
    private bool ShowEvaluationModal { get; set; }
    private Guid? EditingEvaluationId { get; set; }
    private string ModalEvalName { get; set; } = "";
    private string ModalEvalDesc { get; set; } = "";
    private decimal ModalEvalScore { get; set; }
    private string ModalEvalUrl { get; set; } = "";
    private string ModalEvalNotes { get; set; } = "";
    private bool ShowCulturalModal { get; set; }
    private Guid? EditingCulturalId { get; set; }
    private string CulturalName { get; set; } = "";
    private string CulturalDesc { get; set; } = "";
    private decimal CulturalScore { get; set; }
    private int CulturalRecommendation { get; set; }
    private string CulturalNotes { get; set; } = "";
    private string? ShowDeliveryDetail { get; set; }
    private string? MoveStageError { get; set; }
    private CandidateRecruitmentPreferencesDto? Preferences { get; set; }
    private int PrefWorkShift { get; set; }
    private int PrefContractType { get; set; }
    private int PrefAvailability { get; set; }
    private decimal PrefSalary { get; set; }
    private string? PrefDays { get; set; }
    private bool? PrefWeekends { get; set; }
    private bool? PrefHolidays { get; set; }
    private string? PrefSchedule { get; set; }
    private bool PrefSaving { get; set; }
    private List<string> SelectedDays { get; set; } = new();
    private List<DocumentTypeDto> DocumentTypes { get; set; } = new();
    private List<RecruitmentDocumentDto> Documents { get; set; } = new();
    private bool ShowAddDocForm { get; set; }
    private string? NewDocTypeId { get; set; }
    private string? NewDocNotes { get; set; }
    private bool EditingMigration { get; set; }
    private string? EditNationality { get; set; }
    private string EditHasPassportStr { get; set; } = "";
    private List<string> EditWorkAuthList { get; set; } = new();
    private string EditHasTransportStr { get; set; } = "";
    private static readonly List<(string Value, string Label)> WorkAuthOptions = new()
    {
        ("1", "Ciudadano UE / EEE"),
        ("2", "Permiso de residencia y trabajo vigente (no UE)"),
        ("3", "Autorización de estancia por estudios CON permiso de trabajo"),
        ("4", "Autorización de estancia por estudios SIN permiso de trabajo"),
        ("5", "En trámite / pendiente de resolución"),
        ("6", "Sin autorización para trabajar")
    };
    private bool ShowVacancySelector { get; set; }
    private List<VacancyOptionDto> VacancyOptions { get; set; } = new();
    private Guid? SelectedVacancyId { get; set; }
    private string VacancySearch { get; set; } = "";
    private bool ShowSmartMatches { get; set; } = true;
    private static readonly Dictionary<string, string> AvailableDayOptions = new()
    {
        { "L", "Lunes" },
        { "M", "Martes" },
        { "X", "Miércoles" },
        { "J", "Jueves" },
        { "V", "Viernes" },
        { "S", "Sábado" },
        { "D", "Domingo" }
    };

    private decimal OverallScore
    {
        get
        {
            if (Detail == null) return 0;

            var scores = new List<decimal>();

            var invTotal = Detail.InvestigationChecklist.Count;
            var invCompleted = Detail.InvestigationChecklist.Count(c => c.IsCompleted);
            if (invTotal > 0)
                scores.Add((decimal)invCompleted / invTotal * 100);

            if (Detail.TechnicalEvaluations.Count > 0)
                scores.Add(Detail.TechnicalEvaluations.Average(e => e.Score));

            if (Detail.CulturalInterviews.Count > 0)
                scores.Add(Detail.CulturalInterviews.Average(e => e.Score));

            return scores.Count > 0 ? Math.Round(scores.Average(), 1) : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        IsLoading = true;
        StateHasChanged();
        Detail = await AuthApi.GetRecruitmentByUserAsync(UserId);
        if (Detail != null)
        {
            Preferences = await AuthApi.GetRecruitmentPreferencesAsync(Detail.Id);
            Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail.Id);
            DocumentTypes = await AuthApi.GetDocumentTypesAsync();
            VacancyOptions = await AuthApi.GetVacancyOptionsAsync();
            SelectedVacancyId = Detail.VacancyId;
            if (Preferences != null)
            {
                PrefWorkShift = Preferences.PreferredWorkShift ?? 0;
                PrefContractType = Preferences.AcceptedContractType ?? 0;
                PrefAvailability = Preferences.AvailabilityToJoin ?? 0;
                PrefSalary = Preferences.ExpectedSalary ?? 0;
                PrefDays = Preferences.AvailableDays;
                SelectedDays = string.IsNullOrWhiteSpace(PrefDays)
                    ? new List<string>()
                    : PrefDays.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(d => d.Trim()).ToList();
                PrefWeekends = Preferences.AvailableWeekends;
                PrefHolidays = Preferences.AvailableHolidays;
                PrefSchedule = Preferences.AvailableSchedule;
            }
        }
        IsLoading = false;
        StateHasChanged();
    }

    private string GetRecommendationLabel(int rec)
    {
        return rec switch
        {
            1 => Lang.T("admin.recruitment.recRecommended"),
            2 => Lang.T("admin.recruitment.recNotRecommended"),
            3 => Lang.T("admin.recruitment.recUndecided"),
            _ => Lang.T("admin.recruitment.recPending")
        };
    }

    private void ToggleDeliveryDetail(string key)
    {
        ShowDeliveryDetail = ShowDeliveryDetail == key ? null : key;
    }

    private void OpenAddCulturalModal()
    {
        EditingCulturalId = null;
        CulturalName = Lang.T("admin.recruitment.culturalInterview");
        CulturalDesc = "";
        CulturalScore = 0;
        CulturalRecommendation = 0;
        CulturalNotes = "";
        ShowCulturalModal = true;
    }

    private void StartEditCultural(TechnicalEvaluationDto interview)
    {
        EditingCulturalId = interview.Id;
        CulturalName = interview.EvaluationName;
        CulturalDesc = interview.Description ?? "";
        CulturalScore = interview.Score;
        CulturalRecommendation = interview.Recommendation;
        CulturalNotes = interview.Notes ?? "";
        ShowCulturalModal = true;
    }

    private void CloseCulturalModal()
    {
        ShowCulturalModal = false;
        EditingCulturalId = null;
    }

    private async Task SaveCulturalModal()
    {
        if (Detail == null || string.IsNullOrWhiteSpace(CulturalName)) return;

        if (EditingCulturalId != null)
        {
            await AuthApi.UpdateTechnicalEvaluationAsync(EditingCulturalId.Value, new UpdateTechnicalEvaluationDto
            {
                EvaluationName = CulturalName.Trim(),
                Description = CulturalDesc?.Trim(),
                Score = CulturalScore,
                Notes = CulturalNotes?.Trim(),
                Recommendation = CulturalRecommendation
            });
        }
        else
        {
            await AuthApi.AddTechnicalEvaluationAsync(Detail.Id, new AddTechnicalEvaluationDto
            {
                EvaluationName = CulturalName.Trim(),
                Description = string.IsNullOrWhiteSpace(CulturalDesc) ? null : CulturalDesc.Trim(),
                Score = CulturalScore,
                Notes = string.IsNullOrWhiteSpace(CulturalNotes) ? null : CulturalNotes.Trim(),
                Type = 1,
                Recommendation = CulturalRecommendation
            });
        }

        ShowCulturalModal = false;
        EditingCulturalId = null;
        await LoadDetail();
    }

    private async Task MoveToNextStage()
    {
        if (Detail == null) return;
        MoveStageError = null;
        var next = Detail.CurrentStage + 1;
        var result = await AuthApi.MoveStageAsync(Detail.Id, next);
        if (result.Success) { await LoadDetail(); }
        else { MoveStageError = result.Error; }
    }

    private async Task SavePreferences()
    {
        if (Detail == null) return;
        PrefSaving = true;
        StateHasChanged();
        PrefDays = SelectedDays.Count > 0 ? string.Join(",", SelectedDays) : null;
        var dto = new UpdateRecruitmentPreferencesDto
        {
            PreferredWorkShift = PrefWorkShift > 0 ? PrefWorkShift : null,
            AcceptedContractType = PrefContractType > 0 ? PrefContractType : null,
            AvailabilityToJoin = PrefAvailability > 0 ? PrefAvailability : null,
            ExpectedSalary = PrefSalary > 0 ? PrefSalary : null,
            AvailableDays = PrefDays,
            AvailableWeekends = PrefWeekends,
            AvailableHolidays = PrefHolidays,
            AvailableSchedule = PrefSchedule
        };
        var result = await AuthApi.SaveRecruitmentPreferencesAsync(Detail.Id, dto);
        if (result != null)
        {
            Preferences = result;
            MoveStageError = null;
        }
        PrefSaving = false;
        StateHasChanged();
    }

    private void ToggleDay(string dayCode, object? checkedValue)
    {
        if (checkedValue is true)
        {
            if (!SelectedDays.Contains(dayCode))
                SelectedDays.Add(dayCode);
        }
        else
        {
            SelectedDays.Remove(dayCode);
        }
    }

    private async Task AddDocument()
    {
        if (Detail == null || string.IsNullOrEmpty(NewDocTypeId)) return;
        var docTypeId = Guid.Parse(NewDocTypeId);
        var result = await AuthApi.RequestDocumentAsync(Detail.Id, new RequestDocumentDto
        {
            DocumentTypeId = docTypeId,
            Notes = NewDocNotes
        });
        if (result != null)
        {
            Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail.Id);
        }
        ShowAddDocForm = false;
        NewDocTypeId = null;
        NewDocNotes = null;
    }

    private async Task MarkDocSubmitted(RecruitmentDocumentDto doc)
    {
        await AuthApi.UpdateDocumentStatusAsync(doc.Id, new UpdateDocumentStatusDto { Status = 1 });
        Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail!.Id);
    }

    private async Task VerifyDoc(RecruitmentDocumentDto doc)
    {
        await AuthApi.UpdateDocumentStatusAsync(doc.Id, new UpdateDocumentStatusDto { Status = 2 });
        Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail!.Id);
    }

    private async Task ToggleDocStatus(RecruitmentDocumentDto doc)
    {
        var newStatus = doc.Status == 2 ? 0 : 2;
        await AuthApi.UpdateDocumentStatusAsync(doc.Id, new UpdateDocumentStatusDto { Status = newStatus });
        Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail!.Id);
    }

    private async Task RemoveDoc(RecruitmentDocumentDto doc)
    {
        await AuthApi.DeleteDocumentAsync(doc.Id);
        Documents = await AuthApi.GetRecruitmentDocumentsAsync(Detail!.Id);
    }

    private void EditMigrationInfo()
    {
        if (Detail == null) return;
        EditNationality = Detail.Nationality;
        EditHasPassportStr = Detail.HasPassport?.ToString().ToLowerInvariant() ?? "";
        EditWorkAuthList = string.IsNullOrEmpty(Detail.WorkAuthorizations)
            ? new List<string>()
            : Detail.WorkAuthorizations.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
        EditHasTransportStr = Detail.HasTransport?.ToString().ToLowerInvariant() ?? "";
        EditingMigration = true;
    }

    private async Task SaveMigrationInfo()
    {
        if (Detail == null) return;
        var workAuths = string.Join(",", EditWorkAuthList);
        var dto = new UpdateMigrationInfoDto
        {
            Nationality = EditNationality,
            HasPassport = bool.TryParse(EditHasPassportStr, out var hp) ? hp : null,
            WorkAuthorizations = workAuths,
            HasTransport = bool.TryParse(EditHasTransportStr, out var ht) ? ht : null
        };
        var ok = await AuthApi.UpdateMigrationInfoAsync(Detail.Id, dto);

        if (ok)
        {
            var hasNoAuth = EditWorkAuthList.Contains("6");
            if (hasNoAuth && Detail.CurrentStage != 5)
            {
                await AuthApi.DismissCandidateAsync(Detail.Id, 4, "Sin autorización para trabajar");
            }
            else if (!hasNoAuth && Detail.CurrentStage == 5)
            {
                await AuthApi.RestoreCandidateAsync(Detail.Id);
            }
        }

        if (ok) { EditingMigration = false; await LoadDetail(); }
    }

    private void ToggleWorkAuth(ChangeEventArgs e, string value)
    {
