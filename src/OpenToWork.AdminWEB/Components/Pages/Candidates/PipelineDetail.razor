    private List<VacancyOptionDto> GetSmartMatchVacancies()
    {
        if (Detail == null || string.IsNullOrWhiteSpace(Detail.Title) || VacancyOptions.Count == 0)
            return new();

        var separators = new[] { '|', ',', ';', '-', '/' };
        var keywords = Detail.Title
            .Split(separators, StringSplitOptions.RemoveEmptyEntries)
            .Select(k => k.Trim().ToLowerInvariant())
            .Where(k => k.Length > 2)
            .Distinct()
            .ToList();

        if (keywords.Count == 0) return new();

        return VacancyOptions
            .Select(v =>
            {
                var haystack = new[] { v.Title, v.Description, v.Requirements, v.Category }
                    .Where(s => !string.IsNullOrEmpty(s))
                    .Select(s => s!.ToLowerInvariant())
                    .ToList();
                var score = keywords.Count(kw => haystack.Any(h => h.Contains(kw)));
                return new { Vacancy = v, Score = score };
            })
            .Where(x => x.Score > 0)
            .OrderByDescending(x => x.Score)
            .Select(x => x.Vacancy)
            .ToList();
    }

