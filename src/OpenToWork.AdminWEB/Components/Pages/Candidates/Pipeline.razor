@page "/candidates/pipeline"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.recruitment.title")</PageTitle>

<div class="admin-page-header">
    <div>
        <h1>@Lang.T("admin.recruitment.title")</h1>
        <p class="admin-page-header-subtitle">@Lang.T("admin.recruitment.subtitle")</p>
    </div>
</div>

@if (IsLoading)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else
{
    <div class="admin-stat-grid" style="margin-bottom: var(--space-md);">
        <div class="admin-stat-card admin-stat-card--info">
            <span class="admin-stat-label">@Lang.T("admin.recruitment.statActiveCandidates")</span>
            <span class="admin-stat-value">@ActiveCandidatesCount</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-label">@Lang.T("admin.recruitment.statInInvestigation")</span>
            <span class="admin-stat-value">@InInvestigationCount</span>
        </div>
        <div class="admin-stat-card admin-stat-card--success">
            <span class="admin-stat-label">@Lang.T("admin.recruitment.statReadyToDeliver")</span>
            <span class="admin-stat-value">@ReadyToDeliverCount</span>
        </div>
        <div class="admin-stat-card admin-stat-card--success">
            <span class="admin-stat-label">@Lang.T("admin.recruitment.statPlaced")</span>
            <span class="admin-stat-value">@PlacedCount</span>
        </div>
        <div class="admin-stat-card admin-stat-card--danger">
            <span class="admin-stat-label">@Lang.T("admin.recruitment.statDismissed")</span>
            <span class="admin-stat-value">@DismissedCount</span>
        </div>
    </div>

    <div class="admin-pipeline-filters">
        <input type="text" @bind="SearchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" placeholder='@Lang.T("admin.recruitment.searchPlaceholder")' class="admin-pipeline-search" />

        <select class="ot-input-field" @bind="SelectedAssignedToRaw" @bind:after="OnResponsibleChanged" title="@Lang.T("admin.companies.filterResponsible")">
            <option value="">@Lang.T("admin.companies.filterResponsible")</option>
            @foreach (var u in AssignableUsers)
            {
                <option value="@u.Id">@u.Email</option>
            }
        </select>

        <select class="ot-input-field" @bind="SelectedDateRange" title="@Lang.T("admin.companies.filterDateRange")">
            <option value="all">@Lang.T("admin.companies.filterDateAll")</option>
            <option value="7">@Lang.T("admin.companies.filterDateLast7")</option>
            <option value="30">@Lang.T("admin.companies.filterDateLast30")</option>
            <option value="90">@Lang.T("admin.companies.filterDateLast90")</option>
        </select>

        <div class="admin-view-toggle">
            <button class="admin-view-toggle-btn @(!IsListView ? "admin-view-toggle-btn--active" : "")" title="@Lang.T("admin.companies.viewBoard")" @onclick='() => IsListView = false'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="3" x2="9" y2="21" /><line x1="15" y1="3" x2="15" y2="21" /></svg>
            </button>
            <button class="admin-view-toggle-btn @(IsListView ? "admin-view-toggle-btn--active" : "")" title="@Lang.T("admin.companies.viewList")" @onclick='() => IsListView = true'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" /></svg>
            </button>
        </div>
    </div>

    @if (PipelineData == null || PipelineData.Items.Count == 0)
    {
        <div class="admin-empty">
            <div class="admin-empty-text">@Lang.T("admin.recruitment.empty")</div>
        </div>
    }
    else if (IsListView)
    {
        <table class="ot-table">
            <thead>
                <tr>
                    <th>@Lang.T("admin.candidates.columnName")</th>
                    <th>@Lang.T("admin.candidates.columnEmail")</th>
                    <th>@Lang.T("admin.candidates.columnTitle")</th>
                    <th>@Lang.T("admin.companies.city")</th>
                    <th>@Lang.T("admin.companies.columnStage")</th>
                    <th>@Lang.T("admin.companies.assignedTo")</th>
                    <th>@Lang.T("admin.companies.columnDate")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredItems.OrderByDescending(i => i.StageEnteredAt ?? i.CreatedAt))
                {
                    <tr class="admin-clickable" @onclick="() => ViewDetail(item.UserId)">
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@(item.Title ?? "-")</td>
                        <td>@(item.City ?? "-")</td>
                        <td>@Stages.GetValueOrDefault(EffectiveStage(item), "-") <PlacementBadge Placement="item.Placement" /></td>
                        <td>@(item.AssignedToName ?? "-")</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="admin-pipeline-kanban-wrapper">
        <div class="admin-pipeline-kanban">
            @foreach (var stage in Stages)
            {
                var stageItems = FilteredItems.Where(i => EffectiveStage(i) == stage.Key).ToList();
                <div class="admin-kanban-column @StageAccentClass(stage.Key)">
                    <div class="admin-kanban-column-header">
                        <span class="admin-kanban-column-title">@stage.Value</span>
                        <span class="admin-kanban-column-count">@stageItems.Count</span>
                    </div>
                    <div class="admin-kanban-column-body">
                        @if (stageItems.Count == 0)
                        {
                            <div class="admin-kanban-empty">@Lang.T("admin.recruitment.noCandidates")</div>
                        }
                        @foreach (var item in stageItems)
                        {
                            <div class="admin-kanban-card @(item.Dismissal != null ? "admin-kanban-card--dismissed" : "")" @onclick="() => ViewDetail(item.UserId)">
                                <div class="admin-kanban-card-header">
                                    <div class="admin-result-avatar">@(GetInitials(item.FullName))</div>
                                    <div class="admin-kanban-card-info">
                                        <div class="admin-kanban-card-name">@item.FullName</div>
                                        <div class="admin-kanban-card-email">@item.Email</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Title))
                                {
                                    <div class="admin-kanban-card-title">@item.Title</div>
                                }
                                @if (!string.IsNullOrEmpty(item.City))
                                {
                                    <div class="admin-kanban-card-meta">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                                        <span>@item.City</span>
                                    </div>
                                }
                                @if (stage.Key == 1 && item.InvestigationTotal > 0)
                                {
                                    var pct = (int)Math.Round((double)item.InvestigationCompleted / item.InvestigationTotal * 100);
                                    <div class="admin-kanban-progress">
                                        <div class="admin-kanban-progress-bar">
                                            <div class="admin-kanban-progress-fill" style="width: @pct%"></div>
                                        </div>
                                        <span class="admin-kanban-progress-text">@item.InvestigationCompleted/@item.InvestigationTotal</span>
                                    </div>
                                }
                                @if (item.Placement != null)
                                {
                                    <div style="margin-top: 0.35rem;"><PlacementBadge Placement="item.Placement" /></div>
                                }
                                @if (item.Dismissal != null)
                                {
                                    <div class="admin-kanban-card-dismissed">
                                        @Lang.T("admin.recruitment.dismissed"): @GetDismissalReason(item.Dismissal.Reason)
                                    </div>
                                }
                                <div class="admin-kanban-card-footer">
                                    <span class="admin-kanban-card-date">@((item.StageEnteredAt ?? item.CreatedAt).ToLocalTime().ToString("dd MMM"))</span>
                                    @if (!string.IsNullOrEmpty(item.AssignedToName))
                                    {
                                        <span class="admin-kanban-card-assignee">@item.AssignedToName</span>
                                    }
                                    else
                                    {
                                        <span class="admin-kanban-unassigned">@Lang.T("admin.recruitment.unassigned")</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        </div>
    }
}

@code {
    private RecruitmentPipelineResultDto? PipelineData;
    private List<AdminUserDto> AssignableUsers = new();
    private bool IsLoading = true;
    private bool IsListView = false;
    private string SearchTerm = "";
    private string SelectedAssignedToRaw = "";
    private Guid? SelectedAssignedTo;
    private string SelectedDateRange = "all";
    private System.Threading.Timer? _debounceTimer;

    private Dictionary<int, string> Stages => new()
    {
        { 0, Lang.T("admin.recruitment.stage0") },
        { 1, Lang.T("admin.recruitment.stage1") },
        { 2, Lang.T("admin.recruitment.stage2") },
        { 3, Lang.T("admin.recruitment.stage3") },
        { 4, Lang.T("admin.recruitment.stage4") },
        { PlacedColumn, Lang.T("admin.recruitment.stagePlaced") },
        { 5, Lang.T("admin.recruitment.stage5") }
    };

    private List<RecruitmentPipelineDto> FilteredItems
    {
        get
        {
            var items = (PipelineData?.Items ?? new()).AsEnumerable();

            if (SelectedDateRange != "all" && int.TryParse(SelectedDateRange, out var days))
            {
                var cutoff = DateTime.UtcNow.AddDays(-days);
                items = items.Where(i => i.CreatedAt >= cutoff);
            }

            return items.ToList();
        }
    }

    private int ActiveCandidatesCount => (PipelineData?.Items ?? new()).Count(i => i.CurrentStage != 5);
    private int InInvestigationCount => PipelineData?.CountByStage.GetValueOrDefault(1, 0) ?? 0;
    private int ReadyToDeliverCount => (PipelineData?.CountByStage.GetValueOrDefault(4, 0) ?? 0) - PlacedCount;
    private int PlacedCount => PipelineData?.PlacedCount ?? 0;

    // Columna virtual (no es una etapa en la base): un candidato Verificado que ya esta Colocado
    // (ver CandidatePlacementHelper) sale de "Listo para entregar" y se muestra aparte.
    private const int PlacedColumn = 6;
    private static int EffectiveStage(RecruitmentPipelineDto i) =>
        i.CurrentStage == 4 && i.Placement?.IsPlaced == true ? PlacedColumn : i.CurrentStage;
    private int DismissedCount => PipelineData?.CountByStage.GetValueOrDefault(5, 0) ?? 0;

    // Progresion neutro -> frio -> marca -> calido -> ganado (mismo criterio que el pipeline de
    // empresas) para leer el avance de un vistazo; Descartado en rojo por ser una salida negativa.
    private static string StageAccentClass(int stageKey) => stageKey switch
    {
        0 => "admin-kanban-column--neutral",
        1 => "admin-kanban-column--info",
        2 => "admin-kanban-column--primary",
        3 => "admin-kanban-column--accent",
        4 => "admin-kanban-column--success",
        PlacedColumn => "admin-kanban-column--success",
        5 => "admin-kanban-column--danger",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        AssignableUsers = await AuthApi.GetUsersAsync(1, 100, (int)UserRole.Admin);

        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        StateHasChanged();
        PipelineData = await AuthApi.GetRecruitmentPipelineAsync(
            page: 1, pageSize: 100,
            assignedTo: SelectedAssignedTo,
            search: string.IsNullOrWhiteSpace(SearchTerm) ? null : SearchTerm);
        IsLoading = false;
        StateHasChanged();
    }

    private async Task OnResponsibleChanged()
    {
        SelectedAssignedTo = Guid.TryParse(SelectedAssignedToRaw, out var id) ? id : null;
        await LoadData();
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        }, null, 400, System.Threading.Timeout.Infinite);
    }

    private void ViewDetail(Guid id) => Nav.NavigateTo($"/candidates/pipeline/{id}");

    private string GetDismissalReason(int reason) => reason switch
    {
        0 => Lang.T("admin.recruitment.reasonTechnical"),
        1 => Lang.T("admin.recruitment.reasonReferences"),
        2 => Lang.T("admin.recruitment.reasonSalary"),
        3 => Lang.T("admin.recruitment.reasonNoShow"),
        _ => Lang.T("admin.recruitment.reasonOther")
    };

    private static string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..1].ToUpper();
        return (parts[0][..1] + parts[^1][..1]).ToUpper();
    }
}
