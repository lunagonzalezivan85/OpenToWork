@inherits LayoutComponentBase
@using OpenToWork.AdminWEB.Services
@inject LanguageService Lang
@inject AdminAuthApiService AuthApi
@inject AdminAuthStateProvider AuthProvider
@inject LocalStorageService LocalStorage
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav

<div class="admin-shell">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-sidebar-brand">
            <span class="admin-brand-squircle">OTW</span>
            <span class="admin-brand-text">@Lang.T("admin.brand")</span>
        </div>
        <nav class="admin-sidebar-nav">
            <a href="/" class="admin-nav-item">
                <span class="admin-nav-icon-squircle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" />
                        <rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" />
                    </svg>
                </span>
                <span class="admin-nav-label">@Lang.T("admin.nav.dashboard")</span>
            </a>
            <div class="admin-nav-group">
                <div class="admin-nav-group-title">@Lang.T("admin.nav.recruitment")</div>
                <a href="/candidates" class="admin-nav-item admin-nav-item--sub">
                    <span class="admin-nav-icon-squircle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </span>
                    <span class="admin-nav-label">@Lang.T("admin.nav.candidates")</span>
                </a>
                <a href="/candidates/assigned" class="admin-nav-item admin-nav-item--sub">
                    <span class="admin-nav-icon-squircle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
                            <line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" />
                        </svg>
                    </span>
                    <span class="admin-nav-label">@Lang.T("admin.nav.assigned")</span>
                </a>
                <a href="/candidates/pipeline" class="admin-nav-item admin-nav-item--sub">
                    <span class="admin-nav-icon-squircle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <rect x="3" y="3" width="6" height="18" rx="1" /><rect x="9" y="3" width="6" height="12" rx="1" /><rect x="15" y="3" width="6" height="6" rx="1" />
                        </svg>
                    </span>
                    <span class="admin-nav-label">@Lang.T("admin.nav.pipeline")</span>
                </a>
            </div>
        </nav>
        <div class="admin-sidebar-footer">
            <button class="admin-logout-btn" @onclick="HandleLogout">
                <span class="admin-nav-icon-squircle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                </span>
                <span class="admin-nav-label">@Lang.T("admin.nav.logout")</span>
            </button>
        </div>
    </aside>

    <!-- Main area -->
    <div class="admin-main">
        <header class="admin-topbar">
            <button class="admin-sidebar-toggle" @onclick="ToggleSidebar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <div class="admin-topbar-title">
                <span class="admin-topbar-badge">Admin</span>
            </div>
            <div class="admin-topbar-actions">
                <select @onchange="OnThemeChanged" class="admin-select">
                    <option value="navy">Navy</option>
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                </select>
                <select @onchange="OnLanguageChanged" class="admin-select">
                    <option value="es">ES</option>
                    <option value="en">EN</option>
                </select>
            </div>
        </header>

        <main class="admin-content">
            <div class="admin-content-inner">
                @Body
            </div>
        </main>
    </div>
</div>

<div class="admin-sidebar-overlay" id="adminSidebarOverlay" @onclick="CloseSidebar"></div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Centralized auth guard: every page rendered through AdminLayout requires a session
        // token. This replaces the per-page "otwadmin-token" checks that used to be duplicated
        // across pages (and were missing entirely from the Recruitment Pipeline pages).
        var token = await LocalStorage.GetItemAsync("otwadmin-token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (e.Value is string theme)
        {
            await JS.InvokeVoidAsync("themeSwitcher.set", theme);
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string lang)
        {
            await Lang.SetLanguageAsync(lang);
        }
    }

    private async Task HandleLogout()
    {
        await AuthApi.LogoutAsync();
        AuthProvider.NotifyAuthenticationStateChanged();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task ToggleSidebar()
    {
        await JS.InvokeVoidAsync("adminLayout.toggleSidebar");
    }

    private async Task CloseSidebar()
    {
        await JS.InvokeVoidAsync("adminLayout.closeSidebar");
    }
}
