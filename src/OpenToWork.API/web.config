<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config del API del portal (IIS, sitio TD-API). dotnet publish completa este archivo con el
  handler de ASP.NET Core; aqui solo va lo que no genera el SDK.
  - requestLimits: IIS corta por defecto las peticiones de mas de ~30 MB antes de llegar a la app.
    El video de presentacion admite hasta 95 MB (PresentationVideoStorage.MaxBytes); Cloudflare
    corta a 100 MB, asi que este limite no deja pasar nada que Cloudflare no deje pasar ya.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="100000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
